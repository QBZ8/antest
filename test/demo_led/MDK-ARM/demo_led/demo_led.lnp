--cpu Cortex-M3
"demo_led\startup_stm32f103xb.o"
"demo_led\main.o"
"demo_led\gpio.o"
"demo_led\stm32f1xx_it.o"
"demo_led\stm32f1xx_hal_msp.o"
"demo_led\stm32f1xx_hal_gpio_ex.o"
"demo_led\stm32f1xx_hal.o"
"demo_led\stm32f1xx_hal_rcc.o"
"demo_led\stm32f1xx_hal_rcc_ex.o"
"demo_led\stm32f1xx_hal_gpio.o"
"demo_led\stm32f1xx_hal_dma.o"
"demo_led\stm32f1xx_hal_cortex.o"
"demo_led\stm32f1xx_hal_pwr.o"
"demo_led\stm32f1xx_hal_flash.o"
"demo_led\stm32f1xx_hal_flash_ex.o"
"demo_led\stm32f1xx_hal_exti.o"
"demo_led\system_stm32f1xx.o"
--strict --scatter "demo_led\demo_led.sct"
--summary_stderr --info summarysizes --map --load_addr_map_info --xref --callgraph --symbols
--info sizes --info totals --info unused --info veneers
--list "demo_led.map" -o demo_led\demo_led.axf