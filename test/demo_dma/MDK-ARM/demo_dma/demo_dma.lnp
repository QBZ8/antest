--cpu Cortex-M3
"demo_dma\startup_stm32f103xb.o"
"demo_dma\main.o"
"demo_dma\gpio.o"
"demo_dma\dma.o"
"demo_dma\usart.o"
"demo_dma\stm32f1xx_it.o"
"demo_dma\stm32f1xx_hal_msp.o"
"demo_dma\stm32f1xx_hal_gpio_ex.o"
"demo_dma\stm32f1xx_hal_uart.o"
"demo_dma\stm32f1xx_hal.o"
"demo_dma\stm32f1xx_hal_rcc.o"
"demo_dma\stm32f1xx_hal_rcc_ex.o"
"demo_dma\stm32f1xx_hal_gpio.o"
"demo_dma\stm32f1xx_hal_dma.o"
"demo_dma\stm32f1xx_hal_cortex.o"
"demo_dma\stm32f1xx_hal_pwr.o"
"demo_dma\stm32f1xx_hal_flash.o"
"demo_dma\stm32f1xx_hal_flash_ex.o"
"demo_dma\stm32f1xx_hal_exti.o"
"demo_dma\system_stm32f1xx.o"
--strict --scatter "demo_dma\demo_dma.sct"
--summary_stderr --info summarysizes --map --load_addr_map_info --xref --callgraph --symbols
--info sizes --info totals --info unused --info veneers
--list "demo_dma.map" -o demo_dma\demo_dma.axf