--cpu Cortex-M3
"demo_key\startup_stm32f103xb.o"
"demo_key\main.o"
"demo_key\gpio.o"
"demo_key\stm32f1xx_it.o"
"demo_key\stm32f1xx_hal_msp.o"
"demo_key\stm32f1xx_hal_gpio_ex.o"
"demo_key\stm32f1xx_hal.o"
"demo_key\stm32f1xx_hal_rcc.o"
"demo_key\stm32f1xx_hal_rcc_ex.o"
"demo_key\stm32f1xx_hal_gpio.o"
"demo_key\stm32f1xx_hal_dma.o"
"demo_key\stm32f1xx_hal_cortex.o"
"demo_key\stm32f1xx_hal_pwr.o"
"demo_key\stm32f1xx_hal_flash.o"
"demo_key\stm32f1xx_hal_flash_ex.o"
"demo_key\stm32f1xx_hal_exti.o"
"demo_key\system_stm32f1xx.o"
--strict --scatter "demo_key\demo_key.sct"
--summary_stderr --info summarysizes --map --load_addr_map_info --xref --callgraph --symbols
--info sizes --info totals --info unused --info veneers
--list "demo_key.map" -o demo_key\demo_key.axf