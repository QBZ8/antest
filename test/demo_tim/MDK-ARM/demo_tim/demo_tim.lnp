--cpu Cortex-M3
"demo_tim\startup_stm32f103xb.o"
"demo_tim\main.o"
"demo_tim\gpio.o"
"demo_tim\tim.o"
"demo_tim\usart.o"
"demo_tim\stm32f1xx_it.o"
"demo_tim\stm32f1xx_hal_msp.o"
"demo_tim\stm32f1xx_hal_gpio_ex.o"
"demo_tim\stm32f1xx_hal_tim.o"
"demo_tim\stm32f1xx_hal_tim_ex.o"
"demo_tim\stm32f1xx_hal.o"
"demo_tim\stm32f1xx_hal_rcc.o"
"demo_tim\stm32f1xx_hal_rcc_ex.o"
"demo_tim\stm32f1xx_hal_gpio.o"
"demo_tim\stm32f1xx_hal_dma.o"
"demo_tim\stm32f1xx_hal_cortex.o"
"demo_tim\stm32f1xx_hal_pwr.o"
"demo_tim\stm32f1xx_hal_flash.o"
"demo_tim\stm32f1xx_hal_flash_ex.o"
"demo_tim\stm32f1xx_hal_exti.o"
"demo_tim\stm32f1xx_hal_uart.o"
"demo_tim\system_stm32f1xx.o"
--strict --scatter "demo_tim\demo_tim.sct"
--summary_stderr --info summarysizes --map --load_addr_map_info --xref --callgraph --symbols
--info sizes --info totals --info unused --info veneers
--list "demo_tim.map" -o demo_tim\demo_tim.axf