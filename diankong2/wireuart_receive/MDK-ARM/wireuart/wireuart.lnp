"wireuart\stm32f1xx_hal_i2c.o"
"wireuart\stm32f1xx_hal.o"
"wireuart\stm32f1xx_hal_rcc.o"
"wireuart\stm32f1xx_hal_rcc_ex.o"
"wireuart\stm32f1xx_hal_gpio.o"
"wireuart\stm32f1xx_hal_dma.o"
"wireuart\stm32f1xx_hal_cortex.o"
