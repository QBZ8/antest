(0234) /*函数：void SetRX_Mode(void)
(0235) /*功能：数据接收配置 
(0236) /****************************************************************************************************/
(0237) void SetRX_Mode(void)
(0238) {
(0239) 	Low_24L01_CE;
_SetRX_Mode:
    00DE 98C5      CBI	0x18,5
(0240) 	SPI_RW_Reg(WRITE_REG + CONFIG, 0x0f);   		// IRQ收发完成中断响应，16位CRC	，主接收
    00DF E02F      LDI	R18,0xF
    00E0 E200      LDI	R16,0x20
    00E1 DFB7      RCALL	_SPI_RW_Reg
(0241) 	Hign_24L01_CE; 
    00E2 9AC5      SBI	0x18,5
(0242) 	Delay(1000);
    00E3 EE08      LDI	R16,0xE8
    00E4 E013      LDI	R17,3
    00E5 DF79      RCALL	_Delay
    00E6 9508      RET
_nRF24L01_RxPacket:
  revale               --> R20
  rx_buf               --> R22
    00E7 940E0216  CALL	push_gset2
    00E9 01B8      MOVW	R22,R16
    00EA 9721      SBIW	R28,1
(0243) }
