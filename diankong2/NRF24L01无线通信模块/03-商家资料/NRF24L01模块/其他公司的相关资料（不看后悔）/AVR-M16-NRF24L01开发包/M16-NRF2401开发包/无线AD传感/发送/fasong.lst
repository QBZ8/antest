    0220 9169      LD	R22,Y+
    0221 9179      LD	R23,Y+
    0222 FDE1      SBRC	R30,1
    0223 9508      RET
    0224 90A9      LD	R10,Y+
    0225 90B9      LD	R11,Y+
    0226 FDE2      SBRC	R30,2
    0227 9508      RET
