(0147) /*函数：uint SPI_RW(uint uchar)
(0148) /*功能：NRF24L01的SPI写时序
(0149) /****************************************************************************************************/
(0150) char SPI_RW(char data)
(0151) {
(0152) 	char i,temp=0;
    0076 2744      CLR	R20
(0153)    	for(i=0;i<8;i++) // output 8-bit
    0077 2766      CLR	R22
    0078 C00D      RJMP	0x0086
(0154)    	{
(0155) 	if(data & 0x80)
    0079 FF07      SBRS	R16,7
    007A C002      RJMP	0x007D
(0156) 	{
(0157) 		Hign_24L01_MOSI ;         // output 'uchar', MSB to MOSI
    007B 9AC2      SBI	0x18,2
(0158) 	}
    007C C001      RJMP	0x007E
(0159) 	else
(0160) 	{
(0161) 	 	Low_24L01_MOSI; 
    007D 98C2      CBI	0x18,2
(0162) 	}	
(0163) 		data = (data << 1);           // shift next bit into MSB..
    007E 0F00      LSL	R16
(0164) 		temp<<=1;
    007F 0F44      LSL	R20
(0165) 		Hign_24L01_SCK ;                      // Set SCK high..
    0080 9AC6      SBI	0x18,6
(0166) 		if(Read_24L01_MISO )temp++;       		  // capture current MISO bit
    0081 9BB4      SBIS	0x16,4
    0082 C001      RJMP	0x0084
    0083 9543      INC	R20
(0167) 		Low_24L01_SCK;            		  // ..then set SCK low again
    0084 98C6      CBI	0x18,6
    0085 9563      INC	R22
    0086 3068      CPI	R22,0x8
    0087 F388      BCS	0x0079
(0168)    	}
(0169)     return(temp);           		  // return read uchar
    0088 2F04      MOV	R16,R20
    0089 940E020A  CALL	pop_gset2
    008B 9508      RET
_SPI_Read:
  reg_val              --> R20
  reg                  --> R20
    008C 940E0218  CALL	push_gset1
    008E 2F40      MOV	R20,R16
(0170) }
