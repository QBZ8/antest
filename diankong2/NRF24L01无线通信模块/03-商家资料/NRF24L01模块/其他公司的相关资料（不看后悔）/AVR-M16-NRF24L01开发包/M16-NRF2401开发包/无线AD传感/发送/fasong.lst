(0245) /*函数：unsigned char nRF24L01_RxPacket(unsigned char* rx_buf)
(0246) /*功能：数据读取后放如rx_buf接收缓冲区中
(0247) /******************************************************************************************************/
(0248) char nRF24L01_RxPacket(char* rx_buf)
(0249) {
(0250)     char revale=0;
    00EB 2744      CLR	R20
(0251) 	sta=SPI_Read(STATUS);	// 读取状态寄存其来判断数据接收状况
    00EC E007      LDI	R16,7
    00ED DF9E      RCALL	_SPI_Read
    00EE 93000088  STS	sta,R16
(0252) 	if(sta&0x40)				// 判断是否接收到数据
    00F0 FF06      SBRS	R16,6
    00F1 C007      RJMP	0x00F9
(0253) 	{
(0254) 	    Low_24L01_CE; 			//SPI使能
    00F2 98C5      CBI	0x18,5
(0255) 		SPI_Read_Buf(RD_RX_PLOAD,rx_buf,TX_PLOAD_WIDTH);// read receive payload from RX_FIFO buffer
    00F3 E280      LDI	R24,0x20
    00F4 8388      STD	Y+0,R24
    00F5 019B      MOVW	R18,R22
    00F6 E601      LDI	R16,0x61
    00F7 DFB0      RCALL	_SPI_Read_Buf
(0256) 		revale =1;			//读取数据完成标志
    00F8 E041      LDI	R20,1
(0257) 	}
(0258) 	SPI_RW_Reg(WRITE_REG+STATUS,sta);   //接收到数据后RX_DR,TX_DS,MAX_PT都置高为1，通过写1来清楚中断标志
    00F9 91200088  LDS	R18,sta
    00FB E207      LDI	R16,0x27
    00FC DF9C      RCALL	_SPI_RW_Reg
(0259) 	return revale;
    00FD 2F04      MOV	R16,R20
    00FE 9621      ADIW	R28,1
    00FF 940E020A  CALL	pop_gset2
    0101 9508      RET
_nRF24L01_TxPacket:
  tx_buf               --> R20
    0102 940E0218  CALL	push_gset1
    0104 01A8      MOVW	R20,R16
    0105 9721      SBIW	R28,1
(0260) }
(0261) /***********************************************************************************************************
(0262) /*函数：void nRF24L01_TxPacket(char * tx_buf)
(0263) /*功能：发送 tx_buf中数据
(0264) /**********************************************************************************************************/
(0265) void nRF24L01_TxPacket(char * tx_buf)
(0266) {
(0267) 	Low_24L01_CE;			//StandBy I模式	
    0106 98C5      CBI	0x18,5
(0268) 	SPI_Write_Buf(WRITE_REG + RX_ADDR_P0, TX_ADDRESS, TX_ADR_WIDTH); // 装载接收端地址
    0107 E085      LDI	R24,5
    0108 8388      STD	Y+0,R24
    0109 E72E      LDI	R18,0x7E
    010A E030      LDI	R19,0
    010B E20A      LDI	R16,0x2A
    010C DFBA      RCALL	_SPI_Write_Buf
(0269) 	SPI_Write_Buf(WR_TX_PLOAD, tx_buf, TX_PLOAD_WIDTH); 			 // 装载数据	
    010D E280      LDI	R24,0x20
    010E 8388      STD	Y+0,R24
    010F 019A      MOVW	R18,R20
    0110 EA00      LDI	R16,0xA0
    0111 DFB5      RCALL	_SPI_Write_Buf
(0270) //	SPI_RW_Reg(WRITE_REG + CONFIG, 0x0e);   		 // IRQ收发完成中断响应，16位CRC，主发送
(0271) 	Hign_24L01_CE;		 //置高CE，激发数据发送
    0112 9AC5      SBI	0x18,5
(0272) 	Delay(1000);
    0113 EE08      LDI	R16,0xE8
    0114 E013      LDI	R17,3
    0115 DF49      RCALL	_Delay
    0116 9621      ADIW	R28,1
    0117 940E021B  CALL	pop_gset1
    0119 9508      RET
_init_NRF24L01:
    011A 9721      SBIW	R28,1
(0273) }
(0274) //****************************************************************************************
(0275) /*NRF24L01初始化
(0276) //***************************************************************************************/
(0277) void init_NRF24L01(void)
(0278) {
(0279) 
(0280)  	Low_24L01_CE;    // chip enable
    011B 98C5      CBI	0x18,5
(0281)  	Hign_24L01_CSN;   // Spi disable 
    011C 9AC7      SBI	0x18,7
(0282)  	Low_24L01_SCK;   // Spi clock line init high
    011D 98C6      CBI	0x18,6
(0283) 	SPI_Write_Buf(WRITE_REG + TX_ADDR, TX_ADDRESS, TX_ADR_WIDTH);    // 写本地地址	
    011E E085      LDI	R24,5
    011F 8388      STD	Y+0,R24
    0120 E72E      LDI	R18,0x7E
    0121 E030      LDI	R19,0
    0122 E300      LDI	R16,0x30
    0123 DFA3      RCALL	_SPI_Write_Buf
(0284) 	SPI_Write_Buf(WRITE_REG + RX_ADDR_P0, RX_ADDRESS, RX_ADR_WIDTH); // 写接收端地址
    0124 E085      LDI	R24,5
    0125 8388      STD	Y+0,R24
    0126 E823      LDI	R18,0x83
    0127 E030      LDI	R19,0
    0128 E20A      LDI	R16,0x2A
    0129 DF9D      RCALL	_SPI_Write_Buf
(0285) 	SPI_RW_Reg(WRITE_REG + EN_AA, 0x01);      //  频道0自动	ACK应答允许	
    012A E021      LDI	R18,1
    012B E201      LDI	R16,0x21
    012C DF6C      RCALL	_SPI_RW_Reg
(0286) 	SPI_RW_Reg(WRITE_REG + EN_RXADDR, 0x01);  //  允许接收地址只有频道0，如果需要多频道可以参考Page21  
    012D E021      LDI	R18,1
    012E E202      LDI	R16,0x22
    012F DF69      RCALL	_SPI_RW_Reg
(0287) 	SPI_RW_Reg(WRITE_REG + RF_CH, 0);        //   设置信道工作为2.4GHZ，收发必须一致
    0130 2722      CLR	R18
    0131 E205      LDI	R16,0x25
    0132 DF66      RCALL	_SPI_RW_Reg
(0288) 	SPI_RW_Reg(WRITE_REG + RX_PW_P0, RX_PLOAD_WIDTH); //设置接收数据长度，本次设置为32字节
    0133 E220      LDI	R18,0x20
    0134 E301      LDI	R16,0x31
    0135 DF63      RCALL	_SPI_RW_Reg
(0289) 	SPI_RW_Reg(WRITE_REG + RF_SETUP, 0x07);   		//设置发射速率为1MHZ，发射功率为最大值0dB	
    0136 E027      LDI	R18,7
    0137 E206      LDI	R16,0x26
    0138 DF60      RCALL	_SPI_RW_Reg
(0290) 	SPI_RW_Reg(WRITE_REG + CONFIG, 0x0e);   		 // IRQ收发完成中断响应，16位CRC，主发送
    0139 E02E      LDI	R18,0xE
    013A E200      LDI	R16,0x20
    013B DF5D      RCALL	_SPI_RW_Reg
(0291) 	Delay(6000);
    013C E700      LDI	R16,0x70
    013D E117      LDI	R17,0x17
    013E DF20      RCALL	_Delay
    013F 9621      ADIW	R28,1
    0140 9508      RET
(0292) }
(0293) //******************************************************************************
(0294) //**********************************AD数据采集*****************************
(0295) //******************************************************************************
(0296) //-----------------------------AD转换函数----------------------------------------
(0297) unsigned char GetADResult(void)
(0298) {
(0299) 	unsigned char i;
(0300) /**********************ADC 多工选择寄存器－ ADMUX配置方法********************/
(0301) /*      Bit   7     6     5     4    3    2    1    0     (Page203)        */
(0302) /*          REFS1 REFS0 ADLAR MUX4 MUX3 MUX2 MUX1 MUX0                    */
(0303) /*            1     1     1     0    0    1    1    1                    */
(0304) /************************************************************************/
(0305) 	ADMUX |= (1 << REFS1);  //2.56V 的片内基准电压源， AREF 引脚外加滤波电容
_GetADResult:
  i                    --> R16
    0141 9A3F      SBI	0x07,7
(0306) 	ADMUX |= (1 << REFS0);  //2.56V 的片内基准电压源， AREF 引脚外加滤波电容
    0142 9A3E      SBI	0x07,6
(0307) 	ADMUX |= (1 << ADLAR);  //ADC 转换结果 左对齐
    0143 9A3D      SBI	0x07,5
(0308) 	ADMUX &= ~(1 << MUX4);  //ADC0单端输入
    0144 983C      CBI	0x07,4
(0309) 	ADMUX &= ~(1 << MUX3);  //ADC0单端输入
    0145 983B      CBI	0x07,3
(0310) 	ADMUX &= ~(1 << MUX2);  //ADC0单端输入
    0146 983A      CBI	0x07,2
(0311) 	ADMUX &= ~(1 << MUX1);  //ADC0单端输入
    0147 9839      CBI	0x07,1
(0312) 	ADMUX &= ~(1 << MUX0);  //ADC0单端输入
    0148 9838      CBI	0x07,0
(0313) 
(0314) /********************ADC 控制和状态寄存器A -ADCSRA配置方法*************************/
(0315) /*      Bit   7     6     5     4    3    2    1    0     (Page205)               */
(0316) /*          ADEN ADSC ADATE ADIF ADIE ADPS2 ADPS1 ADPS0                           */
(0317) /*            1     1     0     0    0    0    1    1                             */
(0318) /**********************************************************************************/
(0319) 	ADCSRA |= (1 << ADEN);  //ADC 使能
    0149 9A37      SBI	0x06,7
(0320) 	ADCSRA |= (1 << ADSC);  //ADC 开始转换
    014A 9A36      SBI	0x06,6
(0321) 	ADCSRA &= ~(1 << ADATE);//无ADC 自动触发使能
    014B 9835      CBI	0x06,5
(0322) 	ADCSRA &= ~(1 << ADIF); //ADC 中断标志
    014C 9834      CBI	0x06,4
(0323) 	ADCSRA &= ~(1 << ADIE); //不使用中断
    014D 9833      CBI	0x06,3
(0324) 	ADCSRA |= (1 << ADPS2);//128分频时钟
    014E 9A32      SBI	0x06,2
(0325) 	ADCSRA |= (1 << ADPS1); //128分频时钟
    014F 9A31      SBI	0x06,1
(0326) 	ADCSRA |= (1 << ADPS0);//128分频时钟
    0150 9A30      SBI	0x06,0
(0327) 	
(0328) //------------------------------------------------------------------------------
(0329) 	while(!(ADCSRA & (1 << ADIF)));	//等待转换完成后ADIF自动置位
    0151 9B34      SBIS	0x06,4
    0152 CFFE      RJMP	0x0151
(0330) 	i = ADCH;
    0153 B105      IN	R16,0x05
(0331) 	ADCSRA &= ~(1 << ADIF);		/*清标志*/
    0154 9834      CBI	0x06,4
(0332) 	ADCSRA &= ~(1 << ADEN);		/*关闭转换*/
    0155 9837      CBI	0x06,7
(0333) 
(0334) 	return i;
    0156 9508      RET
_GetBaiwei:
  temp                 --> R20
    0157 940E0218  CALL	push_gset1
    0159 2F40      MOV	R20,R16
(0335) }
(0336) //--------------------------------//AD数据采集百位------------------------------
(0337) unsigned char GetBaiwei(unsigned char temp)   
(0338) {
(0339) 	temp = temp/100;
    015A E614      LDI	R17,0x64
    015B 2F04      MOV	R16,R20
    015C 940E01F4  CALL	div8u
    015E 2F40      MOV	R20,R16
(0340) 	return temp;
    015F 940E021B  CALL	pop_gset1
    0161 9508      RET
_GetShiwei:
  temp                 --> R20
    0162 940E0218  CALL	push_gset1
    0164 2F40      MOV	R20,R16
(0341) }
(0342) //-----------------------------//AD数据采集十位---------------------------------
(0343) unsigned char GetShiwei(unsigned char temp)  
(0344) {
(0345) 	if(temp > 99)
    0165 E683      LDI	R24,0x63
    0166 1784      CP	R24,R20
    0167 F428      BCC	0x016D
(0346) 	{
(0347) 		temp = temp - GetBaiwei(temp)*100;
    0168 2F04      MOV	R16,R20
    0169 DFED      RCALL	_GetBaiwei
    016A E684      LDI	R24,0x64
    016B 9F80      MUL	R24,R16
    016C 1940      SUB	R20,R0
(0348) 	}
(0349) 	temp = temp/10;
    016D E01A      LDI	R17,0xA
    016E 2F04      MOV	R16,R20
    016F 940E01F4  CALL	div8u
    0171 2F40      MOV	R20,R16
(0350) 	return temp;
    0172 940E021B  CALL	pop_gset1
    0174 9508      RET
_GetGewei:
  temp                 --> R20
    0175 940E0218  CALL	push_gset1
    0177 2F40      MOV	R20,R16
(0351) }
(0352) //---------------------------- //AD数据采集个位---------------------------------
(0353) unsigned char GetGewei(unsigned char temp)   
(0354) {
(0355) 	temp = temp%10;
    0178 E01A      LDI	R17,0xA
    0179 2F04      MOV	R16,R20
    017A 940E01F2  CALL	mod8u
    017C 2F40      MOV	R20,R16
(0356) 	return temp;
    017D 940E021B  CALL	pop_gset1
    017F 9508      RET
(0357) }
(0358) //------------------------------------------------------------------------------
(0359) void dis_zhuye()
(0360) {
(0361) 	 PORTC=seg1[AD_data[1]];
_dis_zhuye:
    0180 E784      LDI	R24,0x74
    0181 E090      LDI	R25,0
    0182 91E0008A  LDS	R30,AD_data+1
    0184 27FF      CLR	R31
    0185 0FE8      ADD	R30,R24
    0186 1FF9      ADC	R31,R25
    0187 8020      LDD	R2,Z+0
    0188 BA25      OUT	0x15,R2
(0362) 	 Hign_Display4;
    0189 9ADC      SBI	0x1B,4
(0363) 	 Hign_Display3;
    018A 9ADB      SBI	0x1B,3
(0364) 	 Hign_Display2;
    018B 9ADA      SBI	0x1B,2
(0365) 	 Low_Display1;
    018C 98D9      CBI	0x1B,1
(0366) 	 Delay(80);
    018D E500      LDI	R16,0x50
    018E E010      LDI	R17,0
    018F DECF      RCALL	_Delay
(0367) 	 Hign_Display1;
    0190 9AD9      SBI	0x1B,1
(0368) //------------------------------------------------------------------------------
(0369) 	 PORTC=seg[AD_data[2]];
    0191 E68A      LDI	R24,0x6A
    0192 E090      LDI	R25,0
    0193 91E0008B  LDS	R30,AD_data+2
    0195 27FF      CLR	R31
    0196 0FE8      ADD	R30,R24
    0197 1FF9      ADC	R31,R25
    0198 8020      LDD	R2,Z+0
    0199 BA25      OUT	0x15,R2
(0370) 	 Low_Display2;
    019A 98DA      CBI	0x1B,2
(0371) 	 Delay(80);
    019B E500      LDI	R16,0x50
    019C E010      LDI	R17,0
    019D DEC1      RCALL	_Delay
(0372) 	 Hign_Display2;
    019E 9ADA      SBI	0x1B,2
(0373) //------------------------------------------------ ---------------------------
(0374) 	 PORTC=seg[AD_data[3]];
    019F E68A      LDI	R24,0x6A
    01A0 E090      LDI	R25,0
    01A1 91E0008C  LDS	R30,AD_data+3
    01A3 27FF      CLR	R31
    01A4 0FE8      ADD	R30,R24
    01A5 1FF9      ADC	R31,R25
    01A6 8020      LDD	R2,Z+0
    01A7 BA25      OUT	0x15,R2
(0375) 	 Low_Display3;
    01A8 98DB      CBI	0x1B,3
(0376) 	 Delay(80);
    01A9 E500      LDI	R16,0x50
    01AA E010      LDI	R17,0
    01AB DEB3      RCALL	_Delay
(0377) 	 Hign_Display3;
    01AC 9ADB      SBI	0x1B,3
(0378) //----------------------------------------------------------------------------- 
(0379) 	 PORTC=0xc1;
    01AD EC81      LDI	R24,0xC1
    01AE BB85      OUT	0x15,R24
(0380) 	 Low_Display4;
    01AF 98DC      CBI	0x1B,4
(0381) 	 Delay(80);
    01B0 E500      LDI	R16,0x50
    01B1 E010      LDI	R17,0
    01B2 DEAC      RCALL	_Delay
(0382) 	 Hign_Display4;	 
    01B3 9ADC      SBI	0x1B,4
    01B4 9508      RET
(0383) }
(0384) 
(0385) main()
(0386) {
(0387)  	DDRB=0xe4;
_main:
    01B5 EE84      LDI	R24,0xE4
    01B6 BB87      OUT	0x17,R24
(0388) 	DDRC=0xff;
    01B7 EF8F      LDI	R24,0xFF
    01B8 BB84      OUT	0x14,R24
(0389) 	DDRA=0x1e;
    01B9 E18E      LDI	R24,0x1E
    01BA BB8A      OUT	0x1A,R24
(0390) 	PORTA=0x00;
    01BB 2422      CLR	R2
    01BC BA2B      OUT	0x1B,R2
(0391) 	PORTC=0xbf;
    01BD EB8F      LDI	R24,0xBF
    01BE BB85      OUT	0x15,R24
(0392) 
(0393)     init_NRF24L01() ;
    01BF DF5A      RCALL	_init_NRF24L01
    01C0 C02F      RJMP	0x01F0
(0394) 	
(0395) 	while(1)
(0396) 	{
(0397) 	AD_num=GetADResult();
    01C1 DF7F      RCALL	_GetADResult
    01C2 9300008D  STS	AD_num,R16
(0398) 	AD_data[0]=0xAA;                    
    01C4 EA8A      LDI	R24,0xAA
    01C5 93800089  STS	AD_data,R24
(0399) 	AD_data[1]=table[GetBaiwei( AD_num)];
    01C7 DF8F      RCALL	_GetBaiwei
    01C8 E680      LDI	R24,0x60
    01C9 E090      LDI	R25,0
    01CA 2FE0      MOV	R30,R16
    01CB 27FF      CLR	R31
    01CC 0FE8      ADD	R30,R24
    01CD 1FF9      ADC	R31,R25
    01CE 8020      LDD	R2,Z+0
    01CF 9220008A  STS	AD_data+1,R2
(0400) 	AD_data[2]=table[GetShiwei( AD_num)];
    01D1 9100008D  LDS	R16,AD_num
    01D3 DF8E      RCALL	_GetShiwei
    01D4 E680      LDI	R24,0x60
    01D5 E090      LDI	R25,0
    01D6 2FE0      MOV	R30,R16
    01D7 27FF      CLR	R31
    01D8 0FE8      ADD	R30,R24
    01D9 1FF9      ADC	R31,R25
    01DA 8020      LDD	R2,Z+0
    01DB 9220008B  STS	AD_data+2,R2
(0401) 	AD_data[3]=table[GetGewei( AD_num)];
    01DD 9100008D  LDS	R16,AD_num
    01DF DF95      RCALL	_GetGewei
    01E0 E680      LDI	R24,0x60
    01E1 E090      LDI	R25,0
    01E2 2FE0      MOV	R30,R16
    01E3 27FF      CLR	R31
    01E4 0FE8      ADD	R30,R24
    01E5 1FF9      ADC	R31,R25
    01E6 8020      LDD	R2,Z+0
    01E7 9220008C  STS	AD_data+3,R2
(0402) 	nRF24L01_TxPacket(AD_data);	// Transmit Tx buffer data
    01E9 E809      LDI	R16,0x89
    01EA E010      LDI	R17,0
    01EB DF16      RCALL	_nRF24L01_TxPacket
(0403)     SPI_RW_Reg(WRITE_REG+STATUS,0XFF);  
    01EC EF2F      LDI	R18,0xFF
    01ED E207      LDI	R16,0x27
    01EE DEAA      RCALL	_SPI_RW_Reg
(0404) 	dis_zhuye();
FILE: <library>
    01EF DF90      RCALL	_dis_zhuye
    01F0 CFD0      RJMP	0x01C1
    01F1 9508      RET
mod8u:
    01F2 9468      BSET	6
    01F3 C001      RJMP	xdiv8u
div8u:
    01F4 94E8      BCLR	6
xdiv8u:
    01F5 932A      ST	R18,-Y
