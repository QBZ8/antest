    01F9 24EE      CLR	R14
    01FA E120      LDI	R18,0x10
    01FB 0F00      LSL	R16
    01FC 1CFF      ROL	R15
    01FD 1CEE      ROL	R14
    01FE 16E1      CP	R14,R17
    01FF F010      BCS	0x0202
    0200 1AE1      SUB	R14,R17
    0201 9503      INC	R16
    0202 952A      DEC	R18
    0203 F7B9      BNE	0x01FB
    0204 F40E      BRTC	0x0206
