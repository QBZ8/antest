    020B 940C021C  JMP	pop
pop_gset4:
    020D E0E8      LDI	R30,0x8
    020E 940C021C  JMP	pop
push_gset5:
    0210 92FA      ST	R15,-Y
    0211 92EA      ST	R14,-Y
push_gset4:
    0212 92DA      ST	R13,-Y
    0213 92CA      ST	R12,-Y
push_gset3:
    0214 92BA      ST	R11,-Y
    0215 92AA      ST	R10,-Y
push_gset2:
    0216 937A      ST	R23,-Y
    0217 936A      ST	R22,-Y
push_gset1:
    0218 935A      ST	R21,-Y
    0219 934A      ST	R20,-Y
