(0201) /*函数：uint SPI_Read_Buf(uchar reg, uchar *pBuf, uchar uchars)
(0202) /*功能: 用于读数据，reg：为寄存器地址，pBuf：为待读出数据地址，uchars：读出数据的个数
(0203) /****************************************************************************************************/
(0204) char SPI_Read_Buf(char reg, char *pBuf, char uchars)
(0205) {
(0206) 	int status,uchar_ctr;
(0207) 	
(0208) 	Low_24L01_CSN;                    		// Set CSN low, init SPI tranaction
    00AD 98C7      CBI	0x18,7
(0209) 	status = SPI_RW(reg);       		// Select register to write to and read status uchar
    00AE 2F04      MOV	R16,R20
    00AF DFC4      RCALL	_SPI_RW
    00B0 2F40      MOV	R20,R16
    00B1 2755      CLR	R21
(0210) 	
(0211) 	for(uchar_ctr=0;uchar_ctr<uchars;uchar_ctr++)
    00B2 2766      CLR	R22
    00B3 2777      CLR	R23
    00B4 C008      RJMP	0x00BD
(0212) 		pBuf[uchar_ctr] = SPI_RW(0);    // 
    00B5 2700      CLR	R16
    00B6 DFBD      RCALL	_SPI_RW
    00B7 01FB      MOVW	R30,R22
    00B8 0DEC      ADD	R30,R12
    00B9 1DFD      ADC	R31,R13
    00BA 8300      STD	Z+0,R16
    00BB 5F6F      SUBI	R22,0xFF
    00BC 4F7F      SBCI	R23,0xFF
    00BD 2C2A      MOV	R2,R10
    00BE 2433      CLR	R3
    00BF 1562      CP	R22,R2
    00C0 0573      CPC	R23,R3
    00C1 F39C      BLT	0x00B5
(0213) 	
(0214) 	Hign_24L01_CSN;                           
    00C2 9AC7      SBI	0x18,7
(0215) 	
(0216) 	return(status);                    // return nRF24L01 status uchar
    00C3 2F04      MOV	R16,R20
    00C4 940E020D  CALL	pop_gset4
    00C6 9508      RET
_SPI_Write_Buf:
  status               --> R20
  uchar_ctr            --> R22
  uchars               --> R10
  pBuf                 --> R12
  reg                  --> R20
    00C7 940E0212  CALL	push_gset4
    00C9 0169      MOVW	R12,R18
    00CA 2F40      MOV	R20,R16
    00CB 84A8      LDD	R10,Y+8
(0217) }
