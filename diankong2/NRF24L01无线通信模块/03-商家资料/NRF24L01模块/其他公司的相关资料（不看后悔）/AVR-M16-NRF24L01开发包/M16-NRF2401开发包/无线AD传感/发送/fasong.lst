(0172) /*函数：uchar SPI_Read(uchar reg)
(0173) /*功能：NRF24L01的SPI时序
(0174) /****************************************************************************************************/
(0175) char SPI_Read(char reg)
(0176) {
(0177) 	char reg_val;
(0178) 	
(0179) 	Low_24L01_CSN;                // CSN low, initialize SPI communication...
    008F 98C7      CBI	0x18,7
(0180) 	SPI_RW(reg);            // Select register to read from..
    0090 2F04      MOV	R16,R20
    0091 DFE2      RCALL	_SPI_RW
(0181) 	reg_val = SPI_RW(0);    // ..then read registervalue
    0092 2700      CLR	R16
    0093 DFE0      RCALL	_SPI_RW
    0094 2F40      MOV	R20,R16
(0182) 	Hign_24L01_CSN;                // CSN high, terminate SPI communication
    0095 9AC7      SBI	0x18,7
(0183) 	
(0184) 	return(reg_val);        // return register value
    0096 940E021B  CALL	pop_gset1
    0098 9508      RET
_SPI_RW_Reg:
  status               --> R20
  value                --> R22
  reg                  --> R20
    0099 940E0216  CALL	push_gset2
    009B 2F62      MOV	R22,R18
    009C 2F40      MOV	R20,R16
(0185) }
(0186) /****************************************************************************************************/
(0187) /*功能：NRF24L01读写寄存器函数
(0188) /****************************************************************************************************/
(0189) char SPI_RW_Reg(char reg, char value)
(0190) {
(0191) 	char status;
(0192) 	
(0193) 	Low_24L01_CSN;                   // CSN low, init SPI transaction
    009D 98C7      CBI	0x18,7
(0194) 	status = SPI_RW(reg);      // select register
    009E 2F04      MOV	R16,R20
    009F DFD4      RCALL	_SPI_RW
    00A0 2F40      MOV	R20,R16
(0195) 	SPI_RW(value);             // ..and write value to it..
    00A1 2F06      MOV	R16,R22
    00A2 DFD1      RCALL	_SPI_RW
(0196) 	Hign_24L01_CSN;                   // CSN high again
    00A3 9AC7      SBI	0x18,7
(0197) 	
(0198) 	return(status);            // return nRF24L01 status uchar
    00A4 2F04      MOV	R16,R20
    00A5 940E020A  CALL	pop_gset2
    00A7 9508      RET
_SPI_Read_Buf:
  status               --> R20
  uchar_ctr            --> R22
  uchars               --> R10
  pBuf                 --> R12
  reg                  --> R20
