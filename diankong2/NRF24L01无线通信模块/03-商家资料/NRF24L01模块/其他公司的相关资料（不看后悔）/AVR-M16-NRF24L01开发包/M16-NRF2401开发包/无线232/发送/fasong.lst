(0191) /*函数：uint SPI_Read_Buf(uchar reg, uchar *pBuf, uchar uchars)
(0192) /*功能: 用于读数据，reg：为寄存器地址，pBuf：为待读出数据地址，uchars：读出数据的个数
(0193) /****************************************************************************************************/
(0194) char SPI_Read_Buf(char reg, char *pBuf, char uchars)
(0195) {
(0196) 	int status,uchar_ctr;
(0197) 	
(0198) 	Low_24L01_CSN;                    		// Set CSN low, init SPI tranaction
    00B9 98C7      CBI	0x18,7
(0199) 	status = SPI_RW(reg);       		// Select register to write to and read status uchar
    00BA 2F04      MOV	R16,R20
    00BB DFC4      RCALL	_SPI_RW
    00BC 2F40      MOV	R20,R16
    00BD 2755      CLR	R21
(0200) 	
(0201) 	for(uchar_ctr=0;uchar_ctr<uchars;uchar_ctr++)
    00BE 2766      CLR	R22
    00BF 2777      CLR	R23
    00C0 C008      RJMP	0x00C9
(0202) 		pBuf[uchar_ctr] = SPI_RW(0);    // 
    00C1 2700      CLR	R16
    00C2 DFBD      RCALL	_SPI_RW
    00C3 01FB      MOVW	R30,R22
    00C4 0DEC      ADD	R30,R12
    00C5 1DFD      ADC	R31,R13
    00C6 8300      STD	Z+0,R16
    00C7 5F6F      SUBI	R22,0xFF
    00C8 4F7F      SBCI	R23,0xFF
    00C9 2C2A      MOV	R2,R10
    00CA 2433      CLR	R3
    00CB 1562      CP	R22,R2
    00CC 0573      CPC	R23,R3
    00CD F39C      BLT	0x00C1
(0203) 	
(0204) 	Hign_24L01_CSN;                           
    00CE 9AC7      SBI	0x18,7
(0205) 	
(0206) 	return(status);                    // return nRF24L01 status uchar
    00CF 2F04      MOV	R16,R20
    00D0 940E0167  CALL	pop_gset4
    00D2 9508      RET
_SPI_Write_Buf:
  status               --> R20
  uchar_ctr            --> R22
  uchars               --> R10
  pBuf                 --> R12
  reg                  --> R20
    00D3 940E016C  CALL	push_gset4
    00D5 0169      MOVW	R12,R18
    00D6 2F40      MOV	R20,R16
    00D7 84A8      LDD	R10,Y+8
(0207) }
