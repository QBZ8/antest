(0224) /*函数：void SetRX_Mode(void)
(0225) /*功能：数据接收配置 
(0226) /****************************************************************************************************/
(0227) void SetRX_Mode(void)
(0228) {
(0229) 	Low_24L01_CE;
_SetRX_Mode:
    00EA 98C5      CBI	0x18,5
(0230) 	SPI_RW_Reg(WRITE_REG + CONFIG, 0x0f);   		// IRQ收发完成中断响应，16位CRC	，主接收
    00EB E02F      LDI	R18,0xF
    00EC E200      LDI	R16,0x20
    00ED DFB7      RCALL	_SPI_RW_Reg
(0231) 	Hign_24L01_CE; 
    00EE 9AC5      SBI	0x18,5
(0232) 	inerDelay_us(130);
    00EF E802      LDI	R16,0x82
    00F0 DF89      RCALL	_inerDelay_us
    00F1 9508      RET
_nRF24L01_RxPacket:
  revale               --> R20
  rx_buf               --> R22
    00F2 940E0170  CALL	push_gset2
    00F4 01B8      MOVW	R22,R16
    00F5 9721      SBIW	R28,1
(0233) }
