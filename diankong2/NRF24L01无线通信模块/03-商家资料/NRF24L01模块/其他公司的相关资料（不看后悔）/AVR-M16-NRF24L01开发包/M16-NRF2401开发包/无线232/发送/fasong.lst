(0177) /*功能：NRF24L01读写寄存器函数
(0178) /****************************************************************************************************/
(0179) char SPI_RW_Reg(char reg, char value)
(0180) {
(0181) 	char status;
(0182) 	
(0183) 	Low_24L01_CSN;                   // CSN low, init SPI transaction
    00A9 98C7      CBI	0x18,7
(0184) 	status = SPI_RW(reg);      // select register
    00AA 2F04      MOV	R16,R20
    00AB DFD4      RCALL	_SPI_RW
    00AC 2F40      MOV	R20,R16
(0185) 	SPI_RW(value);             // ..and write value to it..
    00AD 2F06      MOV	R16,R22
    00AE DFD1      RCALL	_SPI_RW
(0186) 	Hign_24L01_CSN;                   // CSN high again
    00AF 9AC7      SBI	0x18,7
(0187) 	
(0188) 	return(status);            // return nRF24L01 status uchar
    00B0 2F04      MOV	R16,R20
    00B1 940E0164  CALL	pop_gset2
    00B3 9508      RET
_SPI_Read_Buf:
  status               --> R20
  uchar_ctr            --> R22
  uchars               --> R10
  pBuf                 --> R12
  reg                  --> R20
    00B4 940E016C  CALL	push_gset4
    00B6 0169      MOVW	R12,R18
    00B7 2F40      MOV	R20,R16
    00B8 84A8      LDD	R10,Y+8
(0189) }
