(0235) /*函数：unsigned char nRF24L01_RxPacket(unsigned char* rx_buf)
(0236) /*功能：数据读取后放如rx_buf接收缓冲区中
(0237) /******************************************************************************************************/
(0238) char nRF24L01_RxPacket(char* rx_buf)
(0239) {
(0240)     char revale=0;
    00F6 2744      CLR	R20
(0241) 	sta=SPI_Read(STATUS);	// 读取状态寄存其来判断数据接收状况
    00F7 E007      LDI	R16,7
    00F8 DF9F      RCALL	_SPI_Read
    00F9 93000094  STS	sta,R16
(0242) 	if(sta&0x40)				// 判断是否接收到数据
    00FB FF06      SBRS	R16,6
    00FC C007      RJMP	0x0104
(0243) 	{
(0244) 	    Low_24L01_CE; 			//SPI使能
    00FD 98C5      CBI	0x18,5
(0245) 		SPI_Read_Buf(RD_RX_PLOAD,rx_buf,TX_PLOAD_WIDTH);// read receive payload from RX_FIFO buffer
    00FE E280      LDI	R24,0x20
    00FF 8388      STD	Y+0,R24
    0100 019B      MOVW	R18,R22
    0101 E601      LDI	R16,0x61
    0102 DFB1      RCALL	_SPI_Read_Buf
(0246) 		revale =1;			//读取数据完成标志
    0103 E041      LDI	R20,1
(0247) 	}
(0248) 	SPI_RW_Reg(WRITE_REG+STATUS,sta);   //接收到数据后RX_DR,TX_DS,MAX_PT都置高为1，通过写1来清楚中断标志
    0104 91200094  LDS	R18,sta
    0106 E207      LDI	R16,0x27
    0107 DF9D      RCALL	_SPI_RW_Reg
(0249) 	return revale;
    0108 2F04      MOV	R16,R20
    0109 9621      ADIW	R28,1
    010A 940E0164  CALL	pop_gset2
    010C 9508      RET
_nRF24L01_TxPacket:
  tx_buf               --> R20
    010D 940E0172  CALL	push_gset1
    010F 01A8      MOVW	R20,R16
    0110 9721      SBIW	R28,1
(0250) }
(0251) /***********************************************************************************************************
(0252) /*函数：void nRF24L01_TxPacket(char * tx_buf)
(0253) /*功能：发送 tx_buf中数据
(0254) /**********************************************************************************************************/
(0255) void nRF24L01_TxPacket(char * tx_buf)
(0256) {
(0257) 	Low_24L01_CE;			//StandBy I模式	
    0111 98C5      CBI	0x18,5
(0258) 	SPI_Write_Buf(WRITE_REG + RX_ADDR_P0, TX_ADDRESS, TX_ADR_WIDTH); // 装载接收端地址
    0112 E085      LDI	R24,5
    0113 8388      STD	Y+0,R24
    0114 E82A      LDI	R18,0x8A
    0115 E030      LDI	R19,0
    0116 E20A      LDI	R16,0x2A
    0117 DFBB      RCALL	_SPI_Write_Buf
(0259) 	SPI_Write_Buf(WR_TX_PLOAD, tx_buf, TX_PLOAD_WIDTH); 			 // 装载数据	
    0118 E280      LDI	R24,0x20
    0119 8388      STD	Y+0,R24
    011A 019A      MOVW	R18,R20
    011B EA00      LDI	R16,0xA0
    011C DFB6      RCALL	_SPI_Write_Buf
(0260) //	SPI_RW_Reg(WRITE_REG + CONFIG, 0x0e);   		 // IRQ收发完成中断响应，16位CRC，主发送
(0261) 	Hign_24L01_CE;		 //置高CE，激发数据发送
    011D 9AC5      SBI	0x18,5
(0262) 	inerDelay_us(10);
    011E E00A      LDI	R16,0xA
    011F DF5A      RCALL	_inerDelay_us
    0120 9621      ADIW	R28,1
    0121 940E0175  CALL	pop_gset1
    0123 9508      RET
_init_NRF24L01:
    0124 9721      SBIW	R28,1
(0263) }
(0264) //****************************************************************************************
(0265) /*NRF24L01初始化
(0266) //***************************************************************************************/
(0267) void init_NRF24L01(void)
(0268) {
(0269)     inerDelay_us(100);
    0125 E604      LDI	R16,0x64
    0126 DF53      RCALL	_inerDelay_us
(0270)  	Low_24L01_CE;    // chip enable
    0127 98C5      CBI	0x18,5
(0271)  	Hign_24L01_CSN;   // Spi disable 
    0128 9AC7      SBI	0x18,7
(0272)  	Low_24L01_SCK;   // Spi clock line init high
    0129 98C6      CBI	0x18,6
(0273) 	SPI_Write_Buf(WRITE_REG + TX_ADDR, TX_ADDRESS, TX_ADR_WIDTH);    // 写本地地址	
    012A E085      LDI	R24,5
    012B 8388      STD	Y+0,R24
    012C E82A      LDI	R18,0x8A
    012D E030      LDI	R19,0
    012E E300      LDI	R16,0x30
    012F DFA3      RCALL	_SPI_Write_Buf
(0274) 	SPI_Write_Buf(WRITE_REG + RX_ADDR_P0, RX_ADDRESS, RX_ADR_WIDTH); // 写接收端地址
    0130 E085      LDI	R24,5
    0131 8388      STD	Y+0,R24
    0132 E82F      LDI	R18,0x8F
    0133 E030      LDI	R19,0
    0134 E20A      LDI	R16,0x2A
    0135 DF9D      RCALL	_SPI_Write_Buf
(0275) 	SPI_RW_Reg(WRITE_REG + EN_AA, 0x01);      //  频道0自动	ACK应答允许	
    0136 E021      LDI	R18,1
    0137 E201      LDI	R16,0x21
    0138 DF6C      RCALL	_SPI_RW_Reg
(0276) 	SPI_RW_Reg(WRITE_REG + EN_RXADDR, 0x01);  //  允许接收地址只有频道0，如果需要多频道可以参考Page21  
    0139 E021      LDI	R18,1
    013A E202      LDI	R16,0x22
    013B DF69      RCALL	_SPI_RW_Reg
(0277) 	SPI_RW_Reg(WRITE_REG + RF_CH, 0);        //   设置信道工作为2.4GHZ，收发必须一致
    013C 2722      CLR	R18
    013D E205      LDI	R16,0x25
    013E DF66      RCALL	_SPI_RW_Reg
(0278) 	SPI_RW_Reg(WRITE_REG + RX_PW_P0, RX_PLOAD_WIDTH); //设置接收数据长度，本次设置为32字节
    013F E220      LDI	R18,0x20
    0140 E301      LDI	R16,0x31
    0141 DF63      RCALL	_SPI_RW_Reg
(0279) 	SPI_RW_Reg(WRITE_REG + RF_SETUP, 0x07);   		//设置发射速率为1MHZ，发射功率为最大值0dB	
    0142 E027      LDI	R18,7
    0143 E206      LDI	R16,0x26
    0144 DF60      RCALL	_SPI_RW_Reg
(0280) 	SPI_RW_Reg(WRITE_REG + CONFIG, 0x0e);   		 // IRQ收发完成中断响应，16位CRC，主发送
    0145 E02E      LDI	R18,0xE
    0146 E200      LDI	R16,0x20
    0147 DF5D      RCALL	_SPI_RW_Reg
    0148 9621      ADIW	R28,1
    0149 9508      RET
(0281) 
(0282) }
(0283) main()
(0284) {
(0285)  	DDRB=0xe4;
_main:
    014A EE84      LDI	R24,0xE4
    014B BB87      OUT	0x17,R24
