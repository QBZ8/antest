(0209) /*函数：uint SPI_Write_Buf(uchar reg, uchar *pBuf, uchar uchars)
(0210) /*功能: 用于写数据：为寄存器地址，pBuf：为待写入数据地址，uchars：写入数据的个数
(0211) /*********************************************************************************************************/
(0212) char SPI_Write_Buf(char reg, char *pBuf, char uchars)
(0213) {
(0214) 	char status,uchar_ctr;
(0215) 	
(0216) 	Low_24L01_CSN;             //SPI使能       
    00D8 98C7      CBI	0x18,7
(0217) 	status = SPI_RW(reg);   
    00D9 2F04      MOV	R16,R20
    00DA DFA5      RCALL	_SPI_RW
    00DB 2F40      MOV	R20,R16
(0218) 	for(uchar_ctr=0; uchar_ctr<uchars; uchar_ctr++) //
    00DC 2766      CLR	R22
    00DD C005      RJMP	0x00E3
(0219) 	SPI_RW(*pBuf++);
    00DE 01F6      MOVW	R30,R12
    00DF 9101      LD	R16,Z+
    00E0 016F      MOVW	R12,R30
    00E1 DF9E      RCALL	_SPI_RW
    00E2 9563      INC	R22
    00E3 156A      CP	R22,R10
    00E4 F3C8      BCS	0x00DE
(0220) 	Hign_24L01_CSN;           //关闭SPI
    00E5 9AC7      SBI	0x18,7
(0221) 	return(status);    		  // 
    00E6 2F04      MOV	R16,R20
    00E7 940E0167  CALL	pop_gset4
    00E9 9508      RET
(0222) }
