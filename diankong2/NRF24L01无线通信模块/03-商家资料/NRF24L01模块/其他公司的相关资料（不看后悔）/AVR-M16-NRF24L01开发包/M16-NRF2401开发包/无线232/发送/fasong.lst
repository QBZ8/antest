(0162) /*函数：uchar SPI_Read(uchar reg)
(0163) /*功能：NRF24L01的SPI时序
(0164) /****************************************************************************************************/
(0165) char SPI_Read(char reg)
(0166) {
(0167) 	char reg_val;
(0168) 	
(0169) 	Low_24L01_CSN;                // CSN low, initialize SPI communication...
    009B 98C7      CBI	0x18,7
(0170) 	SPI_RW(reg);            // Select register to read from..
    009C 2F04      MOV	R16,R20
    009D DFE2      RCALL	_SPI_RW
(0171) 	reg_val = SPI_RW(0);    // ..then read registervalue
    009E 2700      CLR	R16
    009F DFE0      RCALL	_SPI_RW
    00A0 2F40      MOV	R20,R16
(0172) 	Hign_24L01_CSN;                // CSN high, terminate SPI communication
    00A1 9AC7      SBI	0x18,7
(0173) 	
(0174) 	return(reg_val);        // return register value
    00A2 940E0175  CALL	pop_gset1
    00A4 9508      RET
_SPI_RW_Reg:
  status               --> R20
  value                --> R22
  reg                  --> R20
    00A5 940E0170  CALL	push_gset2
