(0137) /*函数：uint SPI_RW(uint uchar)
(0138) /*功能：NRF24L01的SPI写时序
(0139) /****************************************************************************************************/
(0140) char SPI_RW(char data)
(0141) {
(0142) 	char i,temp=0;
    0082 2744      CLR	R20
(0143)    	for(i=0;i<8;i++) // output 8-bit
    0083 2766      CLR	R22
    0084 C00D      RJMP	0x0092
(0144)    	{
(0145) 	if(data & 0x80)
    0085 FF07      SBRS	R16,7
    0086 C002      RJMP	0x0089
(0146) 	{
(0147) 		Hign_24L01_MOSI ;         // output 'uchar', MSB to MOSI
    0087 9AC2      SBI	0x18,2
(0148) 	}
    0088 C001      RJMP	0x008A
(0149) 	else
(0150) 	{
(0151) 	 	Low_24L01_MOSI; 
    0089 98C2      CBI	0x18,2
(0152) 	}	
(0153) 		data = (data << 1);           // shift next bit into MSB..
    008A 0F00      LSL	R16
(0154) 		temp<<=1;
    008B 0F44      LSL	R20
(0155) 		Hign_24L01_SCK ;                      // Set SCK high..
    008C 9AC6      SBI	0x18,6
(0156) 		if(Read_24L01_MISO )temp++;       		  // capture current MISO bit
    008D 9BB4      SBIS	0x16,4
    008E C001      RJMP	0x0090
    008F 9543      INC	R20
(0157) 		Low_24L01_SCK;            		  // ..then set SCK low again
    0090 98C6      CBI	0x18,6
    0091 9563      INC	R22
    0092 3068      CPI	R22,0x8
    0093 F388      BCS	0x0085
(0158)    	}
(0159)     return(temp);           		  // return read uchar
    0094 2F04      MOV	R16,R20
    0095 940E0164  CALL	pop_gset2
    0097 9508      RET
_SPI_Read:
  reg_val              --> R20
  reg                  --> R20
    0098 940E0172  CALL	push_gset1
    009A 2F40      MOV	R20,R16
(0160) }
