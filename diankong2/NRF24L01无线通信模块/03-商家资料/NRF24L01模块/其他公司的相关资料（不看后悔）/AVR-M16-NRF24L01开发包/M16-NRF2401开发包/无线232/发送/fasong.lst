    014C EF8F      LDI	R24,0xFF
    014D BB84      OUT	0x14,R24
(0287) 	DDRA=0x1e;
    014E E18E      LDI	R24,0x1E
    014F BB8A      OUT	0x1A,R24
(0288) 	PORTA=0x00;
    0150 2422      CLR	R2
