(0220) /*函数：void SetRX_Mode(void)
(0221) /*功能：数据接收配置 
(0222) /****************************************************************************************************/
(0223) void SetRX_Mode(void)
(0224) {
(0225) 	Low_24L01_CE;
_SetRX_Mode:
    00E4 98C5      CBI	0x18,5
(0226) 	//SPI_RW_Reg(WRITE_REG + CONFIG, 0x0f);   		// IRQ收发完成中断响应，16位CRC	，主接收
(0227) 	Hign_24L01_CE; 
    00E5 9AC5      SBI	0x18,5
(0228) 	Delay(1000);//注意不能太小
    00E6 EE08      LDI	R16,0xE8
    00E7 E013      LDI	R17,3
    00E8 DF7C      RCALL	_Delay
    00E9 9508      RET
_nRF24L01_RxPacket:
  revale               --> R20
  rx_buf               --> R22
    00EA 940E01AE  CALL	push_gset2
    00EC 01B8      MOVW	R22,R16
    00ED 9721      SBIW	R28,1
(0229) }
