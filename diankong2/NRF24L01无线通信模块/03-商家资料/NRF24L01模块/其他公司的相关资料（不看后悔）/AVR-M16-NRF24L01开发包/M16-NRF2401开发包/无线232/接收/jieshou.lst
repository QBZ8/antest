(0158) /*函数：uchar SPI_Read(uchar reg)
(0159) /*功能：NRF24L01的SPI时序
(0160) /****************************************************************************************************/
(0161) char SPI_Read(char reg)
(0162) {
(0163) 	char reg_val;
(0164) 	
(0165) 	Low_24L01_CSN;                // CSN low, initialize SPI communication...
    0095 98C7      CBI	0x18,7
(0166) 	SPI_RW(reg);            // Select register to read from..
    0096 2F04      MOV	R16,R20
    0097 DFE2      RCALL	_SPI_RW
(0167) 	reg_val = SPI_RW(0);    // ..then read registervalue
    0098 2700      CLR	R16
    0099 DFE0      RCALL	_SPI_RW
    009A 2F40      MOV	R20,R16
(0168) 	Hign_24L01_CSN;                // CSN high, terminate SPI communication
    009B 9AC7      SBI	0x18,7
(0169) 	
(0170) 	return(reg_val);        // return register value
    009C 940E01B3  CALL	pop_gset1
    009E 9508      RET
_SPI_RW_Reg:
  status               --> R20
  value                --> R22
  reg                  --> R20
    009F 940E01AE  CALL	push_gset2
    00A1 2F62      MOV	R22,R18
    00A2 2F40      MOV	R20,R16
(0171) }
