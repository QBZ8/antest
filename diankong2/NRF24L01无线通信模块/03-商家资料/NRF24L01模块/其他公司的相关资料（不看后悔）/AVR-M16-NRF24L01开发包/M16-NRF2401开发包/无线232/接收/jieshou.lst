(0173) /*功能：NRF24L01读写寄存器函数
(0174) /****************************************************************************************************/
(0175) char SPI_RW_Reg(char reg, char value)
(0176) {
(0177) 	char status;
(0178) 	
(0179) 	Low_24L01_CSN;                   // CSN low, init SPI transaction
    00A3 98C7      CBI	0x18,7
(0180) 	status = SPI_RW(reg);      // select register
    00A4 2F04      MOV	R16,R20
    00A5 DFD4      RCALL	_SPI_RW
    00A6 2F40      MOV	R20,R16
(0181) 	SPI_RW(value);             // ..and write value to it..
    00A7 2F06      MOV	R16,R22
    00A8 DFD1      RCALL	_SPI_RW
(0182) 	Hign_24L01_CSN;                   // CSN high again
    00A9 9AC7      SBI	0x18,7
(0183) 	
(0184) 	return(status);            // return nRF24L01 status uchar
    00AA 2F04      MOV	R16,R20
    00AB 940E01A2  CALL	pop_gset2
    00AD 9508      RET
_SPI_Read_Buf:
  status1              --> R20
  uchar_ctr            --> R22
  uchars               --> R10
  pBuf                 --> R12
  reg                  --> R20
    00AE 940E01AA  CALL	push_gset4
    00B0 0169      MOVW	R12,R18
    00B1 2F40      MOV	R20,R16
    00B2 84A8      LDD	R10,Y+8
(0185) }
