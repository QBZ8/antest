(0231) /*函数：unsigned char nRF24L01_RxPacket(unsigned char* rx_buf)
(0232) /*功能：数据读取后放如rx_buf接收缓冲区中
(0233) /******************************************************************************************************/
(0234) char nRF24L01_RxPacket(char* rx_buf)
(0235) {
(0236)     char revale=0;
    00EE 2744      CLR	R20
(0237) 	sta=SPI_Read(STATUS);	     // 读取状态寄存其来判断数据接收状况		
    00EF E007      LDI	R16,7
    00F0 DFA1      RCALL	_SPI_Read
    00F1 93000095  STS	sta,R16
(0238) 	if(sta&0x40)                 // 判断是否接收到数据
    00F3 FF06      SBRS	R16,6
    00F4 C007      RJMP	0x00FC
(0239) 	{
(0240) 	    Low_24L01_CE; 			//SPI使能
    00F5 98C5      CBI	0x18,5
(0241) 		SPI_Read_Buf(RD_RX_PLOAD,rx_buf,TX_PLOAD_WIDTH);// read receive payload from RX_FIFO buffer
    00F6 E280      LDI	R24,0x20
    00F7 8388      STD	Y+0,R24
    00F8 019B      MOVW	R18,R22
    00F9 E601      LDI	R16,0x61
    00FA DFB3      RCALL	_SPI_Read_Buf
(0242) 		revale =1;			//读取数据完成标志
    00FB E041      LDI	R20,1
(0243) 	}
(0244) 	SPI_RW_Reg(WRITE_REG+STATUS,sta);   //接收到数据后RX_DR,TX_DS,MAX_PT都置高为1，通过写1来清楚中断标志
    00FC 91200095  LDS	R18,sta
    00FE E207      LDI	R16,0x27
    00FF DF9F      RCALL	_SPI_RW_Reg
(0245) 	return revale;
    0100 2F04      MOV	R16,R20
    0101 9621      ADIW	R28,1
    0102 940E01A2  CALL	pop_gset2
    0104 9508      RET
_nRF24L01_TxPacket:
  tx_buf               --> R20
    0105 940E01B0  CALL	push_gset1
    0107 01A8      MOVW	R20,R16
    0108 9721      SBIW	R28,1
(0246) }
(0247) /***********************************************************************************************************
(0248) /*函数：void nRF24L01_TxPacket(char * tx_buf)
(0249) /*功能：发送 tx_buf中数据
(0250) /**********************************************************************************************************/
(0251) void nRF24L01_TxPacket(char * tx_buf)
(0252) {
(0253) 	Low_24L01_CE;			//StandBy I模式	
    0109 98C5      CBI	0x18,5
(0254) 	SPI_Write_Buf(WRITE_REG + RX_ADDR_P0, TX_ADDRESS, TX_ADR_WIDTH); // 装载接收端地址
    010A E085      LDI	R24,5
    010B 8388      STD	Y+0,R24
    010C E82A      LDI	R18,0x8A
    010D E030      LDI	R19,0
    010E E20A      LDI	R16,0x2A
    010F DFBD      RCALL	_SPI_Write_Buf
(0255) 	SPI_Write_Buf(WR_TX_PLOAD, tx_buf, TX_PLOAD_WIDTH); 			 // 装载数据	
    0110 E280      LDI	R24,0x20
    0111 8388      STD	Y+0,R24
    0112 019A      MOVW	R18,R20
    0113 EA00      LDI	R16,0xA0
    0114 DFB8      RCALL	_SPI_Write_Buf
(0256) //	SPI_RW_Reg(WRITE_REG + CONFIG, 0x0e);   		 // IRQ收发完成中断响应，16位CRC，主发送
(0257) 	Hign_24L01_CE;		 //置高CE，激发数据发送
    0115 9AC5      SBI	0x18,5
(0258) 	Delay(600);
    0116 E508      LDI	R16,0x58
    0117 E012      LDI	R17,2
    0118 DF4C      RCALL	_Delay
    0119 9621      ADIW	R28,1
    011A 940E01B3  CALL	pop_gset1
    011C 9508      RET
_init_NRF24L01:
    011D 9721      SBIW	R28,1
(0259) }
(0260) //****************************************************************************************
(0261) /*NRF24L01初始化
(0262) //***************************************************************************************/
(0263) void init_NRF24L01(void)
(0264) {
(0265) 
(0266)  	Low_24L01_CE;    // chip enable
    011E 98C5      CBI	0x18,5
(0267)  	Hign_24L01_CSN;   // Spi disable 
    011F 9AC7      SBI	0x18,7
(0268)  	Low_24L01_SCK;   // Spi clock line init high
    0120 98C6      CBI	0x18,6
(0269) 	SPI_Write_Buf(WRITE_REG + TX_ADDR, TX_ADDRESS, TX_ADR_WIDTH);    // 写本地地址	
    0121 E085      LDI	R24,5
    0122 8388      STD	Y+0,R24
    0123 E82A      LDI	R18,0x8A
    0124 E030      LDI	R19,0
    0125 E300      LDI	R16,0x30
    0126 DFA6      RCALL	_SPI_Write_Buf
(0270) 	SPI_Write_Buf(WRITE_REG + RX_ADDR_P0, RX_ADDRESS, RX_ADR_WIDTH); // 写接收端地址
    0127 E085      LDI	R24,5
    0128 8388      STD	Y+0,R24
    0129 E82F      LDI	R18,0x8F
    012A E030      LDI	R19,0
    012B E20A      LDI	R16,0x2A
    012C DFA0      RCALL	_SPI_Write_Buf
(0271) 	SPI_RW_Reg(WRITE_REG + EN_AA, 0x01);      //  频道0自动	ACK应答允许	
    012D E021      LDI	R18,1
    012E E201      LDI	R16,0x21
    012F DF6F      RCALL	_SPI_RW_Reg
(0272) 	SPI_RW_Reg(WRITE_REG + EN_RXADDR, 0x01);  //  允许接收地址只有频道0，如果需要多频道可以参考Page21  
    0130 E021      LDI	R18,1
    0131 E202      LDI	R16,0x22
    0132 DF6C      RCALL	_SPI_RW_Reg
(0273) 	SPI_RW_Reg(WRITE_REG + RF_CH, 0);        //   设置信道工作为2.4GHZ，收发必须一致
    0133 2722      CLR	R18
    0134 E205      LDI	R16,0x25
    0135 DF69      RCALL	_SPI_RW_Reg
(0274) 	SPI_RW_Reg(WRITE_REG + RX_PW_P0, RX_PLOAD_WIDTH); //设置接收数据长度，本次设置为32字节
    0136 E220      LDI	R18,0x20
    0137 E301      LDI	R16,0x31
    0138 DF66      RCALL	_SPI_RW_Reg
(0275) 	SPI_RW_Reg(WRITE_REG + RF_SETUP, 0x07);   		//设置发射速率为1MHZ，发射功率为最大值0dB
    0139 E027      LDI	R18,7
    013A E206      LDI	R16,0x26
    013B DF63      RCALL	_SPI_RW_Reg
(0276) 	SPI_RW_Reg(WRITE_REG + CONFIG, 0x0f);   		// IRQ收发完成中断响应，16位CRC	，主接收}
    013C E02F      LDI	R18,0xF
    013D E200      LDI	R16,0x20
    013E DF60      RCALL	_SPI_RW_Reg
(0277)     Delay(6000);
    013F E700      LDI	R16,0x70
    0140 E117      LDI	R17,0x17
    0141 DF23      RCALL	_Delay
    0142 9621      ADIW	R28,1
    0143 9508      RET
(0278) }
(0279) //-------------------------------串口初始化-------------------------------------
(0280) void StartUART(void)
(0281) {
(0282)  	 UCSRA=0x00;	
_StartUART:
    0144 2422      CLR	R2
    0145 B82B      OUT	0x0B,R2
(0283) 	 UCSRB=0x18;	
    0146 E188      LDI	R24,0x18
    0147 B98A      OUT	0x0A,R24
(0284) 	 UCSRC=0x06;	
    0148 E086      LDI	R24,6
    0149 BD80      OUT	0x20,R24
(0285) 	 UBRRL=0x67;
    014A E687      LDI	R24,0x67
    014B B989      OUT	0x09,R24
(0286) 	 UBRRH=0x00;
    014C BC20      OUT	0x20,R2
(0287) 	 UCSRA=UCSRA|0x08;	
    014D 9A5B      SBI	0x0B,3
    014E 9508      RET
(0288) }
(0289) //------------------------------串口发送----------------------------------------
(0290) void R_S_Byte(char R_Byte)
(0291) {	
(0292)      UDR= R_Byte;  
_R_S_Byte:
  R_Byte               --> R16
    014F B90C      OUT	0x0C,R16
    0150 9508      RET
(0293) }
(0294) //******************************************************************************
(0295) void display()
(0296) {
(0297)  	 	
(0298) 	if(count<4)
_display:
    0151 91800094  LDS	R24,count
    0153 3084      CPI	R24,4
    0154 F4B8      BCC	0x016C
(0299) 		{
(0300) 		switch(count)
    0155 2F08      MOV	R16,R24
    0156 2711      CLR	R17
    0157 3001      CPI	R16,1
    0158 E0E0      LDI	R30,0
    0159 071E      CPC	R17,R30
    015A F049      BEQ	0x0164
    015B 3002      CPI	R16,2
    015C E0E0      LDI	R30,0
    015D 071E      CPC	R17,R30
    015E F041      BEQ	0x0167
    015F 3003      CPI	R16,3
    0160 E0E0      LDI	R30,0
    0161 071E      CPC	R17,R30
    0162 F039      BEQ	0x016A
    0163 C008      RJMP	0x016C
(0301) 		{
(0302) 		case 	1:	
(0303) 		PORTC=0xFE;
    0164 EF8E      LDI	R24,0xFE
    0165 BB85      OUT	0x15,R24
(0304) 		break;	
    0166 C005      RJMP	0x016C
(0305) 		case 	2:	 
(0306) 		PORTC=	0xBF;
    0167 EB8F      LDI	R24,0xBF
    0168 BB85      OUT	0x15,R24
(0307) 		break;	
    0169 C002      RJMP	0x016C
(0308) 		case 	3:
(0309) 		PORTC=	0xf7;
    016A EF87      LDI	R24,0xF7
    016B BB85      OUT	0x15,R24
(0310) 		break;	
(0311) 		default:  break;
(0312) 		}
(0313) 		}
(0314) 	if(count==3)
    016C 91800094  LDS	R24,count
    016E 3083      CPI	R24,3
    016F F419      BNE	0x0173
(0315) 		{
(0316) 		count=0;
    0170 2422      CLR	R2
    0171 92200094  STS	count,R2
(0317) 		}
    0173 9508      RET
_main:
  RxBuf                --> Y+0
  i                    --> R20
    0174 97A0      SBIW	R28,0x20
(0318) 		
(0319) }
(0320) //******************************************************************************
(0321) main()
(0322) {
(0323)  	char i,RxBuf[32];
(0324)  	DDRB=0xe4;
    0175 EE84      LDI	R24,0xE4
    0176 BB87      OUT	0x17,R24
(0325) 	DDRC=0xff;
    0177 EF8F      LDI	R24,0xFF
    0178 BB84      OUT	0x14,R24
(0326) 	DDRA=0x1e;
    0179 E18E      LDI	R24,0x1E
    017A BB8A      OUT	0x1A,R24
(0327) 	PORTA=0x00;
    017B 2422      CLR	R2
    017C BA2B      OUT	0x1B,R2
(0328) 	PORTC=0xbf;
    017D EB8F      LDI	R24,0xBF
    017E BB85      OUT	0x15,R24
(0329) //******************************************************************************
(0330) 	StartUART();
    017F DFC4      RCALL	_StartUART
(0331)     init_NRF24L01() ;
    0180 DF9C      RCALL	_init_NRF24L01
    0181 C01D      RJMP	0x019F
(0332) 	while(1)
(0333) 	{
(0334) 		SetRX_Mode();
    0182 DF61      RCALL	_SetRX_Mode
(0335)    		if(nRF24L01_RxPacket(RxBuf))   //判断是否收到数据
    0183 018E      MOVW	R16,R28
    0184 DF65      RCALL	_nRF24L01_RxPacket
    0185 2300      TST	R16
    0186 F0C1      BEQ	0x019F
(0336) 		{
(0337) 			count++;
    0187 91800094  LDS	R24,count
    0189 5F8F      SUBI	R24,0xFF
    018A 93800094  STS	count,R24
(0338) 			for(i=0;i<32;i++)        //收到数据后，串口显示
    018C 2744      CLR	R20
    018D C00E      RJMP	0x019C
(0339) 			{
(0340) 				R_S_Byte(RxBuf[i]);
    018E 01CE      MOVW	R24,R28
    018F 2FE4      MOV	R30,R20
    0190 27FF      CLR	R31
    0191 0FE8      ADD	R30,R24
    0192 1FF9      ADC	R31,R25
    0193 8100      LDD	R16,Z+0
    0194 DFBA      RCALL	_R_S_Byte
(0341) 				Delay(3000);
    0195 EB08      LDI	R16,0xB8
    0196 E01B      LDI	R17,0xB
    0197 DECD      RCALL	_Delay
(0342) 				Delay(3000);
    0198 EB08      LDI	R16,0xB8
    0199 E01B      LDI	R17,0xB
    019A DECA      RCALL	_Delay
    019B 9543      INC	R20
    019C 3240      CPI	R20,0x20
    019D F380      BCS	0x018E
(0343) 			}	
(0344) 		display();        
FILE: <library>
    019E DFB2      RCALL	_display
    019F CFE2      RJMP	0x0182
    01A0 96A0      ADIW	R28,0x20
    01A1 9508      RET
pop_gset2:
    01A2 E0E2      LDI	R30,2
    01A3 940C01B4  JMP	pop
pop_gset4:
    01A5 E0E8      LDI	R30,0x8
    01A6 940C01B4  JMP	pop
push_gset5:
    01A8 92FA      ST	R15,-Y
    01A9 92EA      ST	R14,-Y
push_gset4:
    01AA 92DA      ST	R13,-Y
    01AB 92CA      ST	R12,-Y
push_gset3:
    01AC 92BA      ST	R11,-Y
    01AD 92AA      ST	R10,-Y
push_gset2:
    01AE 937A      ST	R23,-Y
    01AF 936A      ST	R22,-Y
push_gset1:
    01B0 935A      ST	R21,-Y
    01B1 934A      ST	R20,-Y
    01B2 9508      RET
pop_gset1:
    01B3 E0E1      LDI	R30,1
pop:
    01B4 9149      LD	R20,Y+
    01B5 9159      LD	R21,Y+
    01B6 FDE0      SBRC	R30,0
    01B7 9508      RET
    01B8 9169      LD	R22,Y+
    01B9 9179      LD	R23,Y+
    01BA FDE1      SBRC	R30,1
    01BB 9508      RET
    01BC 90A9      LD	R10,Y+
    01BD 90B9      LD	R11,Y+
    01BE FDE2      SBRC	R30,2
    01BF 9508      RET
    01C0 90C9      LD	R12,Y+
    01C1 90D9      LD	R13,Y+
    01C2 FDE3      SBRC	R30,3
    01C3 9508      RET
    01C4 90E9      LD	R14,Y+
    01C5 90F9      LD	R15,Y+
    01C6 9508      RET
