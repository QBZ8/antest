(0187) /*函数：uint SPI_Read_Buf(uchar reg, uchar *pBuf, uchar uchars)
(0188) /*功能: 用于读数据，reg：为寄存器地址，pBuf：为待读出数据地址，uchars：读出数据的个数
(0189) /****************************************************************************************************/
(0190) char SPI_Read_Buf(char reg, char *pBuf, char uchars)
(0191) {
(0192) 	int status1,uchar_ctr;
(0193) 	
(0194) 	Low_24L01_CSN;                    		// Set CSN low, init SPI tranaction
    00B3 98C7      CBI	0x18,7
(0195) 	status1 = SPI_RW(reg);       		// Select register to write to and read status uchar
    00B4 2F04      MOV	R16,R20
    00B5 DFC4      RCALL	_SPI_RW
    00B6 2F40      MOV	R20,R16
    00B7 2755      CLR	R21
(0196) 	
(0197) 	for(uchar_ctr=0;uchar_ctr<uchars;uchar_ctr++)
    00B8 2766      CLR	R22
    00B9 2777      CLR	R23
    00BA C008      RJMP	0x00C3
(0198) 		pBuf[uchar_ctr] = SPI_RW(0);    // 
    00BB 2700      CLR	R16
    00BC DFBD      RCALL	_SPI_RW
    00BD 01FB      MOVW	R30,R22
    00BE 0DEC      ADD	R30,R12
    00BF 1DFD      ADC	R31,R13
    00C0 8300      STD	Z+0,R16
    00C1 5F6F      SUBI	R22,0xFF
    00C2 4F7F      SBCI	R23,0xFF
    00C3 2C2A      MOV	R2,R10
    00C4 2433      CLR	R3
    00C5 1562      CP	R22,R2
    00C6 0573      CPC	R23,R3
    00C7 F39C      BLT	0x00BB
(0199) 	
(0200) 	Hign_24L01_CSN;                           
    00C8 9AC7      SBI	0x18,7
(0201) 	
(0202) 	return(status1);                    // return nRF24L01 status uchar
    00C9 2F04      MOV	R16,R20
    00CA 940E01A5  CALL	pop_gset4
    00CC 9508      RET
_SPI_Write_Buf:
  status1              --> R20
  uchar_ctr            --> R22
  uchars               --> R10
  pBuf                 --> R12
  reg                  --> R20
    00CD 940E01AA  CALL	push_gset4
    00CF 0169      MOVW	R12,R18
    00D0 2F40      MOV	R20,R16
    00D1 84A8      LDD	R10,Y+8
(0203) }
(0204) /*********************************************************************************************************
(0205) /*函数：uint SPI_Write_Buf(uchar reg, uchar *pBuf, uchar uchars)
(0206) /*功能: 用于写数据：为寄存器地址，pBuf：为待写入数据地址，uchars：写入数据的个数
(0207) /*********************************************************************************************************/
(0208) char SPI_Write_Buf(char reg, char *pBuf, char uchars)
(0209) {
(0210) 	char status1,uchar_ctr;
(0211) 	
(0212) 	Low_24L01_CSN;             //SPI使能       
    00D2 98C7      CBI	0x18,7
(0213) 	status1 = SPI_RW(reg);   
    00D3 2F04      MOV	R16,R20
    00D4 DFA5      RCALL	_SPI_RW
    00D5 2F40      MOV	R20,R16
(0214) 	for(uchar_ctr=0; uchar_ctr<uchars; uchar_ctr++) //
    00D6 2766      CLR	R22
    00D7 C005      RJMP	0x00DD
(0215) 	SPI_RW(*pBuf++);
    00D8 01F6      MOVW	R30,R12
    00D9 9101      LD	R16,Z+
    00DA 016F      MOVW	R12,R30
    00DB DF9E      RCALL	_SPI_RW
    00DC 9563      INC	R22
    00DD 156A      CP	R22,R10
    00DE F3C8      BCS	0x00D8
(0216) 	Hign_24L01_CSN;           //关闭SPI
    00DF 9AC7      SBI	0x18,7
(0217) 	return(status1);    		  // 
    00E0 2F04      MOV	R16,R20
    00E1 940E01A5  CALL	pop_gset4
    00E3 9508      RET
(0218) }
