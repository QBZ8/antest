(0133) /*函数：uint SPI_RW(uint uchar)
(0134) /*功能：NRF24L01的SPI写时序
(0135) /****************************************************************************************************/
(0136) char SPI_RW(char data)
(0137) {
(0138) 	char i,temp=0;
    007C 2744      CLR	R20
(0139)    	for(i=0;i<8;i++) // output 8-bit
    007D 2766      CLR	R22
    007E C00D      RJMP	0x008C
(0140)    	{
(0141) 	if(data & 0x80)
    007F FF07      SBRS	R16,7
    0080 C002      RJMP	0x0083
(0142) 	{
(0143) 		Hign_24L01_MOSI ;         // output 'uchar', MSB to MOSI
    0081 9AC2      SBI	0x18,2
(0144) 	}
    0082 C001      RJMP	0x0084
(0145) 	else
(0146) 	{
(0147) 	 	Low_24L01_MOSI; 
    0083 98C2      CBI	0x18,2
(0148) 	}	
(0149) 		data = (data << 1);           // shift next bit into MSB..
    0084 0F00      LSL	R16
(0150) 		temp<<=1;
    0085 0F44      LSL	R20
(0151) 		Hign_24L01_SCK ;                      // Set SCK high..
    0086 9AC6      SBI	0x18,6
(0152) 		if(PINB&0x10)temp++;       		  // capture current MISO bit
    0087 9BB4      SBIS	0x16,4
    0088 C001      RJMP	0x008A
    0089 9543      INC	R20
(0153) 		Low_24L01_SCK;            		  // ..then set SCK low again
    008A 98C6      CBI	0x18,6
    008B 9563      INC	R22
    008C 3068      CPI	R22,0x8
    008D F388      BCS	0x007F
(0154)    	}
(0155)     return(temp);           		  // return read uchar
    008E 2F04      MOV	R16,R20
    008F 940E01A2  CALL	pop_gset2
    0091 9508      RET
_SPI_Read:
  reg_val              --> R20
  reg                  --> R20
    0092 940E01B0  CALL	push_gset1
    0094 2F40      MOV	R20,R16
(0156) }
