(0220) /*函数：void SetRX_Mode(void)
(0221) /*功能：数据接收配置 
(0222) /****************************************************************************************************/
(0223) void SetRX_Mode(void)
(0224) {
(0225) 	Low_24L01_CE;
_SetRX_Mode:
      DF 98C5      CBI	0x18,5
(0226) 	SPI_RW_Reg(WRITE_REG + CONFIG, 0x0f);   		// IRQ收发完成中断响应，16位CRC	，主接收
      E0 E02F      LDI	R18,0xF
      E1 E200      LDI	R16,0x20
      E2 DFBB      RCALL	_SPI_RW_Reg
(0227) 	Hign_24L01_CE; 
      E3 9AC5      SBI	0x18,5
(0228) 	Delay(1000);//注意不能太小
      E4 EE08      LDI	R16,0xE8
      E5 E013      LDI	R17,3
      E6 DF7E      RCALL	_Delay
      E7 9508      RET
_nRF24L01_RxPacket:
  revale               --> R20
  rx_buf               --> R10
      E8 940E 0204 CALL	push_xgset300C
      EA 0158      MOVW	R10,R16
      EB 9721      SBIW	R28,1
(0229) }
