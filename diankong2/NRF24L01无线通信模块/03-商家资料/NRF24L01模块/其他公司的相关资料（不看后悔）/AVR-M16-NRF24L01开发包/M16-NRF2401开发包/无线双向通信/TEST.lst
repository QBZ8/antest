(0231) /*函数：unsigned char nRF24L01_RxPacket(unsigned char* rx_buf)
(0232) /*功能：数据读取后放如rx_buf接收缓冲区中
(0233) /******************************************************************************************************/
(0234) char nRF24L01_RxPacket(char* rx_buf)
(0235) {
(0236)     char revale=0;
      EC 2744      CLR	R20
(0237) 	sta=SPI_Read(STATUS);	     // 读取状态寄存其来判断数据接收状况		
      ED E007      LDI	R16,7
      EE DFA2      RCALL	_SPI_Read
      EF 9300 0096 STS	sta,R16
(0238) 	if(sta&0x40)                 // 判断是否接收到数据
      F1 FF06      SBRS	R16,6
      F2 C007      RJMP	0x00FA
(0239) 	{
(0240) 	    Low_24L01_CE; 			//SPI使能
      F3 98C5      CBI	0x18,5
(0241) 		SPI_Read_Buf(RD_RX_PLOAD,rx_buf,TX_PLOAD_WIDTH);// read receive payload from RX_FIFO buffer
      F4 E280      LDI	R24,0x20
      F5 8388      STD	Y+0,R24
      F6 0195      MOVW	R18,R10
      F7 E601      LDI	R16,0x61
      F8 DFB3      RCALL	_SPI_Read_Buf
(0242) 		revale =1;			//读取数据完成标志
      F9 E041      LDI	R20,1
(0243) 	}
(0244) 	SPI_RW_Reg(WRITE_REG+STATUS,sta);   //接收到数据后RX_DR,TX_DS,MAX_PT都置高为1，通过写1来清楚中断标志
      FA 9120 0096 LDS	R18,sta
      FC E207      LDI	R16,0x27
      FD DFA0      RCALL	_SPI_RW_Reg
