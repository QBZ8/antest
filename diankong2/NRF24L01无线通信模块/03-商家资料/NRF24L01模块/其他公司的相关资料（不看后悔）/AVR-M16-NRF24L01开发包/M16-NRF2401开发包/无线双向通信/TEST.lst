(0133) /*函数：uint SPI_RW(uint uchar)
(0134) /*功能：NRF24L01的SPI写时序
(0135) /****************************************************************************************************/
(0136) char SPI_RW(char data)
(0137) {
(0138) 	char i,temp=0;
      7C 24AA      CLR	R10
(0139)    	for(i=0;i<8;i++) // output 8-bit
      7D 2744      CLR	R20
      7E C00D      RJMP	0x008C
(0140)    	{
(0141) 	if(data & 0x80)
      7F FF07      SBRS	R16,7
      80 C002      RJMP	0x0083
(0142) 	{
(0143) 		Hign_24L01_MOSI ;         // output 'uchar', MSB to MOSI
      81 9AC2      SBI	0x18,2
(0144) 	}
      82 C001      RJMP	0x0084
(0145) 	else
(0146) 	{
(0147) 	 	Low_24L01_MOSI; 
      83 98C2      CBI	0x18,2
(0148) 	}	
(0149) 		data = (data << 1);           // shift next bit into MSB..
      84 0F00      LSL	R16
(0150) 		temp<<=1;
      85 0CAA      LSL	R10
(0151) 		Hign_24L01_SCK ;                      // Set SCK high..
      86 9AC6      SBI	0x18,6
(0152) 		if(PINB&0x10)temp++;       		  // capture current MISO bit
      87 9BB4      SBIS	0x16,4
      88 C001      RJMP	0x008A
      89 94A3      INC	R10
(0153) 		Low_24L01_SCK;            		  // ..then set SCK low again
      8A 98C6      CBI	0x18,6
      8B 9543      INC	R20
      8C 3048      CPI	R20,0x8
      8D F388      BCS	0x007F
(0154)    	}
(0155)     return(temp);           		  // return read uchar
      8E 2D0A      MOV	R16,R10
      8F 940C 0209 JMP	pop_xgset300C
_SPI_Read:
  reg_val              --> R10
  reg                  --> R10
      91 92AA      ST	R10,-Y
      92 92BA      ST	R11,-Y
      93 2EA0      MOV	R10,R16
(0156) }
(0157) /****************************************************************************************************
(0158) /*函数：uchar SPI_Read(uchar reg)
(0159) /*功能：NRF24L01的SPI时序
(0160) /****************************************************************************************************/
(0161) char SPI_Read(char reg)
(0162) {
(0163) 	char reg_val;
(0164) 	
(0165) 	Low_24L01_CSN;                // CSN low, initialize SPI communication...
      94 98C7      CBI	0x18,7
(0166) 	SPI_RW(reg);            // Select register to read from..
      95 2D0A      MOV	R16,R10
      96 DFE3      RCALL	_SPI_RW
(0167) 	reg_val = SPI_RW(0);    // ..then read registervalue
      97 2700      CLR	R16
      98 DFE1      RCALL	_SPI_RW
      99 2EA0      MOV	R10,R16
(0168) 	Hign_24L01_CSN;                // CSN high, terminate SPI communication
      9A 9AC7      SBI	0x18,7
(0169) 	
(0170) 	return(reg_val);        // return register value
      9B 90B9      LD	R11,Y+
      9C 90A9      LD	R10,Y+
      9D 9508      RET
_SPI_RW_Reg:
  status               --> R10
  value                --> R12
  reg                  --> R10
      9E 940E 01FF CALL	push_xgset003C
      A0 2EC2      MOV	R12,R18
      A1 2EA0      MOV	R10,R16
(0171) }
(0172) /****************************************************************************************************/
(0173) /*功能：NRF24L01读写寄存器函数
(0174) /****************************************************************************************************/
(0175) char SPI_RW_Reg(char reg, char value)
(0176) {
(0177) 	char status;
(0178) 	
(0179) 	Low_24L01_CSN;                   // CSN low, init SPI transaction
      A2 98C7      CBI	0x18,7
(0180) 	status = SPI_RW(reg);      // select register
      A3 2D0A      MOV	R16,R10
      A4 DFD5      RCALL	_SPI_RW
      A5 2EA0      MOV	R10,R16
(0181) 	SPI_RW(value);             // ..and write value to it..
      A6 2D0C      MOV	R16,R12
      A7 DFD2      RCALL	_SPI_RW
(0182) 	Hign_24L01_CSN;                   // CSN high again
      A8 9AC7      SBI	0x18,7
(0183) 	
(0184) 	return(status);            // return nRF24L01 status uchar
      A9 2D0A      MOV	R16,R10
      AA 940C 01ED JMP	pop_xgset003C
_SPI_Read_Buf:
  status1              --> R10
  uchar_ctr            --> R20
  uchars               --> Y,+6
  pBuf                 --> R12
  reg                  --> R10
      AC 940E 020E CALL	push_xgset303C
      AE 0169      MOVW	R12,R18
      AF 2EA0      MOV	R10,R16
(0185) }
