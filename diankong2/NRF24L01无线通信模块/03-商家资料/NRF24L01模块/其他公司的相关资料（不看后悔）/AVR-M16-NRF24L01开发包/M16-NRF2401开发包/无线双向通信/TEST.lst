(0247) /***********************************************************************************************************
(0248) /*函数：void nRF24L01_TxPacket(char * tx_buf)
(0249) /*功能：发送 tx_buf中数据
(0250) /**********************************************************************************************************/
(0251) void nRF24L01_TxPacket(char * tx_buf)
(0252) {
(0253) 	Low_24L01_CE;			//StandBy I模式	
     106 98C5      CBI	0x18,5
(0254) 	SPI_Write_Buf(WRITE_REG + RX_ADDR_P0, TX_ADDRESS, TX_ADR_WIDTH); // 装载接收端地址
     107 E085      LDI	R24,5
     108 8388      STD	Y+0,R24
     109 E82A      LDI	R18,0x8A
     10A E030      LDI	R19,0
     10B E20A      LDI	R16,0x2A
     10C DFBC      RCALL	_SPI_Write_Buf
(0255) 	SPI_Write_Buf(WR_TX_PLOAD, tx_buf, TX_PLOAD_WIDTH); 			 // 装载数据	
     10D E280      LDI	R24,0x20
     10E 8388      STD	Y+0,R24
     10F 0195      MOVW	R18,R10
     110 EA00      LDI	R16,0xA0
     111 DFB7      RCALL	_SPI_Write_Buf
(0256) 	SPI_RW_Reg(WRITE_REG + CONFIG, 0x0e);   		 // IRQ收发完成中断响应，16位CRC，主发送
     112 E02E      LDI	R18,0xE
     113 E200      LDI	R16,0x20
     114 DF89      RCALL	_SPI_RW_Reg
(0257) 	Hign_24L01_CE;		 //置高CE，激发数据发送
     115 9AC5      SBI	0x18,5
(0258) 	Delay(600);
     116 E508      LDI	R16,0x58
     117 E012      LDI	R17,2
     118 DF4C      RCALL	_Delay
     119 9621      ADIW	R28,1
     11A 90B9      LD	R11,Y+
     11B 90A9      LD	R10,Y+
     11C 9508      RET
_init_NRF24L01:
     11D 9721      SBIW	R28,1
(0259) }
(0260) //****************************************************************************************
(0261) /*NRF24L01初始化
(0262) //***************************************************************************************/
(0263) void init_NRF24L01(void)
(0264) {
(0265) 
(0266)  	Low_24L01_CE;    // chip enable
     11E 98C5      CBI	0x18,5
(0267)  	Hign_24L01_CSN;   // Spi disable 
     11F 9AC7      SBI	0x18,7
(0268)  	Low_24L01_SCK;   // Spi clock line init high
     120 98C6      CBI	0x18,6
(0269) 	SPI_Write_Buf(WRITE_REG + TX_ADDR, TX_ADDRESS, TX_ADR_WIDTH);    // 写本地地址	
     121 E085      LDI	R24,5
     122 8388      STD	Y+0,R24
     123 E82A      LDI	R18,0x8A
     124 E030      LDI	R19,0
     125 E300      LDI	R16,0x30
     126 DFA2      RCALL	_SPI_Write_Buf
(0270) 	SPI_Write_Buf(WRITE_REG + RX_ADDR_P0, RX_ADDRESS, RX_ADR_WIDTH); // 写接收端地址
     127 E085      LDI	R24,5
     128 8388      STD	Y+0,R24
     129 E82F      LDI	R18,0x8F
     12A E030      LDI	R19,0
     12B E20A      LDI	R16,0x2A
     12C DF9C      RCALL	_SPI_Write_Buf
(0271) 	SPI_RW_Reg(WRITE_REG + EN_AA, 0x01);      //  频道0自动	ACK应答允许	
     12D E021      LDI	R18,1
     12E E201      LDI	R16,0x21
     12F DF6E      RCALL	_SPI_RW_Reg
(0272) 	SPI_RW_Reg(WRITE_REG + EN_RXADDR, 0x01);  //  允许接收地址只有频道0，如果需要多频道可以参考Page21  
     130 E021      LDI	R18,1
     131 E202      LDI	R16,0x22
     132 DF6B      RCALL	_SPI_RW_Reg
(0273) 	SPI_RW_Reg(WRITE_REG + RF_CH, 0);        //   设置信道工作为2.4GHZ，收发必须一致
     133 2722      CLR	R18
     134 E205      LDI	R16,0x25
     135 DF68      RCALL	_SPI_RW_Reg
(0274) 	SPI_RW_Reg(WRITE_REG + RX_PW_P0, RX_PLOAD_WIDTH); //设置接收数据长度，本次设置为32字节
     136 E220      LDI	R18,0x20
     137 E301      LDI	R16,0x31
     138 DF65      RCALL	_SPI_RW_Reg
(0275) 	SPI_RW_Reg(WRITE_REG + RF_SETUP, 0x07);   		//设置发射速率为1MHZ，发射功率为最大值0dB
     139 E027      LDI	R18,7
     13A E206      LDI	R16,0x26
     13B DF62      RCALL	_SPI_RW_Reg
(0276) 	SPI_RW_Reg(WRITE_REG + CONFIG, 0x0f);   		// IRQ收发完成中断响应，16位CRC	，主接收}
     13C E02F      LDI	R18,0xF
     13D E200      LDI	R16,0x20
     13E DF5F      RCALL	_SPI_RW_Reg
(0277)     Delay(6000);
     13F E700      LDI	R16,0x70
     140 E117      LDI	R17,0x17
     141 DF23      RCALL	_Delay
     142 9621      ADIW	R28,1
     143 9508      RET
(0278) }
