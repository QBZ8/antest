(0280) void StartUART(void)
(0281) {
(0282)  	 UCSRA=0x00;	
_StartUART:
     144 2422      CLR	R2
     145 B82B      OUT	0x0B,R2
(0283) 	 UCSRB=0x18;	
     146 E188      LDI	R24,0x18
     147 B98A      OUT	0x0A,R24
(0284) 	 UCSRC=0x06;	
     148 E086      LDI	R24,6
     149 BD80      OUT	0x20,R24
(0285) 	 UBRRL=0x67;
     14A E687      LDI	R24,0x67
     14B B989      OUT	0x09,R24
(0286) 	 UBRRH=0x00;
     14C BC20      OUT	0x20,R2
(0287) 	 UCSRA=UCSRA|0x08;	
     14D 9A5B      SBI	0x0B,3
     14E 9508      RET
(0288) }
