(0187) /*函数：uint SPI_Read_Buf(uchar reg, uchar *pBuf, uchar uchars)
(0188) /*功能: 用于读数据，reg：为寄存器地址，pBuf：为待读出数据地址，uchars：读出数据的个数
(0189) /****************************************************************************************************/
(0190) char SPI_Read_Buf(char reg, char *pBuf, char uchars)
(0191) {
(0192) 	int status1,uchar_ctr;
(0193) 	
(0194) 	Low_24L01_CSN;                    		// Set CSN low, init SPI tranaction
      B0 98C7      CBI	0x18,7
(0195) 	status1 = SPI_RW(reg);       		// Select register to write to and read status uchar
      B1 2D0A      MOV	R16,R10
      B2 DFC7      RCALL	_SPI_RW
      B3 2EA0      MOV	R10,R16
      B4 24BB      CLR	R11
(0196) 	
(0197) 	for(uchar_ctr=0;uchar_ctr<uchars;uchar_ctr++)
      B5 2744      CLR	R20
      B6 2755      CLR	R21
      B7 C008      RJMP	0x00C0
(0198) 		pBuf[uchar_ctr] = SPI_RW(0);    // 
      B8 2700      CLR	R16
      B9 DFC0      RCALL	_SPI_RW
      BA 01FA      MOVW	R30,R20
      BB 0DEC      ADD	R30,R12
      BC 1DFD      ADC	R31,R13
      BD 8300      STD	Z+0,R16
      BE 5F4F      SUBI	R20,0xFF
      BF 4F5F      SBCI	R21,0xFF
      C0 802E      LDD	R2,Y+6
      C1 2433      CLR	R3
      C2 1542      CP	R20,R2
      C3 0553      CPC	R21,R3
      C4 F39C      BLT	0x00B8
(0199) 	
(0200) 	Hign_24L01_CSN;                           
      C5 9AC7      SBI	0x18,7
(0201) 	
(0202) 	return(status1);                    // return nRF24L01 status uchar
      C6 2D0A      MOV	R16,R10
      C7 940C 0215 JMP	pop_xgset303C
_SPI_Write_Buf:
  status1              --> R10
  uchar_ctr            --> R12
  uchars               --> Y,+6
  pBuf                 --> R14
  reg                  --> R10
      C9 940E 01FD CALL	push_xgset00FC
      CB 0179      MOVW	R14,R18
      CC 2EA0      MOV	R10,R16
(0203) }
(0204) /*********************************************************************************************************
(0205) /*函数：uint SPI_Write_Buf(uchar reg, uchar *pBuf, uchar uchars)
(0206) /*功能: 用于写数据：为寄存器地址，pBuf：为待写入数据地址，uchars：写入数据的个数
(0207) /*********************************************************************************************************/
(0208) char SPI_Write_Buf(char reg, char *pBuf, char uchars)
(0209) {
(0210) 	char status1,uchar_ctr;
(0211) 	
(0212) 	Low_24L01_CSN;             //SPI使能       
      CD 98C7      CBI	0x18,7
(0213) 	status1 = SPI_RW(reg);   
      CE 2D0A      MOV	R16,R10
      CF DFAA      RCALL	_SPI_RW
      D0 2EA0      MOV	R10,R16
(0214) 	for(uchar_ctr=0; uchar_ctr<uchars; uchar_ctr++) //
      D1 24CC      CLR	R12
      D2 C005      RJMP	0x00D8
(0215) 	SPI_RW(*pBuf++);
      D3 01F7      MOVW	R30,R14
      D4 9101      LD	R16,Z+
      D5 017F      MOVW	R14,R30
      D6 DFA3      RCALL	_SPI_RW
      D7 94C3      INC	R12
      D8 800E      LDD	R0,Y+6
      D9 14C0      CP	R12,R0
      DA F3C0      BCS	0x00D3
(0216) 	Hign_24L01_CSN;           //关闭SPI
      DB 9AC7      SBI	0x18,7
(0217) 	return(status1);    		  // 
      DC 2D0A      MOV	R16,R10
      DD 940C 01F2 JMP	pop_xgset00FC
(0218) }
