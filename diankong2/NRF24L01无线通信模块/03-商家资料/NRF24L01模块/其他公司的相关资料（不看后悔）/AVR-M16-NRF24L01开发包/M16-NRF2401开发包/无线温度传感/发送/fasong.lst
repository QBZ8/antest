(0201) /*函数：uint SPI_Read_Buf(uchar reg, uchar *pBuf, uchar uchars)
(0202) /*功能: 用于读数据，reg：为寄存器地址，pBuf：为待读出数据地址，uchars：读出数据的个数
(0203) /****************************************************************************************************/
(0204) char SPI_Read_Buf(char reg, char *pBuf, char uchars)
(0205) {
(0206) 	int status,uchar_ctr;
(0207) 	
(0208) 	Low_24L01_CSN;                    		// Set CSN low, init SPI tranaction
    00B9 98C7      CBI	0x18,7
(0209) 	status = SPI_RW(reg);       		// Select register to write to and read status uchar
    00BA 2F04      MOV	R16,R20
    00BB DFC4      RCALL	_SPI_RW
    00BC 2F40      MOV	R20,R16
    00BD 2755      CLR	R21
(0210) 	
(0211) 	for(uchar_ctr=0;uchar_ctr<uchars;uchar_ctr++)
    00BE 2766      CLR	R22
    00BF 2777      CLR	R23
    00C0 C008      RJMP	0x00C9
(0212) 		pBuf[uchar_ctr] = SPI_RW(0);    // 
    00C1 2700      CLR	R16
    00C2 DFBD      RCALL	_SPI_RW
    00C3 01FB      MOVW	R30,R22
    00C4 0DEC      ADD	R30,R12
    00C5 1DFD      ADC	R31,R13
    00C6 8300      STD	Z+0,R16
    00C7 5F6F      SUBI	R22,0xFF
    00C8 4F7F      SBCI	R23,0xFF
    00C9 2C2A      MOV	R2,R10
    00CA 2433      CLR	R3
    00CB 1562      CP	R22,R2
    00CC 0573      CPC	R23,R3
    00CD F39C      BLT	0x00C1
(0213) 	
(0214) 	Hign_24L01_CSN;                           
    00CE 9AC7      SBI	0x18,7
(0215) 	
(0216) 	return(status);                    // return nRF24L01 status uchar
    00CF 2F04      MOV	R16,R20
    00D0 940E02D2  CALL	pop_gset4
    00D2 9508      RET
_SPI_Write_Buf:
  status               --> R20
  uchar_ctr            --> R22
  uchars               --> R10
  pBuf                 --> R12
  reg                  --> R20
    00D3 940E02D7  CALL	push_gset4
    00D5 0169      MOVW	R12,R18
    00D6 2F40      MOV	R20,R16
    00D7 84A8      LDD	R10,Y+8
(0217) }
(0218) /*********************************************************************************************************
(0219) /*函数：uint SPI_Write_Buf(uchar reg, uchar *pBuf, uchar uchars)
(0220) /*功能: 用于写数据：为寄存器地址，pBuf：为待写入数据地址，uchars：写入数据的个数
(0221) /*********************************************************************************************************/
(0222) char SPI_Write_Buf(char reg, char *pBuf, char uchars)
(0223) {
(0224) 	char status,uchar_ctr;
(0225) 	
(0226) 	Low_24L01_CSN;             //SPI使能       
    00D8 98C7      CBI	0x18,7
(0227) 	status = SPI_RW(reg);   
    00D9 2F04      MOV	R16,R20
    00DA DFA5      RCALL	_SPI_RW
    00DB 2F40      MOV	R20,R16
(0228) 	for(uchar_ctr=0; uchar_ctr<uchars; uchar_ctr++) //
    00DC 2766      CLR	R22
    00DD C005      RJMP	0x00E3
(0229) 	SPI_RW(*pBuf++);
    00DE 01F6      MOVW	R30,R12
    00DF 9101      LD	R16,Z+
    00E0 016F      MOVW	R12,R30
    00E1 DF9E      RCALL	_SPI_RW
    00E2 9563      INC	R22
    00E3 156A      CP	R22,R10
    00E4 F3C8      BCS	0x00DE
(0230) 	Hign_24L01_CSN;           //关闭SPI
    00E5 9AC7      SBI	0x18,7
(0231) 	return(status);    		  // 
    00E6 2F04      MOV	R16,R20
    00E7 940E02D2  CALL	pop_gset4
    00E9 9508      RET
(0232) }
(0233) /****************************************************************************************************/
(0234) /*函数：void SetRX_Mode(void)
(0235) /*功能：数据接收配置 
(0236) /****************************************************************************************************/
(0237) void SetRX_Mode(void)
(0238) {
(0239) 	Low_24L01_CE;
_SetRX_Mode:
    00EA 98C5      CBI	0x18,5
(0240) 	SPI_RW_Reg(WRITE_REG + CONFIG, 0x0f);   		// IRQ收发完成中断响应，16位CRC	，主接收
    00EB E02F      LDI	R18,0xF
    00EC E200      LDI	R16,0x20
    00ED DFB7      RCALL	_SPI_RW_Reg
(0241) 	Hign_24L01_CE; 
    00EE 9AC5      SBI	0x18,5
(0242) 	Delay(1000);
    00EF EE08      LDI	R16,0xE8
    00F0 E013      LDI	R17,3
    00F1 DF79      RCALL	_Delay
    00F2 9508      RET
_nRF24L01_RxPacket:
  revale               --> R20
  rx_buf               --> R22
    00F3 940E02DB  CALL	push_gset2
    00F5 01B8      MOVW	R22,R16
    00F6 9721      SBIW	R28,1
(0243) }
(0244) /******************************************************************************************************/
(0245) /*函数：unsigned char nRF24L01_RxPacket(unsigned char* rx_buf)
(0246) /*功能：数据读取后放如rx_buf接收缓冲区中
(0247) /******************************************************************************************************/
(0248) char nRF24L01_RxPacket(char* rx_buf)
(0249) {
(0250)     char revale=0;
    00F7 2744      CLR	R20
(0251) 	sta=SPI_Read(STATUS);	// 读取状态寄存其来判断数据接收状况
    00F8 E007      LDI	R16,7
    00F9 DF9E      RCALL	_SPI_Read
    00FA 93000080  STS	sta,R16
(0252) 	if(sta&0x40)				// 判断是否接收到数据
    00FC FF06      SBRS	R16,6
    00FD C007      RJMP	0x0105
(0253) 	{
(0254) 	    Low_24L01_CE; 			//SPI使能
    00FE 98C5      CBI	0x18,5
(0255) 		SPI_Read_Buf(RD_RX_PLOAD,rx_buf,TX_PLOAD_WIDTH);// read receive payload from RX_FIFO buffer
    00FF E280      LDI	R24,0x20
    0100 8388      STD	Y+0,R24
    0101 019B      MOVW	R18,R22
    0102 E601      LDI	R16,0x61
    0103 DFB0      RCALL	_SPI_Read_Buf
(0256) 		revale =1;			//读取数据完成标志
    0104 E041      LDI	R20,1
(0257) 	}
(0258) 	SPI_RW_Reg(WRITE_REG+STATUS,sta);   //接收到数据后RX_DR,TX_DS,MAX_PT都置高为1，通过写1来清楚中断标志
    0105 91200080  LDS	R18,sta
    0107 E207      LDI	R16,0x27
    0108 DF9C      RCALL	_SPI_RW_Reg
(0259) 	return revale;
    0109 2F04      MOV	R16,R20
    010A 9621      ADIW	R28,1
    010B 940E02CF  CALL	pop_gset2
    010D 9508      RET
_nRF24L01_TxPacket:
  tx_buf               --> R20
    010E 940E02DD  CALL	push_gset1
    0110 01A8      MOVW	R20,R16
    0111 9721      SBIW	R28,1
(0260) }
(0261) /***********************************************************************************************************
(0262) /*函数：void nRF24L01_TxPacket(char * tx_buf)
(0263) /*功能：发送 tx_buf中数据
(0264) /**********************************************************************************************************/
(0265) void nRF24L01_TxPacket(char * tx_buf)
(0266) {
(0267) 	Low_24L01_CE;			//StandBy I模式	
    0112 98C5      CBI	0x18,5
(0268) 	SPI_Write_Buf(WRITE_REG + RX_ADDR_P0, TX_ADDRESS, TX_ADR_WIDTH); // 装载接收端地址
    0113 E085      LDI	R24,5
    0114 8388      STD	Y+0,R24
    0115 E726      LDI	R18,0x76
    0116 E030      LDI	R19,0
    0117 E20A      LDI	R16,0x2A
    0118 DFBA      RCALL	_SPI_Write_Buf
(0269) 	SPI_Write_Buf(WR_TX_PLOAD, tx_buf, TX_PLOAD_WIDTH); 			 // 装载数据	
    0119 E280      LDI	R24,0x20
    011A 8388      STD	Y+0,R24
    011B 019A      MOVW	R18,R20
    011C EA00      LDI	R16,0xA0
    011D DFB5      RCALL	_SPI_Write_Buf
(0270) //	SPI_RW_Reg(WRITE_REG + CONFIG, 0x0e);   		 // IRQ收发完成中断响应，16位CRC，主发送
(0271) 	Hign_24L01_CE;		 //置高CE，激发数据发送
    011E 9AC5      SBI	0x18,5
(0272) 	Delay(1000);
    011F EE08      LDI	R16,0xE8
    0120 E013      LDI	R17,3
    0121 DF49      RCALL	_Delay
    0122 9621      ADIW	R28,1
    0123 940E02E0  CALL	pop_gset1
    0125 9508      RET
_init_NRF24L01:
    0126 9721      SBIW	R28,1
(0273) }
(0274) //****************************************************************************************
(0275) /*NRF24L01初始化
(0276) //***************************************************************************************/
(0277) void init_NRF24L01(void)
(0278) {
(0279) 
(0280)  	Low_24L01_CE;    // chip enable
    0127 98C5      CBI	0x18,5
(0281)  	Hign_24L01_CSN;   // Spi disable 
    0128 9AC7      SBI	0x18,7
(0282)  	Low_24L01_SCK;   // Spi clock line init high
    0129 98C6      CBI	0x18,6
(0283) 	SPI_Write_Buf(WRITE_REG + TX_ADDR, TX_ADDRESS, TX_ADR_WIDTH);    // 写本地地址	
    012A E085      LDI	R24,5
    012B 8388      STD	Y+0,R24
    012C E726      LDI	R18,0x76
    012D E030      LDI	R19,0
    012E E300      LDI	R16,0x30
    012F DFA3      RCALL	_SPI_Write_Buf
(0284) 	SPI_Write_Buf(WRITE_REG + RX_ADDR_P0, RX_ADDRESS, RX_ADR_WIDTH); // 写接收端地址
    0130 E085      LDI	R24,5
    0131 8388      STD	Y+0,R24
    0132 E72B      LDI	R18,0x7B
    0133 E030      LDI	R19,0
    0134 E20A      LDI	R16,0x2A
    0135 DF9D      RCALL	_SPI_Write_Buf
(0285) 	SPI_RW_Reg(WRITE_REG + EN_AA, 0x01);      //  频道0自动	ACK应答允许	
    0136 E021      LDI	R18,1
    0137 E201      LDI	R16,0x21
    0138 DF6C      RCALL	_SPI_RW_Reg
(0286) 	SPI_RW_Reg(WRITE_REG + EN_RXADDR, 0x01);  //  允许接收地址只有频道0，如果需要多频道可以参考Page21  
    0139 E021      LDI	R18,1
    013A E202      LDI	R16,0x22
    013B DF69      RCALL	_SPI_RW_Reg
(0287) 	SPI_RW_Reg(WRITE_REG + RF_CH, 0);        //   设置信道工作为2.4GHZ，收发必须一致
    013C 2722      CLR	R18
    013D E205      LDI	R16,0x25
    013E DF66      RCALL	_SPI_RW_Reg
(0288) 	SPI_RW_Reg(WRITE_REG + RX_PW_P0, RX_PLOAD_WIDTH); //设置接收数据长度，本次设置为32字节
    013F E220      LDI	R18,0x20
    0140 E301      LDI	R16,0x31
    0141 DF63      RCALL	_SPI_RW_Reg
(0289) 	SPI_RW_Reg(WRITE_REG + RF_SETUP, 0x07);   		//设置发射速率为1MHZ，发射功率为最大值0dB	
    0142 E027      LDI	R18,7
    0143 E206      LDI	R16,0x26
    0144 DF60      RCALL	_SPI_RW_Reg
(0290) 	SPI_RW_Reg(WRITE_REG + CONFIG, 0x0e);   		 // IRQ收发完成中断响应，16位CRC，主发送
    0145 E02E      LDI	R18,0xE
    0146 E200      LDI	R16,0x20
    0147 DF5D      RCALL	_SPI_RW_Reg
(0291) 	Delay(6000);
    0148 E700      LDI	R16,0x70
    0149 E117      LDI	R17,0x17
    014A DF20      RCALL	_Delay
    014B 9621      ADIW	R28,1
    014C 9508      RET
(0292) }
(0293) //******************************************************************************
(0294) //**********************************DS18B20温度采集*****************************
(0295) //******************************************************************************
(0296) 
(0297) //----------------------------------延时函数------------------------------------
(0298) void DS1820_delay(int i)
(0299) {
(0300) 	while(i--);
_DS1820_delay:
  i                    --> R16
    014D 0118      MOVW	R2,R16
    014E 5001      SUBI	R16,1
    014F 4010      SBCI	R17,0
    0150 2022      TST	R2
    0151 F7D9      BNE	0x014D
    0152 2033      TST	R3
    0153 F7C9      BNE	0x014D
    0154 9508      RET
_Init_DS18B20:
  x                    --> R20
    0155 940E02DD  CALL	push_gset1
(0301) }
(0302) //---------------------------------DS18B20初始化--------------------------------
(0303) void Init_DS18B20(void)
(0304) {
(0305)     unsigned char x=1;
    0157 E041      LDI	R20,1
(0306) 	
(0307) 	Out_DQ;                //配置输出
    0158 9A8E      SBI	0x11,6
(0308) 	Hign_DQ;              //置高电平
    0159 9A96      SBI	0x12,6
(0309) 	Low_DQ;			     //置低电平
    015A 9896      CBI	0x12,6
(0310) 	DS1820_delay(3000);	    //400-960us
    015B EB08      LDI	R16,0xB8
    015C E01B      LDI	R17,0xB
    015D DFEF      RCALL	_DS1820_delay
(0311) 	Hign_DQ;		   //置高电平
    015E 9A96      SBI	0x12,6
(0312) 	In_DQ ;
    015F 988E      CBI	0x11,6
(0313) 	DS1820_delay(40);		  //15-60us
    0160 E208      LDI	R16,0x28
    0161 E010      LDI	R17,0
    0162 DFEA      RCALL	_DS1820_delay
(0314) 	while(Read_DQ)	 ; 
    0163 9986      SBIC	0x10,6
    0164 CFFE      RJMP	0x0163
(0315) 	Out_DQ ;
    0165 9A8E      SBI	0x11,6
(0316) 	Hign_DQ;
    0166 9A96      SBI	0x12,6
(0317) 	DS1820_delay(300);	
    0167 E20C      LDI	R16,0x2C
    0168 E011      LDI	R17,1
    0169 DFE3      RCALL	_DS1820_delay
    016A 940E02E0  CALL	pop_gset1
    016C 9508      RET
_ReadOneChar:
  dat                  --> R20
  i                    --> R22
    016D 940E02DB  CALL	push_gset2
(0318) }
(0319) //---------------------------------DS18B20读函数--------------------------------
(0320) char ReadOneChar(void)
(0321) {
(0322)     char i;
(0323) 	char dat = 0;
    016F 2744      CLR	R20
(0324) 	
(0325) 	for(i=8;i>0;i--)
    0170 E068      LDI	R22,0x8
    0171 C00D      RJMP	0x017F
(0326) 	{
(0327) 	    Out_DQ;    //配置输出
    0172 9A8E      SBI	0x11,6
(0328) 	    Low_DQ;   //置低电平
    0173 9896      CBI	0x12,6
(0329) 		dat >>= 1;
    0174 9546      LSR	R20
(0330) 		Hign_DQ; //置高电平
    0175 9A96      SBI	0x12,6
(0331) 		In_DQ;  //设置输入
    0176 988E      CBI	0x11,6
(0332) 		if(Read_DQ)//读取电平
    0177 9B86      SBIS	0x10,6
    0178 C001      RJMP	0x017A
(0333)         {
(0334) 		dat |= 0x80;
    0179 6840      ORI	R20,0x80
(0335)         }
(0336) 		Out_DQ;//配置输出
    017A 9A8E      SBI	0x11,6
(0337)         DS1820_delay(50);
    017B E302      LDI	R16,0x32
    017C E010      LDI	R17,0
    017D DFCF      RCALL	_DS1820_delay
    017E 956A      DEC	R22
    017F E080      LDI	R24,0
    0180 1786      CP	R24,R22
    0181 F380      BCS	0x0172
(0338) 	}
(0339) 	return(dat);
    0182 2F04      MOV	R16,R20
    0183 940E02CF  CALL	pop_gset2
    0185 9508      RET
_WriteOneChar:
  i                    --> R20
  dat                  --> R22
    0186 940E02DB  CALL	push_gset2
    0188 2F60      MOV	R22,R16
(0340) }
(0341) //------------------------------DS18B20写函数-----------------------------------
(0342) void WriteOneChar(char dat)
(0343) {
(0344)     char i;
(0345) 	Out_DQ;//配置输出
    0189 9A8E      SBI	0x11,6
(0346) 	for(i=8;i>0;i--)
    018A E048      LDI	R20,0x8
    018B C00C      RJMP	0x0198
(0347) 	{
(0348) 	    Low_DQ;//置低电平
    018C 9896      CBI	0x12,6
(0349) 		if(dat&0x01)//写电平
    018D FF60      SBRS	R22,0
    018E C002      RJMP	0x0191
(0350)         {
(0351)         Hign_DQ;//置高电平
    018F 9A96      SBI	0x12,6
(0352)         }
    0190 C001      RJMP	0x0192
(0353)         else
(0354)         {
(0355)          Low_DQ;//置低电平
    0191 9896      CBI	0x12,6
(0356)         }
(0357) 		DS1820_delay(40);
    0192 E208      LDI	R16,0x28
    0193 E010      LDI	R17,0
    0194 DFB8      RCALL	_DS1820_delay
(0358) 		Hign_DQ;//置高电平
    0195 9A96      SBI	0x12,6
(0359) 		dat >>= 1;
    0196 9566      LSR	R22
    0197 954A      DEC	R20
    0198 E080      LDI	R24,0
    0199 1784      CP	R24,R20
    019A F388      BCS	0x018C
(0360) 	}
(0361) 	DS1820_delay(8);
    019B E008      LDI	R16,0x8
    019C E010      LDI	R17,0
    019D DFAF      RCALL	_DS1820_delay
    019E 940E02CF  CALL	pop_gset2
    01A0 9508      RET
(0362) }
(0363) //------------------------------------读取温度------------------------------------
(0364) void ReadTemperature(void)
(0365) {		
(0366) 	Init_DS18B20();
_ReadTemperature:
    01A1 DFB3      RCALL	_Init_DS18B20
(0367) 	WriteOneChar(0xCC); 			// 跳过读序号列号的操作
    01A2 EC0C      LDI	R16,0xCC
    01A3 DFE2      RCALL	_WriteOneChar
(0368) 	WriteOneChar(0x44); 			// 启动温度转换
    01A4 E404      LDI	R16,0x44
    01A5 DFE0      RCALL	_WriteOneChar
(0369) 	
(0370) 	
(0371) 	Init_DS18B20();
    01A6 DFAE      RCALL	_Init_DS18B20
(0372) 	WriteOneChar(0xCC); 			//跳过读序号列号的操作
    01A7 EC0C      LDI	R16,0xCC
    01A8 DFDD      RCALL	_WriteOneChar
(0373) 	WriteOneChar(0xBE); 			//读取温度寄存器等（共可读9个寄存器） 前两个就是温度
    01A9 EB0E      LDI	R16,0xBE
    01AA DFDB      RCALL	_WriteOneChar
(0374) 
(0375) 	temp_data[0]= ReadOneChar();   		//读取温度值低位LSB
    01AB DFC1      RCALL	_ReadOneChar
    01AC 93000060  STS	temp_data,R16
(0376) 	temp_data[1]= ReadOneChar();   //读取温度值高位MSB
    01AE DFBE      RCALL	_ReadOneChar
    01AF 93000061  STS	temp_data+1,R16
    01B1 9508      RET
_work_temp:
  n                    --> R20
    01B2 940E02DB  CALL	push_gset2
(0377) 	
(0378) }
(0379) //-----------------------------------BCD码温度处理------------------------------
(0380) //dispaly[0]十位
(0381) //dispaly[1]个位
(0382) //dispaly[2]小数位
(0383) //dispaly[3]临界标志位
(0384) //------------------------------------------------------------------------------
(0385) void work_temp()
(0386) {
(0387) 	char n=0;
    01B4 2744      CLR	R20
(0388) 	if(temp_data[1]>127)
    01B5 E78F      LDI	R24,0x7F
    01B6 90200061  LDS	R2,temp_data+1
    01B8 1582      CP	R24,R2
    01B9 F488      BCC	0x01CB
(0389) 	{
(0390) 	temp_data[1]=(256-temp_data[1]);
    01BA 2433      CLR	R3
    01BB E080      LDI	R24,0
    01BC E091      LDI	R25,1
    01BD 1982      SUB	R24,R2
    01BE 0993      SBC	R25,R3
    01BF 93800061  STS	temp_data+1,R24
(0391) 	temp_data[0]=(256-temp_data[0]);
    01C1 90200060  LDS	R2,temp_data
    01C3 2433      CLR	R3
    01C4 E080      LDI	R24,0
    01C5 E091      LDI	R25,1
    01C6 1982      SUB	R24,R2
    01C7 0993      SBC	R25,R3
    01C8 93800060  STS	temp_data,R24
(0392) 	n=1;
    01CA E041      LDI	R20,1
(0393) 	}
(0394) //------------------------------------------------------------------------------
(0395) 	dispaly[6]=((temp_data[0]&0xf0)>>4)|((temp_data[1]&0x0f)<<4);
    01CB 91800061  LDS	R24,temp_data+1
    01CD 708F      ANDI	R24,0xF
    01CE 708F      ANDI	R24,0xF
    01CF 9582      SWAP	R24
    01D0 91900060  LDS	R25,temp_data
    01D2 7F90      ANDI	R25,0xF0
    01D3 9592      SWAP	R25
    01D4 709F      ANDI	R25,0xF
    01D5 2B98      OR	R25,R24
    01D6 93900087  STS	0x87,R25
(0396) 	dispaly[5]=dispaly[6]/100;				//百位
    01D8 E614      LDI	R17,0x64
    01D9 2F09      MOV	R16,R25
    01DA 940E02A9  CALL	div8u
    01DC 93000086  STS	0x86,R16
(0397) 	dispaly[4]=dispaly[6]%100;				//
    01DE E614      LDI	R17,0x64
    01DF 91000087  LDS	R16,0x87
    01E1 940E02A7  CALL	mod8u
    01E3 93000085  STS	0x85,R16
(0398) 	dispaly[2]=dispaly[4]/10;               //十位
    01E5 E01A      LDI	R17,0xA
    01E6 940E02A9  CALL	div8u
    01E8 93000083  STS	dispaly+2,R16
(0399) 	dispaly[1]=dispaly[4]%10;			    //个位
    01EA E01A      LDI	R17,0xA
    01EB 91000085  LDS	R16,0x85
    01ED 940E02A7  CALL	mod8u
    01EF 93000082  STS	dispaly+1,R16
(0400) 	
(0401) 	switch	(temp_data[0]&0x0f)
    01F1 91600060  LDS	R22,temp_data
    01F3 2777      CLR	R23
    01F4 706F      ANDI	R22,0xF
    01F5 7070      ANDI	R23,0
    01F6 3060      CPI	R22,0
    01F7 E0E0      LDI	R30,0
    01F8 077E      CPC	R23,R30
    01F9 F40C      BGE	0x01FB
    01FA C053      RJMP	0x024E
    01FB E08F      LDI	R24,0xF
    01FC E090      LDI	R25,0
    01FD 1786      CP	R24,R22
    01FE 0797      CPC	R25,R23
    01FF F40C      BGE	0x0201
    0200 C04D      RJMP	0x024E
    0201 E002      LDI	R16,2
    0202 E010      LDI	R17,0
    0203 019B      MOVW	R18,R22
    0204 940E02BF  CALL	empy16s
    0206 01F8      MOVW	R30,R16
    0207 E584      LDI	R24,0x54
    0208 E090      LDI	R25,0
    0209 0FE8      ADD	R30,R24
    020A 1FF9      ADC	R31,R25
    020B 9005      LPM	R0,Z+
    020C 9014      LPM	R1,0(Z)
    020D 01F0      MOVW	R30,R0
    020E 9409      IJMP
(0402) 	{
(0403) 	case 0x0f:dispaly[0]=9;break;
    020F E089      LDI	R24,0x9
    0210 93800081  STS	dispaly,R24
    0212 C03B      RJMP	0x024E
(0404) 	case 0x0e:dispaly[0]=9;break;
    0213 E089      LDI	R24,0x9
    0214 93800081  STS	dispaly,R24
    0216 C037      RJMP	0x024E
(0405) 	case 0x0d:dispaly[0]=8;break;
    0217 E088      LDI	R24,0x8
    0218 93800081  STS	dispaly,R24
    021A C033      RJMP	0x024E
(0406) 	case 0x0c:dispaly[0]=8;break;
    021B E088      LDI	R24,0x8
    021C 93800081  STS	dispaly,R24
    021E C02F      RJMP	0x024E
(0407) 	case 0x0b:dispaly[0]=7;break;
    021F E087      LDI	R24,7
    0220 93800081  STS	dispaly,R24
    0222 C02B      RJMP	0x024E
(0408) 	case 0x0a:dispaly[0]=6;break;
    0223 E086      LDI	R24,6
    0224 93800081  STS	dispaly,R24
    0226 C027      RJMP	0x024E
(0409) 	case 0x09:dispaly[0]=6;break;
    0227 E086      LDI	R24,6
    0228 93800081  STS	dispaly,R24
    022A C023      RJMP	0x024E
(0410) 	case 0x08:dispaly[0]=5;break;
    022B E085      LDI	R24,5
    022C 93800081  STS	dispaly,R24
    022E C01F      RJMP	0x024E
(0411) 	case 0x07:dispaly[0]=4;break;
    022F E084      LDI	R24,4
    0230 93800081  STS	dispaly,R24
    0232 C01B      RJMP	0x024E
(0412) 	case 0x06:dispaly[0]=4;break;
    0233 E084      LDI	R24,4
    0234 93800081  STS	dispaly,R24
    0236 C017      RJMP	0x024E
(0413) 	case 0x05:dispaly[0]=3;break;
    0237 E083      LDI	R24,3
    0238 93800081  STS	dispaly,R24
    023A C013      RJMP	0x024E
(0414) 	case 0x04:dispaly[0]=3;break;
    023B E083      LDI	R24,3
    023C 93800081  STS	dispaly,R24
    023E C00F      RJMP	0x024E
(0415) 	case 0x03:dispaly[0]=2;break;
    023F E082      LDI	R24,2
    0240 93800081  STS	dispaly,R24
    0242 C00B      RJMP	0x024E
(0416) 	case 0x02:dispaly[0]=1;break;
    0243 E081      LDI	R24,1
    0244 93800081  STS	dispaly,R24
    0246 C007      RJMP	0x024E
(0417) 	case 0x01:dispaly[0]=1;break;
    0247 E081      LDI	R24,1
    0248 93800081  STS	dispaly,R24
    024A C003      RJMP	0x024E
(0418) 	case 0x00:dispaly[0]=1;break;
    024B E081      LDI	R24,1
    024C 93800081  STS	dispaly,R24
(0419) 	default:break;
(0420) 	}
(0421) 		if(n)								//温度正负区分
    024E 2344      TST	R20
    024F F021      BEQ	0x0254
(0422) 	{
(0423) 	dispaly[3]=0x11;						//零下
    0250 E181      LDI	R24,0x11
    0251 93800084  STS	dispaly+3,R24
(0424) 	}
    0253 C003      RJMP	0x0257
(0425) 	else
(0426) 	{
(0427) 	dispaly[3]=0x22;				  	//零上
    0254 E282      LDI	R24,0x22
