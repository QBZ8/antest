(0147) /*函数：uint SPI_RW(uint uchar)
(0148) /*功能：NRF24L01的SPI写时序
(0149) /****************************************************************************************************/
(0150) char SPI_RW(char data)
(0151) {
(0152) 	char i,temp=0;
    0082 2744      CLR	R20
(0153)    	for(i=0;i<8;i++) // output 8-bit
    0083 2766      CLR	R22
    0084 C00D      RJMP	0x0092
(0154)    	{
(0155) 	if(data & 0x80)
    0085 FF07      SBRS	R16,7
    0086 C002      RJMP	0x0089
(0156) 	{
(0157) 		Hign_24L01_MOSI ;         // output 'uchar', MSB to MOSI
    0087 9AC2      SBI	0x18,2
(0158) 	}
    0088 C001      RJMP	0x008A
(0159) 	else
(0160) 	{
(0161) 	 	Low_24L01_MOSI; 
    0089 98C2      CBI	0x18,2
(0162) 	}	
(0163) 		data = (data << 1);           // shift next bit into MSB..
    008A 0F00      LSL	R16
(0164) 		temp<<=1;
    008B 0F44      LSL	R20
(0165) 		Hign_24L01_SCK ;                      // Set SCK high..
    008C 9AC6      SBI	0x18,6
(0166) 		if(Read_24L01_MISO )temp++;       		  // capture current MISO bit
    008D 9BB4      SBIS	0x16,4
    008E C001      RJMP	0x0090
    008F 9543      INC	R20
(0167) 		Low_24L01_SCK;            		  // ..then set SCK low again
    0090 98C6      CBI	0x18,6
    0091 9563      INC	R22
    0092 3068      CPI	R22,0x8
    0093 F388      BCS	0x0085
(0168)    	}
(0169)     return(temp);           		  // return read uchar
    0094 2F04      MOV	R16,R20
    0095 940E02CF  CALL	pop_gset2
    0097 9508      RET
_SPI_Read:
  reg_val              --> R20
  reg                  --> R20
    0098 940E02DD  CALL	push_gset1
    009A 2F40      MOV	R20,R16
(0170) }
(0171) /****************************************************************************************************
(0172) /*函数：uchar SPI_Read(uchar reg)
(0173) /*功能：NRF24L01的SPI时序
(0174) /****************************************************************************************************/
(0175) char SPI_Read(char reg)
(0176) {
(0177) 	char reg_val;
(0178) 	
(0179) 	Low_24L01_CSN;                // CSN low, initialize SPI communication...
    009B 98C7      CBI	0x18,7
(0180) 	SPI_RW(reg);            // Select register to read from..
    009C 2F04      MOV	R16,R20
    009D DFE2      RCALL	_SPI_RW
(0181) 	reg_val = SPI_RW(0);    // ..then read registervalue
    009E 2700      CLR	R16
    009F DFE0      RCALL	_SPI_RW
    00A0 2F40      MOV	R20,R16
(0182) 	Hign_24L01_CSN;                // CSN high, terminate SPI communication
    00A1 9AC7      SBI	0x18,7
(0183) 	
(0184) 	return(reg_val);        // return register value
    00A2 940E02E0  CALL	pop_gset1
    00A4 9508      RET
_SPI_RW_Reg:
  status               --> R20
  value                --> R22
  reg                  --> R20
    00A5 940E02DB  CALL	push_gset2
    00A7 2F62      MOV	R22,R18
    00A8 2F40      MOV	R20,R16
(0185) }
(0186) /****************************************************************************************************/
(0187) /*功能：NRF24L01读写寄存器函数
(0188) /****************************************************************************************************/
(0189) char SPI_RW_Reg(char reg, char value)
(0190) {
(0191) 	char status;
(0192) 	
(0193) 	Low_24L01_CSN;                   // CSN low, init SPI transaction
    00A9 98C7      CBI	0x18,7
(0194) 	status = SPI_RW(reg);      // select register
    00AA 2F04      MOV	R16,R20
    00AB DFD4      RCALL	_SPI_RW
    00AC 2F40      MOV	R20,R16
(0195) 	SPI_RW(value);             // ..and write value to it..
    00AD 2F06      MOV	R16,R22
    00AE DFD1      RCALL	_SPI_RW
(0196) 	Hign_24L01_CSN;                   // CSN high again
    00AF 9AC7      SBI	0x18,7
(0197) 	
(0198) 	return(status);            // return nRF24L01 status uchar
    00B0 2F04      MOV	R16,R20
    00B1 940E02CF  CALL	pop_gset2
    00B3 9508      RET
_SPI_Read_Buf:
  status               --> R20
  uchar_ctr            --> R22
  uchars               --> R10
  pBuf                 --> R12
  reg                  --> R20
    00B4 940E02D7  CALL	push_gset4
    00B6 0169      MOVW	R12,R18
    00B7 2F40      MOV	R20,R16
    00B8 84A8      LDD	R10,Y+8
(0199) }
