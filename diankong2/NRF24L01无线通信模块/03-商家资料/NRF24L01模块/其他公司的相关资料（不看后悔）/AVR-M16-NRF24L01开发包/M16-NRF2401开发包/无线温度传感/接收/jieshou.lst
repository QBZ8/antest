(0153) /*函数：uchar SPI_Read(uchar reg)
(0154) /*功能：NRF24L01的SPI时序
(0155) /****************************************************************************************************/
(0156) char SPI_Read(char reg)
(0157) {
(0158) 	char reg_val;
(0159) 	
(0160) 	Low_24L01_CSN;                // CSN low, initialize SPI communication...
    008A 98C7      CBI	0x18,7
(0161) 	SPI_RW(reg);            // Select register to read from..
    008B 2F04      MOV	R16,R20
    008C DFE2      RCALL	_SPI_RW
(0162) 	reg_val = SPI_RW(0);    // ..then read registervalue
    008D 2700      CLR	R16
    008E DFE0      RCALL	_SPI_RW
    008F 2F40      MOV	R20,R16
(0163) 	Hign_24L01_CSN;                // CSN high, terminate SPI communication
    0090 9AC7      SBI	0x18,7
(0164) 	
(0165) 	return(reg_val);        // return register value
    0091 940E01B1  CALL	pop_gset1
    0093 9508      RET
_SPI_RW_Reg:
  status               --> R20
  value                --> R22
  reg                  --> R20
    0094 940E01AC  CALL	push_gset2
    0096 2F62      MOV	R22,R18
    0097 2F40      MOV	R20,R16
(0166) }
(0167) /****************************************************************************************************/
(0168) /*功能：NRF24L01读写寄存器函数
(0169) /****************************************************************************************************/
(0170) char SPI_RW_Reg(char reg, char value)
(0171) {
(0172) 	char status;
(0173) 	
(0174) 	Low_24L01_CSN;                   // CSN low, init SPI transaction
    0098 98C7      CBI	0x18,7
(0175) 	status = SPI_RW(reg);      // select register
    0099 2F04      MOV	R16,R20
    009A DFD4      RCALL	_SPI_RW
    009B 2F40      MOV	R20,R16
(0176) 	SPI_RW(value);             // ..and write value to it..
    009C 2F06      MOV	R16,R22
    009D DFD1      RCALL	_SPI_RW
(0177) 	Hign_24L01_CSN;                   // CSN high again
    009E 9AC7      SBI	0x18,7
(0178) 	
(0179) 	return(status);            // return nRF24L01 status uchar
    009F 2F04      MOV	R16,R20
    00A0 940E01A0  CALL	pop_gset2
    00A2 9508      RET
_SPI_Read_Buf:
  status1              --> R20
  uchar_ctr            --> R22
  uchars               --> R10
  pBuf                 --> R12
  reg                  --> R20
    00A3 940E01A8  CALL	push_gset4
    00A5 0169      MOVW	R12,R18
    00A6 2F40      MOV	R20,R16
    00A7 84A8      LDD	R10,Y+8
(0180) }
