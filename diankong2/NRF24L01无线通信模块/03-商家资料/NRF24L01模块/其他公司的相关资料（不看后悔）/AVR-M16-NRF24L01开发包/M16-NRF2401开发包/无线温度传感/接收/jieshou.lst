(0215) /*函数：void SetRX_Mode(void)
(0216) /*功能：数据接收配置 
(0217) /****************************************************************************************************/
(0218) void SetRX_Mode(void)
(0219) {
(0220) 	Low_24L01_CE;
_SetRX_Mode:
    00D9 98C5      CBI	0x18,5
(0221) 	//SPI_RW_Reg(WRITE_REG + CONFIG, 0x0f);   		// IRQ收发完成中断响应，16位CRC	，主接收
(0222) 	Hign_24L01_CE; 
    00DA 9AC5      SBI	0x18,5
(0223) 	Delay(1000);//注意不能太小
    00DB EE08      LDI	R16,0xE8
    00DC E013      LDI	R17,3
    00DD DF7C      RCALL	_Delay
    00DE 9508      RET
_nRF24L01_RxPacket:
  revale               --> R20
  rx_buf               --> R22
    00DF 940E01AC  CALL	push_gset2
    00E1 01B8      MOVW	R22,R16
    00E2 9721      SBIW	R28,1
(0224) }
