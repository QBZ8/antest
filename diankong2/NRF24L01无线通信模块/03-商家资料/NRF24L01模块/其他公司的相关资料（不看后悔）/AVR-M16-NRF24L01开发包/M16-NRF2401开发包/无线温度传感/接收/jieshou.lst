(0128) /*函数：uint SPI_RW(uint uchar)
(0129) /*功能：NRF24L01的SPI写时序
(0130) /****************************************************************************************************/
(0131) char SPI_RW(char data)
(0132) {
(0133) 	char i,temp=0;
    0071 2744      CLR	R20
(0134)    	for(i=0;i<8;i++) // output 8-bit
    0072 2766      CLR	R22
    0073 C00D      RJMP	0x0081
(0135)    	{
(0136) 	if(data & 0x80)
    0074 FF07      SBRS	R16,7
    0075 C002      RJMP	0x0078
(0137) 	{
(0138) 		Hign_24L01_MOSI ;         // output 'uchar', MSB to MOSI
    0076 9AC2      SBI	0x18,2
(0139) 	}
    0077 C001      RJMP	0x0079
(0140) 	else
(0141) 	{
(0142) 	 	Low_24L01_MOSI; 
    0078 98C2      CBI	0x18,2
(0143) 	}	
(0144) 		data = (data << 1);           // shift next bit into MSB..
    0079 0F00      LSL	R16
(0145) 		temp<<=1;
    007A 0F44      LSL	R20
(0146) 		Hign_24L01_SCK ;                      // Set SCK high..
    007B 9AC6      SBI	0x18,6
(0147) 		if(PINB&0x10)temp++;       		  // capture current MISO bit
    007C 9BB4      SBIS	0x16,4
    007D C001      RJMP	0x007F
    007E 9543      INC	R20
(0148) 		Low_24L01_SCK;            		  // ..then set SCK low again
    007F 98C6      CBI	0x18,6
    0080 9563      INC	R22
    0081 3068      CPI	R22,0x8
    0082 F388      BCS	0x0074
(0149)    	}
(0150)     return(temp);           		  // return read uchar
    0083 2F04      MOV	R16,R20
    0084 940E01A0  CALL	pop_gset2
    0086 9508      RET
_SPI_Read:
  reg_val              --> R20
  reg                  --> R20
    0087 940E01AE  CALL	push_gset1
    0089 2F40      MOV	R20,R16
(0151) }
