(0226) /*函数：unsigned char nRF24L01_RxPacket(unsigned char* rx_buf)
(0227) /*功能：数据读取后放如rx_buf接收缓冲区中
(0228) /******************************************************************************************************/
(0229) char nRF24L01_RxPacket(char* rx_buf)
(0230) {
(0231)     char revale=0;
    00E3 2744      CLR	R20
(0232) 	sta=SPI_Read(STATUS);	     // 读取状态寄存其来判断数据接收状况		
    00E4 E007      LDI	R16,7
    00E5 DFA1      RCALL	_SPI_Read
    00E6 9300007E  STS	sta,R16
(0233) 	if(sta&0x40)                 // 判断是否接收到数据
    00E8 FF06      SBRS	R16,6
    00E9 C007      RJMP	0x00F1
(0234) 	{
(0235) 	    Low_24L01_CE; 			//SPI使能
    00EA 98C5      CBI	0x18,5
(0236) 		SPI_Read_Buf(RD_RX_PLOAD,rx_buf,TX_PLOAD_WIDTH);// read receive payload from RX_FIFO buffer
    00EB E280      LDI	R24,0x20
    00EC 8388      STD	Y+0,R24
    00ED 019B      MOVW	R18,R22
    00EE E601      LDI	R16,0x61
    00EF DFB3      RCALL	_SPI_Read_Buf
(0237) 		revale =1;			//读取数据完成标志
    00F0 E041      LDI	R20,1
(0238) 	}
(0239) 	SPI_RW_Reg(WRITE_REG+STATUS,sta);   //接收到数据后RX_DR,TX_DS,MAX_PT都置高为1，通过写1来清楚中断标志
    00F1 9120007E  LDS	R18,sta
    00F3 E207      LDI	R16,0x27
    00F4 DF9F      RCALL	_SPI_RW_Reg
(0240) 	return revale;
    00F5 2F04      MOV	R16,R20
    00F6 9621      ADIW	R28,1
    00F7 940E01A0  CALL	pop_gset2
    00F9 9508      RET
_init_NRF24L01:
    00FA 9721      SBIW	R28,1
(0241) }
(0242) 
(0243) //****************************************************************************************
(0244) /*NRF24L01初始化
(0245) //***************************************************************************************/
(0246) void init_NRF24L01(void)
(0247) {
(0248) 
(0249)  	Low_24L01_CE;    // chip enable
    00FB 98C5      CBI	0x18,5
(0250)  	Hign_24L01_CSN;   // Spi disable 
    00FC 9AC7      SBI	0x18,7
(0251)  	Low_24L01_SCK;   // Spi clock line init high
    00FD 98C6      CBI	0x18,6
(0252) 	SPI_Write_Buf(WRITE_REG + TX_ADDR, TX_ADDRESS, TX_ADR_WIDTH);    // 写本地地址	
    00FE E085      LDI	R24,5
    00FF 8388      STD	Y+0,R24
    0100 E724      LDI	R18,0x74
    0101 E030      LDI	R19,0
    0102 E300      LDI	R16,0x30
    0103 DFBE      RCALL	_SPI_Write_Buf
(0253) 	SPI_Write_Buf(WRITE_REG + RX_ADDR_P0, RX_ADDRESS, RX_ADR_WIDTH); // 写接收端地址
    0104 E085      LDI	R24,5
    0105 8388      STD	Y+0,R24
    0106 E729      LDI	R18,0x79
    0107 E030      LDI	R19,0
    0108 E20A      LDI	R16,0x2A
    0109 DFB8      RCALL	_SPI_Write_Buf
(0254) 	SPI_RW_Reg(WRITE_REG + EN_AA, 0x01);      //  频道0自动	ACK应答允许	
    010A E021      LDI	R18,1
    010B E201      LDI	R16,0x21
    010C DF87      RCALL	_SPI_RW_Reg
(0255) 	SPI_RW_Reg(WRITE_REG + EN_RXADDR, 0x01);  //  允许接收地址只有频道0，如果需要多频道可以参考Page21  
    010D E021      LDI	R18,1
    010E E202      LDI	R16,0x22
    010F DF84      RCALL	_SPI_RW_Reg
(0256) 	SPI_RW_Reg(WRITE_REG + RF_CH, 0);        //   设置信道工作为2.4GHZ，收发必须一致
    0110 2722      CLR	R18
    0111 E205      LDI	R16,0x25
    0112 DF81      RCALL	_SPI_RW_Reg
(0257) 	SPI_RW_Reg(WRITE_REG + RX_PW_P0, RX_PLOAD_WIDTH); //设置接收数据长度，本次设置为32字节
    0113 E220      LDI	R18,0x20
    0114 E301      LDI	R16,0x31
    0115 DF7E      RCALL	_SPI_RW_Reg
(0258) 	SPI_RW_Reg(WRITE_REG + RF_SETUP, 0x07);   		//设置发射速率为1MHZ，发射功率为最大值0dB
    0116 E027      LDI	R18,7
    0117 E206      LDI	R16,0x26
    0118 DF7B      RCALL	_SPI_RW_Reg
(0259) 	SPI_RW_Reg(WRITE_REG + CONFIG, 0x0f);   		// IRQ收发完成中断响应，16位CRC	，主接收}
    0119 E02F      LDI	R18,0xF
    011A E200      LDI	R16,0x20
    011B DF78      RCALL	_SPI_RW_Reg
(0260)     Delay(6000);
    011C E700      LDI	R16,0x70
    011D E117      LDI	R17,0x17
    011E DF3B      RCALL	_Delay
    011F 9621      ADIW	R28,1
    0120 9508      RET
(0261) }
(0262) //-------------------------------串口初始化-------------------------------------
(0263) void StartUART(void)
(0264) {
(0265)  	 UCSRA=0x00;	
_StartUART:
    0121 2422      CLR	R2
    0122 B82B      OUT	0x0B,R2
(0266) 	 UCSRB=0x18;	
    0123 E188      LDI	R24,0x18
    0124 B98A      OUT	0x0A,R24
(0267) 	 UCSRC=0x06;	
    0125 E086      LDI	R24,6
    0126 BD80      OUT	0x20,R24
(0268) 	 UBRRL=0x67;
    0127 E687      LDI	R24,0x67
    0128 B989      OUT	0x09,R24
(0269) 	 UBRRH=0x00;
    0129 BC20      OUT	0x20,R2
(0270) 	 UCSRA=UCSRA|0x08;	
    012A 9A5B      SBI	0x0B,3
    012B 9508      RET
(0271) }
(0272) //------------------------------串口发送----------------------------------------
(0273) void R_S_Byte(char R_Byte)
(0274) {	
(0275)      UDR= R_Byte;  
_R_S_Byte:
  R_Byte               --> R16
    012C B90C      OUT	0x0C,R16
    012D 9508      RET
(0276) }
(0277) //******************************************************************************
(0278) void display()
(0279) {
(0280) 	 PORTC=seg[RxBuf[2]];
_display:
    012E E680      LDI	R24,0x60
    012F E090      LDI	R25,0
    0130 91E00081  LDS	R30,RxBuf+2
    0132 27FF      CLR	R31
    0133 0FE8      ADD	R30,R24
    0134 1FF9      ADC	R31,R25
    0135 8020      LDD	R2,Z+0
    0136 BA25      OUT	0x15,R2
(0281) 	 Hign_Display4;
    0137 9ADC      SBI	0x1B,4
(0282) 	 Hign_Display3;
    0138 9ADB      SBI	0x1B,3
(0283) 	 Hign_Display2;
    0139 9ADA      SBI	0x1B,2
(0284) 	 Low_Display1;
    013A 98D9      CBI	0x1B,1
(0285) 	Delay(80);
    013B E500      LDI	R16,0x50
    013C E010      LDI	R17,0
    013D DF1C      RCALL	_Delay
(0286) 	 Hign_Display1;
    013E 9AD9      SBI	0x1B,1
(0287) //------------------------------------------------------------------------------
(0288) 	 PORTC=seg1[RxBuf[1]];
    013F E68A      LDI	R24,0x6A
    0140 E090      LDI	R25,0
    0141 91E00080  LDS	R30,RxBuf+1
    0143 27FF      CLR	R31
    0144 0FE8      ADD	R30,R24
    0145 1FF9      ADC	R31,R25
    0146 8020      LDD	R2,Z+0
    0147 BA25      OUT	0x15,R2
(0289) 	 Low_Display2;
    0148 98DA      CBI	0x1B,2
(0290) 	 Delay(80);
    0149 E500      LDI	R16,0x50
    014A E010      LDI	R17,0
    014B DF0E      RCALL	_Delay
(0291) 	 Hign_Display2;
    014C 9ADA      SBI	0x1B,2
(0292) //------------------------------------------------ ---------------------------
(0293) 	 PORTC=seg[RxBuf[0]];
    014D E680      LDI	R24,0x60
    014E E090      LDI	R25,0
    014F 91E0007F  LDS	R30,RxBuf
    0151 27FF      CLR	R31
    0152 0FE8      ADD	R30,R24
    0153 1FF9      ADC	R31,R25
    0154 8020      LDD	R2,Z+0
    0155 BA25      OUT	0x15,R2
(0294) 	 Low_Display3;
    0156 98DB      CBI	0x1B,3
(0295) 	 Delay(80);
    0157 E500      LDI	R16,0x50
    0158 E010      LDI	R17,0
    0159 DF00      RCALL	_Delay
(0296) 	 Hign_Display3;
    015A 9ADB      SBI	0x1B,3
(0297) //----------------------------------------------------------------------------- 
(0298) 	 PORTC=0xc6;
    015B EC86      LDI	R24,0xC6
    015C BB85      OUT	0x15,R24
(0299) 	 Low_Display4;
    015D 98DC      CBI	0x1B,4
(0300) 	 Delay(80);
    015E E500      LDI	R16,0x50
    015F E010      LDI	R17,0
    0160 DEF9      RCALL	_Delay
(0301) 	 Hign_Display4;	 
    0161 9ADC      SBI	0x1B,4
    0162 9508      RET
(0302) 		
(0303) }
(0304) //******************************************************************************
(0305) main()
(0306) {
(0307)  	char i;
(0308)  	DDRB=0xe4;
_main:
  i                    --> Y+1
    0163 EE84      LDI	R24,0xE4
    0164 BB87      OUT	0x17,R24
(0309) 	DDRC=0xff;
    0165 EF8F      LDI	R24,0xFF
    0166 BB84      OUT	0x14,R24
(0310) 	DDRA=0x1e;
    0167 E18E      LDI	R24,0x1E
    0168 BB8A      OUT	0x1A,R24
(0311) 	DDRD=0xb2;	
    0169 EB82      LDI	R24,0xB2
    016A BB81      OUT	0x11,R24
(0312) 	PORTA=0x00;
    016B 2422      CLR	R2
    016C BA2B      OUT	0x1B,R2
(0313) 	PORTC=0xbf;
    016D EB8F      LDI	R24,0xBF
    016E BB85      OUT	0x15,R24
(0314) 	
(0315) //******************************************************************************
(0316) 	StartUART();
    016F DFB1      RCALL	_StartUART
(0317)     init_NRF24L01() ;
    0170 DF89      RCALL	_init_NRF24L01
    0171 C02C      RJMP	0x019E
(0318) 	while(1)
(0319) 	{
(0320) 		SetRX_Mode();
    0172 DF66      RCALL	_SetRX_Mode
(0321)    		if(nRF24L01_RxPacket(RxBuf))   //判断是否收到数据
    0173 E70F      LDI	R16,0x7F
    0174 E010      LDI	R17,0
    0175 DF69      RCALL	_nRF24L01_RxPacket
    0176 2300      TST	R16
    0177 F0B9      BEQ	0x018F
(0322) 		{
(0323) 			R_S_Byte((RxBuf[2]<<4)|RxBuf[1]);//整数位
    0178 90200080  LDS	R2,RxBuf+1
    017A 91000081  LDS	R16,RxBuf+2
    017C 700F      ANDI	R16,0xF
    017D 9502      SWAP	R16
    017E 2902      OR	R16,R2
    017F DFAC      RCALL	_R_S_Byte
(0324) 			Delay(1000);
    0180 EE08      LDI	R16,0xE8
    0181 E013      LDI	R17,3
    0182 DED7      RCALL	_Delay
(0325) 			R_S_Byte(RxBuf[0]);				 //小数位
    0183 9100007F  LDS	R16,RxBuf
    0185 DFA6      RCALL	_R_S_Byte
(0326) 			Delay(1000);
    0186 EE08      LDI	R16,0xE8
    0187 E013      LDI	R17,3
    0188 DED1      RCALL	_Delay
(0327) 			R_S_Byte(RxBuf[3])	;			 //符号标志位		 
    0189 91000082  LDS	R16,RxBuf+3
    018B DFA0      RCALL	_R_S_Byte
(0328) 			Delay(1000);			
    018C EE08      LDI	R16,0xE8
    018D E013      LDI	R17,3
    018E DECB      RCALL	_Delay
(0329) 		}
(0330) 		display() ;  
    018F DF9E      RCALL	_display
(0331) 	if(((RxBuf[2]<<4)|RxBuf[1])>=53)//大于35度时报警，0x30转换成10进制为48
    0190 90200080  LDS	R2,RxBuf+1
    0192 91800081  LDS	R24,RxBuf+2
    0194 708F      ANDI	R24,0xF
    0195 9582      SWAP	R24
    0196 2982      OR	R24,R2
    0197 3385      CPI	R24,0x35
    0198 F018      BCS	0x019C
(0332)        {
(0333) 		Low_BELL;  //打开蜂明器报警
    0199 9895      CBI	0x12,5
(0334) 		Low_JDQ;   //打开继电器。可以进行相关电器开关操作
    019A 9897      CBI	0x12,7
(0335) 	   }
    019B C002      RJMP	0x019E
(0336) 	else
(0337) 		{
(0338) 	 	Hign_BELL ;//关闭蜂明器报警
    019C 9A95      SBI	0x12,5
(0339) 		Hign_JDQ;  //关闭继电器
FILE: <library>
    019D 9A97      SBI	0x12,7
    019E CFD3      RJMP	0x0172
    019F 9508      RET
pop_gset2:
    01A0 E0E2      LDI	R30,2
    01A1 940C01B2  JMP	pop
pop_gset4:
    01A3 E0E8      LDI	R30,0x8
    01A4 940C01B2  JMP	pop
push_gset5:
    01A6 92FA      ST	R15,-Y
    01A7 92EA      ST	R14,-Y
push_gset4:
    01A8 92DA      ST	R13,-Y
    01A9 92CA      ST	R12,-Y
push_gset3:
    01AA 92BA      ST	R11,-Y
    01AB 92AA      ST	R10,-Y
push_gset2:
    01AC 937A      ST	R23,-Y
    01AD 936A      ST	R22,-Y
push_gset1:
    01AE 935A      ST	R21,-Y
    01AF 934A      ST	R20,-Y
    01B0 9508      RET
pop_gset1:
    01B1 E0E1      LDI	R30,1
pop:
    01B2 9149      LD	R20,Y+
    01B3 9159      LD	R21,Y+
    01B4 FDE0      SBRC	R30,0
    01B5 9508      RET
    01B6 9169      LD	R22,Y+
    01B7 9179      LD	R23,Y+
    01B8 FDE1      SBRC	R30,1
    01B9 9508      RET
    01BA 90A9      LD	R10,Y+
    01BB 90B9      LD	R11,Y+
    01BC FDE2      SBRC	R30,2
    01BD 9508      RET
    01BE 90C9      LD	R12,Y+
    01BF 90D9      LD	R13,Y+
    01C0 FDE3      SBRC	R30,3
    01C1 9508      RET
    01C2 90E9      LD	R14,Y+
    01C3 90F9      LD	R15,Y+
    01C4 9508      RET
