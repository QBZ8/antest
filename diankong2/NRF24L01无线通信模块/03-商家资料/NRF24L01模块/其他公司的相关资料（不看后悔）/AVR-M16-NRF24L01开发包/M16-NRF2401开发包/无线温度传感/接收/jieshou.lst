(0200) /*函数：uint SPI_Write_Buf(uchar reg, uchar *pBuf, uchar uchars)
(0201) /*功能: 用于写数据：为寄存器地址，pBuf：为待写入数据地址，uchars：写入数据的个数
(0202) /*********************************************************************************************************/
(0203) char SPI_Write_Buf(char reg, char *pBuf, char uchars)
(0204) {
(0205) 	char status1,uchar_ctr;
(0206) 	
(0207) 	Low_24L01_CSN;             //SPI使能       
    00C7 98C7      CBI	0x18,7
(0208) 	status1 = SPI_RW(reg);   
    00C8 2F04      MOV	R16,R20
    00C9 DFA5      RCALL	_SPI_RW
    00CA 2F40      MOV	R20,R16
(0209) 	for(uchar_ctr=0; uchar_ctr<uchars; uchar_ctr++) //
    00CB 2766      CLR	R22
    00CC C005      RJMP	0x00D2
(0210) 	SPI_RW(*pBuf++);
    00CD 01F6      MOVW	R30,R12
    00CE 9101      LD	R16,Z+
    00CF 016F      MOVW	R12,R30
    00D0 DF9E      RCALL	_SPI_RW
    00D1 9563      INC	R22
    00D2 156A      CP	R22,R10
    00D3 F3C8      BCS	0x00CD
(0211) 	Hign_24L01_CSN;           //关闭SPI
    00D4 9AC7      SBI	0x18,7
(0212) 	return(status1);    		  // 
    00D5 2F04      MOV	R16,R20
    00D6 940E01A3  CALL	pop_gset4
    00D8 9508      RET
(0213) }
