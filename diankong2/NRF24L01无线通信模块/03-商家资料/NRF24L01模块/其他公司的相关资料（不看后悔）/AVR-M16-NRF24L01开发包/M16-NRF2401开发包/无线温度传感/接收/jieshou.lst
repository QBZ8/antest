(0182) /*函数：uint SPI_Read_Buf(uchar reg, uchar *pBuf, uchar uchars)
(0183) /*功能: 用于读数据，reg：为寄存器地址，pBuf：为待读出数据地址，uchars：读出数据的个数
(0184) /****************************************************************************************************/
(0185) char SPI_Read_Buf(char reg, char *pBuf, char uchars)
(0186) {
(0187) 	int status1,uchar_ctr;
(0188) 	
(0189) 	Low_24L01_CSN;                    		// Set CSN low, init SPI tranaction
    00A8 98C7      CBI	0x18,7
(0190) 	status1 = SPI_RW(reg);       		// Select register to write to and read status uchar
    00A9 2F04      MOV	R16,R20
    00AA DFC4      RCALL	_SPI_RW
    00AB 2F40      MOV	R20,R16
    00AC 2755      CLR	R21
(0191) 	
(0192) 	for(uchar_ctr=0;uchar_ctr<uchars;uchar_ctr++)
    00AD 2766      CLR	R22
    00AE 2777      CLR	R23
    00AF C008      RJMP	0x00B8
(0193) 		pBuf[uchar_ctr] = SPI_RW(0);    // 
    00B0 2700      CLR	R16
    00B1 DFBD      RCALL	_SPI_RW
    00B2 01FB      MOVW	R30,R22
    00B3 0DEC      ADD	R30,R12
    00B4 1DFD      ADC	R31,R13
    00B5 8300      STD	Z+0,R16
    00B6 5F6F      SUBI	R22,0xFF
    00B7 4F7F      SBCI	R23,0xFF
    00B8 2C2A      MOV	R2,R10
    00B9 2433      CLR	R3
    00BA 1562      CP	R22,R2
    00BB 0573      CPC	R23,R3
    00BC F39C      BLT	0x00B0
(0194) 	
(0195) 	Hign_24L01_CSN;                           
    00BD 9AC7      SBI	0x18,7
(0196) 	
(0197) 	return(status1);                    // return nRF24L01 status uchar
    00BE 2F04      MOV	R16,R20
    00BF 940E01A3  CALL	pop_gset4
    00C1 9508      RET
_SPI_Write_Buf:
  status1              --> R20
  uchar_ctr            --> R22
  uchars               --> R10
  pBuf                 --> R12
  reg                  --> R20
    00C2 940E01A8  CALL	push_gset4
    00C4 0169      MOVW	R12,R18
    00C5 2F40      MOV	R20,R16
    00C6 84A8      LDD	R10,Y+8
(0198) }
