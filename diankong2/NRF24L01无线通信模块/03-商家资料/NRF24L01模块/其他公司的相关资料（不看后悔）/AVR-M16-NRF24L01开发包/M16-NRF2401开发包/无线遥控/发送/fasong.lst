(0191) /*函数：uint SPI_Read_Buf(uchar reg, uchar *pBuf, uchar uchars)
(0192) /*功能: 用于读数据，reg：为寄存器地址，pBuf：为待读出数据地址，uchars：读出数据的个数
(0193) /****************************************************************************************************/
(0194) char SPI_Read_Buf(char reg, char *pBuf, char uchars)
(0195) {
(0196) 	int status,uchar_ctr;
(0197) 	
(0198) 	Low_24L01_CSN;                    		// Set CSN low, init SPI tranaction
      B6 98C7      CBI	0x18,7
(0199) 	status = SPI_RW(reg);       		// Select register to write to and read status uchar
      B7 2D0A      MOV	R16,R10
      B8 DFC7      RCALL	_SPI_RW
      B9 2EA0      MOV	R10,R16
      BA 24BB      CLR	R11
(0200) 	
(0201) 	for(uchar_ctr=0;uchar_ctr<uchars;uchar_ctr++)
      BB 2744      CLR	R20
      BC 2755      CLR	R21
      BD C008      RJMP	0x00C6
(0202) 		pBuf[uchar_ctr] = SPI_RW(0);    // 
      BE 2700      CLR	R16
      BF DFC0      RCALL	_SPI_RW
      C0 01FA      MOVW	R30,R20
      C1 0DEC      ADD	R30,R12
      C2 1DFD      ADC	R31,R13
      C3 8300      STD	Z+0,R16
      C4 5F4F      SUBI	R20,0xFF
      C5 4F5F      SBCI	R21,0xFF
      C6 802E      LDD	R2,Y+6
      C7 2433      CLR	R3
      C8 1542      CP	R20,R2
      C9 0553      CPC	R21,R3
      CA F39C      BLT	0x00BE
(0203) 	
(0204) 	Hign_24L01_CSN;                           
      CB 9AC7      SBI	0x18,7
(0205) 	
(0206) 	return(status);                    // return nRF24L01 status uchar
      CC 2D0A      MOV	R16,R10
      CD 940C 01E6 JMP	pop_xgset303C
_SPI_Write_Buf:
  status               --> R10
  uchar_ctr            --> R12
  uchars               --> Y,+6
  pBuf                 --> R14
  reg                  --> R10
      CF 940E 01CE CALL	push_xgset00FC
      D1 0179      MOVW	R14,R18
      D2 2EA0      MOV	R10,R16
(0207) }
(0208) /*********************************************************************************************************
(0209) /*函数：uint SPI_Write_Buf(uchar reg, uchar *pBuf, uchar uchars)
(0210) /*功能: 用于写数据：为寄存器地址，pBuf：为待写入数据地址，uchars：写入数据的个数
(0211) /*********************************************************************************************************/
(0212) char SPI_Write_Buf(char reg, char *pBuf, char uchars)
(0213) {
(0214) 	char status,uchar_ctr;
(0215) 	
(0216) 	Low_24L01_CSN;             //SPI使能       
      D3 98C7      CBI	0x18,7
(0217) 	status = SPI_RW(reg);   
      D4 2D0A      MOV	R16,R10
      D5 DFAA      RCALL	_SPI_RW
      D6 2EA0      MOV	R10,R16
(0218) 	for(uchar_ctr=0; uchar_ctr<uchars; uchar_ctr++) //
      D7 24CC      CLR	R12
      D8 C005      RJMP	0x00DE
(0219) 	SPI_RW(*pBuf++);
      D9 01F7      MOVW	R30,R14
      DA 9101      LD	R16,Z+
      DB 017F      MOVW	R14,R30
      DC DFA3      RCALL	_SPI_RW
      DD 94C3      INC	R12
      DE 800E      LDD	R0,Y+6
      DF 14C0      CP	R12,R0
      E0 F3C0      BCS	0x00D9
(0220) 	Hign_24L01_CSN;           //关闭SPI
      E1 9AC7      SBI	0x18,7
(0221) 	return(status);    		  // 
      E2 2D0A      MOV	R16,R10
      E3 940C 01C3 JMP	pop_xgset00FC
(0222) }
