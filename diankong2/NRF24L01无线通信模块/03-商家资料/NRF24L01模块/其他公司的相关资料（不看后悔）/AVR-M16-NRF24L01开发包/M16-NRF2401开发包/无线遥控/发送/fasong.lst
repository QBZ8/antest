(0137) /*函数：uint SPI_RW(uint uchar)
(0138) /*功能：NRF24L01的SPI写时序
(0139) /****************************************************************************************************/
(0140) char SPI_RW(char data)
(0141) {
(0142) 	char i,temp=0;
      82 24AA      CLR	R10
(0143)    	for(i=0;i<8;i++) // output 8-bit
      83 2744      CLR	R20
      84 C00D      RJMP	0x0092
(0144)    	{
(0145) 	if(data & 0x80)
      85 FF07      SBRS	R16,7
      86 C002      RJMP	0x0089
(0146) 	{
(0147) 		Hign_24L01_MOSI ;         // output 'uchar', MSB to MOSI
      87 9AC2      SBI	0x18,2
(0148) 	}
      88 C001      RJMP	0x008A
(0149) 	else
(0150) 	{
(0151) 	 	Low_24L01_MOSI; 
      89 98C2      CBI	0x18,2
(0152) 	}	
(0153) 		data = (data << 1);           // shift next bit into MSB..
      8A 0F00      LSL	R16
(0154) 		temp<<=1;
      8B 0CAA      LSL	R10
(0155) 		Hign_24L01_SCK ;                      // Set SCK high..
      8C 9AC6      SBI	0x18,6
(0156) 		if(Read_24L01_MISO )temp++;       		  // capture current MISO bit
      8D 9BB4      SBIS	0x16,4
      8E C001      RJMP	0x0090
      8F 94A3      INC	R10
(0157) 		Low_24L01_SCK;            		  // ..then set SCK low again
      90 98C6      CBI	0x18,6
      91 9543      INC	R20
      92 3048      CPI	R20,0x8
      93 F388      BCS	0x0085
(0158)    	}
(0159)     return(temp);           		  // return read uchar
      94 2D0A      MOV	R16,R10
      95 940C 01DA JMP	pop_xgset300C
_SPI_Read:
  reg_val              --> R10
  reg                  --> R10
      97 92AA      ST	R10,-Y
      98 92BA      ST	R11,-Y
      99 2EA0      MOV	R10,R16
(0160) }
