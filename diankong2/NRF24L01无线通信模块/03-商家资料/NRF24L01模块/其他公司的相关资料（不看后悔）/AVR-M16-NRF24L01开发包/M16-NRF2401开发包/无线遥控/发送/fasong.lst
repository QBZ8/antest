(0224) /*函数：void SetRX_Mode(void)
(0225) /*功能：数据接收配置 
(0226) /****************************************************************************************************/
(0227) void SetRX_Mode(void)
(0228) {
(0229) 	Low_24L01_CE;
_SetRX_Mode:
      E5 98C5      CBI	0x18,5
(0230) 	SPI_RW_Reg(WRITE_REG + CONFIG, 0x0f);   		// IRQ收发完成中断响应，16位CRC	，主接收
      E6 E02F      LDI	R18,0xF
      E7 E200      LDI	R16,0x20
      E8 DFBB      RCALL	_SPI_RW_Reg
(0231) 	Hign_24L01_CE; 
      E9 9AC5      SBI	0x18,5
(0232) 	inerDelay_us(130);
      EA E802      LDI	R16,0x82
      EB DF8E      RCALL	_inerDelay_us
      EC 9508      RET
_nRF24L01_RxPacket:
  revale               --> R20
  rx_buf               --> R10
      ED 940E 01D5 CALL	push_xgset300C
      EF 0158      MOVW	R10,R16
      F0 9721      SBIW	R28,1
(0233) }
