(0177) /*功能：NRF24L01读写寄存器函数
(0178) /****************************************************************************************************/
(0179) char SPI_RW_Reg(char reg, char value)
(0180) {
(0181) 	char status;
(0182) 	
(0183) 	Low_24L01_CSN;                   // CSN low, init SPI transaction
      A8 98C7      CBI	0x18,7
(0184) 	status = SPI_RW(reg);      // select register
      A9 2D0A      MOV	R16,R10
      AA DFD5      RCALL	_SPI_RW
      AB 2EA0      MOV	R10,R16
(0185) 	SPI_RW(value);             // ..and write value to it..
      AC 2D0C      MOV	R16,R12
      AD DFD2      RCALL	_SPI_RW
(0186) 	Hign_24L01_CSN;                   // CSN high again
      AE 9AC7      SBI	0x18,7
(0187) 	
(0188) 	return(status);            // return nRF24L01 status uchar
      AF 2D0A      MOV	R16,R10
      B0 940C 01BE JMP	pop_xgset003C
_SPI_Read_Buf:
  status               --> R10
  uchar_ctr            --> R20
  uchars               --> Y,+6
  pBuf                 --> R12
  reg                  --> R10
      B2 940E 01DF CALL	push_xgset303C
      B4 0169      MOVW	R12,R18
      B5 2EA0      MOV	R10,R16
(0189) }
