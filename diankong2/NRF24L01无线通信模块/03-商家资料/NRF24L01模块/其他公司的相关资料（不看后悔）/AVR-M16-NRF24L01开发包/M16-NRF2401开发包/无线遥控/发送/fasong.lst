(0235) /*函数：unsigned char nRF24L01_RxPacket(unsigned char* rx_buf)
(0236) /*功能：数据读取后放如rx_buf接收缓冲区中
(0237) /******************************************************************************************************/
(0238) char nRF24L01_RxPacket(char* rx_buf)
(0239) {
(0240)     char revale=0;
      F1 2744      CLR	R20
(0241) 	sta=SPI_Read(STATUS);	// 读取状态寄存其来判断数据接收状况
      F2 E007      LDI	R16,7
      F3 DFA3      RCALL	_SPI_Read
      F4 9300 0095 STS	sta,R16
(0242) 	if(sta&0x40)				// 判断是否接收到数据
      F6 FF06      SBRS	R16,6
      F7 C007      RJMP	0x00FF
(0243) 	{
(0244) 	    Low_24L01_CE; 			//SPI使能
      F8 98C5      CBI	0x18,5
(0245) 		SPI_Read_Buf(RD_RX_PLOAD,rx_buf,TX_PLOAD_WIDTH);// read receive payload from RX_FIFO buffer
      F9 E280      LDI	R24,0x20
      FA 8388      STD	Y+0,R24
      FB 0195      MOVW	R18,R10
      FC E601      LDI	R16,0x61
      FD DFB4      RCALL	_SPI_Read_Buf
(0246) 		revale =1;			//读取数据完成标志
      FE E041      LDI	R20,1
(0247) 	}
(0248) 	SPI_RW_Reg(WRITE_REG+STATUS,sta);   //接收到数据后RX_DR,TX_DS,MAX_PT都置高为1，通过写1来清楚中断标志
      FF 9120 0095 LDS	R18,sta
     101 E207      LDI	R16,0x27
     102 DFA1      RCALL	_SPI_RW_Reg
(0249) 	return revale;
     103 2F04      MOV	R16,R20
     104 9621      ADIW	R28,1
     105 940C 01DA JMP	pop_xgset300C
_nRF24L01_TxPacket:
  tx_buf               --> R10
     107 92AA      ST	R10,-Y
     108 92BA      ST	R11,-Y
     109 0158      MOVW	R10,R16
     10A 9721      SBIW	R28,1
(0250) }
(0251) /***********************************************************************************************************
(0252) /*函数：void nRF24L01_TxPacket(char * tx_buf)
(0253) /*功能：发送 tx_buf中数据
(0254) /**********************************************************************************************************/
(0255) void nRF24L01_TxPacket(char * tx_buf)
(0256) {
(0257) 	Low_24L01_CE;			//StandBy I模式	
     10B 98C5      CBI	0x18,5
(0258) 	SPI_Write_Buf(WRITE_REG + RX_ADDR_P0, TX_ADDRESS, TX_ADR_WIDTH); // 装载接收端地址
     10C E085      LDI	R24,5
     10D 8388      STD	Y+0,R24
     10E E82A      LDI	R18,0x8A
     10F E030      LDI	R19,0
     110 E20A      LDI	R16,0x2A
     111 DFBD      RCALL	_SPI_Write_Buf
(0259) 	SPI_Write_Buf(WR_TX_PLOAD, tx_buf, TX_PLOAD_WIDTH); 			 // 装载数据	
     112 E280      LDI	R24,0x20
     113 8388      STD	Y+0,R24
     114 0195      MOVW	R18,R10
     115 EA00      LDI	R16,0xA0
     116 DFB8      RCALL	_SPI_Write_Buf
(0260) //	SPI_RW_Reg(WRITE_REG + CONFIG, 0x0e);   		 // IRQ收发完成中断响应，16位CRC，主发送
(0261) 	Hign_24L01_CE;		 //置高CE，激发数据发送
     117 9AC5      SBI	0x18,5
(0262) 	inerDelay_us(10);
     118 E00A      LDI	R16,0xA
     119 DF60      RCALL	_inerDelay_us
     11A 9621      ADIW	R28,1
     11B 90B9      LD	R11,Y+
     11C 90A9      LD	R10,Y+
     11D 9508      RET
_init_NRF24L01:
     11E 9721      SBIW	R28,1
(0263) }
(0264) //****************************************************************************************
(0265) /*NRF24L01初始化
(0266) //***************************************************************************************/
(0267) void init_NRF24L01(void)
(0268) {
(0269)     inerDelay_us(100);
     11F E604      LDI	R16,0x64
     120 DF59      RCALL	_inerDelay_us
(0270)  	Low_24L01_CE;    // chip enable
     121 98C5      CBI	0x18,5
(0271)  	Hign_24L01_CSN;   // Spi disable 
     122 9AC7      SBI	0x18,7
(0272)  	Low_24L01_SCK;   // Spi clock line init high
     123 98C6      CBI	0x18,6
(0273) 	SPI_Write_Buf(WRITE_REG + TX_ADDR, TX_ADDRESS, TX_ADR_WIDTH);    // 写本地地址	
     124 E085      LDI	R24,5
     125 8388      STD	Y+0,R24
     126 E82A      LDI	R18,0x8A
     127 E030      LDI	R19,0
     128 E300      LDI	R16,0x30
     129 DFA5      RCALL	_SPI_Write_Buf
(0274) 	SPI_Write_Buf(WRITE_REG + RX_ADDR_P0, RX_ADDRESS, RX_ADR_WIDTH); // 写接收端地址
     12A E085      LDI	R24,5
     12B 8388      STD	Y+0,R24
     12C E82F      LDI	R18,0x8F
     12D E030      LDI	R19,0
     12E E20A      LDI	R16,0x2A
     12F DF9F      RCALL	_SPI_Write_Buf
(0275) 	SPI_RW_Reg(WRITE_REG + EN_AA, 0x01);      //  频道0自动	ACK应答允许	
     130 E021      LDI	R18,1
     131 E201      LDI	R16,0x21
     132 DF71      RCALL	_SPI_RW_Reg
(0276) 	SPI_RW_Reg(WRITE_REG + EN_RXADDR, 0x01);  //  允许接收地址只有频道0，如果需要多频道可以参考Page21  
     133 E021      LDI	R18,1
     134 E202      LDI	R16,0x22
     135 DF6E      RCALL	_SPI_RW_Reg
(0277) 	SPI_RW_Reg(WRITE_REG + RF_CH, 0);        //   设置信道工作为2.4GHZ，收发必须一致
     136 2722      CLR	R18
     137 E205      LDI	R16,0x25
     138 DF6B      RCALL	_SPI_RW_Reg
(0278) 	SPI_RW_Reg(WRITE_REG + RX_PW_P0, RX_PLOAD_WIDTH); //设置接收数据长度，本次设置为32字节
     139 E220      LDI	R18,0x20
     13A E301      LDI	R16,0x31
     13B DF68      RCALL	_SPI_RW_Reg
(0279) 	SPI_RW_Reg(WRITE_REG + RF_SETUP, 0x07);   		//设置发射速率为1MHZ，发射功率为最大值0dB	
     13C E027      LDI	R18,7
     13D E206      LDI	R16,0x26
     13E DF65      RCALL	_SPI_RW_Reg
(0280) 	SPI_RW_Reg(WRITE_REG + CONFIG, 0x0e);   		 // IRQ收发完成中断响应，16位CRC，主发送
     13F E02E      LDI	R18,0xE
     140 E200      LDI	R16,0x20
     141 DF62      RCALL	_SPI_RW_Reg
     142 9621      ADIW	R28,1
     143 9508      RET
(0281) 
(0282) }
