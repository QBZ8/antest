(0229) /*函数：unsigned char nRF24L01_RxPacket(unsigned char* rx_buf)
(0230) /*功能：数据读取后放如rx_buf接收缓冲区中
(0231) /******************************************************************************************************/
(0232) char nRF24L01_RxPacket(char* rx_buf)
(0233) {
(0234)     char revale=0;
      E9 2744      CLR	R20
(0235) 	sta=SPI_Read(STATUS);	      // 读取状态寄存其来判断数据接收状况		
      EA E007      LDI	R16,7
      EB DFA5      RCALL	_SPI_Read
      EC 9300 0097 STS	sta,R16
(0236) 	if(sta&0x40)         // 判断是否接收到数据
      EE FF06      SBRS	R16,6
      EF C007      RJMP	0x00F7
(0237) 	{
(0238) 	    Low_24L01_CE; 			//SPI使能
      F0 98C5      CBI	0x18,5
(0239) 		SPI_Read_Buf(RD_RX_PLOAD,rx_buf,TX_PLOAD_WIDTH);// read receive payload from RX_FIFO buffer
      F1 E280      LDI	R24,0x20
      F2 8388      STD	Y+0,R24
      F3 0195      MOVW	R18,R10
      F4 E601      LDI	R16,0x61
      F5 DFB6      RCALL	_SPI_Read_Buf
(0240) 		revale =1;			//读取数据完成标志
      F6 E041      LDI	R20,1
(0241) 	}
(0242) 	SPI_RW_Reg(WRITE_REG+STATUS,sta);   //接收到数据后RX_DR,TX_DS,MAX_PT都置高为1，通过写1来清楚中断标志
      F7 9120 0097 LDS	R18,sta
      F9 E207      LDI	R16,0x27
      FA DFA3      RCALL	_SPI_RW_Reg
(0243) 	return revale;
      FB 2F04      MOV	R16,R20
      FC 9621      ADIW	R28,1
      FD 940C 018D JMP	pop_xgset300C
_nRF24L01_TxPacket:
  tx_buf               --> R10
      FF 92AA      ST	R10,-Y
     100 92BA      ST	R11,-Y
     101 0158      MOVW	R10,R16
     102 9721      SBIW	R28,1
(0244) }
(0245) /***********************************************************************************************************
(0246) /*函数：void nRF24L01_TxPacket(char * tx_buf)
(0247) /*功能：发送 tx_buf中数据
(0248) /**********************************************************************************************************/
(0249) void nRF24L01_TxPacket(char * tx_buf)
(0250) {
(0251) 	Low_24L01_CE;			//StandBy I模式	
     103 98C5      CBI	0x18,5
(0252) 	SPI_Write_Buf(WRITE_REG + RX_ADDR_P0, TX_ADDRESS, TX_ADR_WIDTH); // 装载接收端地址
     104 E085      LDI	R24,5
     105 8388      STD	Y+0,R24
     106 E82A      LDI	R18,0x8A
     107 E030      LDI	R19,0
     108 E20A      LDI	R16,0x2A
     109 DFBF      RCALL	_SPI_Write_Buf
(0253) 	SPI_Write_Buf(WR_TX_PLOAD, tx_buf, TX_PLOAD_WIDTH); 			 // 装载数据	
     10A E280      LDI	R24,0x20
     10B 8388      STD	Y+0,R24
     10C 0195      MOVW	R18,R10
     10D EA00      LDI	R16,0xA0
     10E DFBA      RCALL	_SPI_Write_Buf
(0254) 	SPI_RW_Reg(WRITE_REG + CONFIG, 0x0e);   		 // IRQ收发完成中断响应，16位CRC，主发送
     10F E02E      LDI	R18,0xE
     110 E200      LDI	R16,0x20
     111 DF8C      RCALL	_SPI_RW_Reg
(0255) 	Hign_24L01_CE;		 //置高CE，激发数据发送
     112 9AC5      SBI	0x18,5
(0256) 	Delay(600);
     113 E508      LDI	R16,0x58
     114 E012      LDI	R17,2
     115 DF4F      RCALL	_Delay
     116 9621      ADIW	R28,1
     117 90B9      LD	R11,Y+
     118 90A9      LD	R10,Y+
     119 9508      RET
_init_NRF24L01:
     11A 9721      SBIW	R28,1
(0257) }
(0258) //****************************************************************************************
(0259) /*NRF24L01初始化
(0260) //***************************************************************************************/
(0261) void init_NRF24L01(void)
(0262) {
(0263) 
(0264)  	Low_24L01_CE;    // chip enable
     11B 98C5      CBI	0x18,5
(0265)  	Hign_24L01_CSN;   // Spi disable 
     11C 9AC7      SBI	0x18,7
(0266)  	Low_24L01_SCK;   // Spi clock line init high
     11D 98C6      CBI	0x18,6
(0267) 	SPI_Write_Buf(WRITE_REG + TX_ADDR, TX_ADDRESS, TX_ADR_WIDTH);    // 写本地地址	
     11E E085      LDI	R24,5
     11F 8388      STD	Y+0,R24
     120 E82A      LDI	R18,0x8A
     121 E030      LDI	R19,0
     122 E300      LDI	R16,0x30
     123 DFA5      RCALL	_SPI_Write_Buf
(0268) 	SPI_Write_Buf(WRITE_REG + RX_ADDR_P0, RX_ADDRESS, RX_ADR_WIDTH); // 写接收端地址
     124 E085      LDI	R24,5
     125 8388      STD	Y+0,R24
     126 E82F      LDI	R18,0x8F
     127 E030      LDI	R19,0
     128 E20A      LDI	R16,0x2A
     129 DF9F      RCALL	_SPI_Write_Buf
(0269) 	SPI_RW_Reg(WRITE_REG + EN_AA, 0x01);      //  频道0自动	ACK应答允许	
     12A E021      LDI	R18,1
     12B E201      LDI	R16,0x21
     12C DF71      RCALL	_SPI_RW_Reg
(0270) 	SPI_RW_Reg(WRITE_REG + EN_RXADDR, 0x01);  //  允许接收地址只有频道0，如果需要多频道可以参考Page21  
     12D E021      LDI	R18,1
     12E E202      LDI	R16,0x22
     12F DF6E      RCALL	_SPI_RW_Reg
(0271) 	SPI_RW_Reg(WRITE_REG + RF_CH, 0);        //   设置信道工作为2.4GHZ，收发必须一致
     130 2722      CLR	R18
     131 E205      LDI	R16,0x25
     132 DF6B      RCALL	_SPI_RW_Reg
(0272) 	SPI_RW_Reg(WRITE_REG + RX_PW_P0, RX_PLOAD_WIDTH); //设置接收数据长度，本次设置为32字节
     133 E220      LDI	R18,0x20
     134 E301      LDI	R16,0x31
     135 DF68      RCALL	_SPI_RW_Reg
(0273) 	SPI_RW_Reg(WRITE_REG + RF_SETUP, 0x07);   		//设置发射速率为1MHZ，发射功率为最大值0dB
     136 E027      LDI	R18,7
     137 E206      LDI	R16,0x26
     138 DF65      RCALL	_SPI_RW_Reg
(0274) 	SPI_RW_Reg(WRITE_REG + CONFIG, 0x0f);   		// IRQ收发完成中断响应，16位CRC	，主接收}
     139 E02F      LDI	R18,0xF
     13A E200      LDI	R16,0x20
     13B DF62      RCALL	_SPI_RW_Reg
(0275)     Delay(6000);
     13C E700      LDI	R16,0x70
     13D E117      LDI	R17,0x17
     13E DF26      RCALL	_Delay
     13F 9621      ADIW	R28,1
     140 9508      RET
_main:
  i                    --> Y,+1
  RxBuf                --> Y,+0
     141 97A0      SBIW	R28,0x20
(0276) }
(0277) //******************************************************************************
(0278) //******************************************************************************
(0279) main()
(0280) {
(0281)  	char i,RxBuf[32];
(0282)  	DDRB=0xe4;
     142 EE84      LDI	R24,0xE4
     143 BB87      OUT	0x17,R24
(0283) 	DDRC=0xff;
     144 EF8F      LDI	R24,0xFF
     145 BB84      OUT	0x14,R24
(0284) 	DDRA=0x1e;
     146 E18E      LDI	R24,0x1E
     147 BB8A      OUT	0x1A,R24
(0285) 	DDRD=0xb2;
     148 EB82      LDI	R24,0xB2
     149 BB81      OUT	0x11,R24
(0286) 	PORTA=0x00;
     14A 2422      CLR	R2
     14B BA2B      OUT	0x1B,R2
(0287) 	PORTC=0xbf;
     14C EB8F      LDI	R24,0xBF
     14D BB85      OUT	0x15,R24
(0288) 	Hign_BELL;	
     14E 9A95      SBI	0x12,5
(0289) 	Low_JDQ ;
     14F 9897      CBI	0x12,7
(0290) 	Low_Display4;
     150 98DC      CBI	0x1B,4
(0291) 	Low_Display3;
     151 98DB      CBI	0x1B,3
(0292) 	Low_Display2;
     152 98DA      CBI	0x1B,2
(0293) 	Low_Display1;
     153 98D9      CBI	0x1B,1
(0294) //******************************************************************************
(0295)     init_NRF24L01() ;
     154 DFC5      RCALL	_init_NRF24L01
     155 C018      RJMP	0x016E
(0296) 	while(1)
(0297) 	{
(0298) 		SetRX_Mode();
     156 DF88      RCALL	_SetRX_Mode
(0299) 		if(nRF24L01_RxPacket(RxBuf)) //判断是否收到数据
     157 018E      MOVW	R16,R28
     158 DF8C      RCALL	_nRF24L01_RxPacket
     159 2300      TST	R16
     15A F089      BEQ	0x016C
(0300) 		{
(0301) 		if(RxBuf[0]==0x29)
     15B 8188      LDD	R24,Y+0
     15C 3289      CPI	R24,0x29
     15D F419      BNE	0x0161
(0302) 		{
(0303) 		Low_JDQ ;   //关闭继电器
     15E 9897      CBI	0x12,7
(0304) 	   // Delay(1000);
(0305) 		PORTC=0xfe;
     15F EF8E      LDI	R24,0xFE
     160 BB85      OUT	0x15,R24
(0306) 		}
(0307) 		if(RxBuf[0]==0x30)
     161 8188      LDD	R24,Y+0
     162 3380      CPI	R24,0x30
     163 F419      BNE	0x0167
(0308) 		{
(0309) 		Hign_JDQ ;//打开继电器
     164 9A97      SBI	0x12,7
(0310) 	   // Delay(1000);
(0311) 	    PORTC=0xbf;
     165 EB8F      LDI	R24,0xBF
     166 BB85      OUT	0x15,R24
(0312) 		}
(0313) 		if(RxBuf[0]==0x31)
     167 8188      LDD	R24,Y+0
     168 3381      CPI	R24,0x31
     169 F411      BNE	0x016C
(0314) 		{
(0315) 	    PORTC=0xff;//数码管熄灭
     16A EF8F      LDI	R24,0xFF
     16B BB85      OUT	0x15,R24
(0316) 		}
(0317) 		}	
(0318) 		RxBuf[0]=0;
