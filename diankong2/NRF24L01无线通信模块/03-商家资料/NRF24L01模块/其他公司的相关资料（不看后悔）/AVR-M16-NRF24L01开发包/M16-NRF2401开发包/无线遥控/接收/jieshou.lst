(0203) /*函数：uint SPI_Write_Buf(uchar reg, uchar *pBuf, uchar uchars)
(0204) /*功能: 用于写数据：为寄存器地址，pBuf：为待写入数据地址，uchars：写入数据的个数
(0205) /*********************************************************************************************************/
(0206) char SPI_Write_Buf(char reg, char *pBuf, char uchars)
(0207) {
(0208) 	char status1,uchar_ctr;
(0209) 	
(0210) 	Low_24L01_CSN;             //SPI使能       
      CD 98C7      CBI	0x18,7
(0211) 	status1 = SPI_RW(reg);   
      CE 2D0A      MOV	R16,R10
      CF DFAA      RCALL	_SPI_RW
      D0 2EA0      MOV	R10,R16
(0212) 	for(uchar_ctr=0; uchar_ctr<uchars; uchar_ctr++) //
      D1 24CC      CLR	R12
      D2 C005      RJMP	0x00D8
(0213) 	SPI_RW(*pBuf++);
      D3 01F7      MOVW	R30,R14
      D4 9101      LD	R16,Z+
      D5 017F      MOVW	R14,R30
      D6 DFA3      RCALL	_SPI_RW
      D7 94C3      INC	R12
      D8 800E      LDD	R0,Y+6
      D9 14C0      CP	R12,R0
      DA F3C0      BCS	0x00D3
(0214) 	Hign_24L01_CSN;           //关闭SPI
      DB 9AC7      SBI	0x18,7
(0215) 	return(status1);    		  // 
      DC 2D0A      MOV	R16,R10
      DD 940C 0176 JMP	pop_xgset00FC
(0216) }
