(0218) /*函数：void SetRX_Mode(void)
(0219) /*功能：数据接收配置 
(0220) /****************************************************************************************************/
(0221) void SetRX_Mode(void)
(0222) {
(0223) 	Low_24L01_CE;
_SetRX_Mode:
      DF 98C5      CBI	0x18,5
(0224) 	//SPI_RW_Reg(WRITE_REG + CONFIG, 0x0f);   		// IRQ收发完成中断响应，16位CRC	，主接收
(0225) 	Hign_24L01_CE; 
      E0 9AC5      SBI	0x18,5
(0226) 	Delay(1000);//注意不能太小
      E1 EE08      LDI	R16,0xE8
      E2 E013      LDI	R17,3
      E3 DF81      RCALL	_Delay
      E4 9508      RET
_nRF24L01_RxPacket:
  revale               --> R20
  rx_buf               --> R10
      E5 940E 0188 CALL	push_xgset300C
      E7 0158      MOVW	R10,R16
      E8 9721      SBIW	R28,1
(0227) }
