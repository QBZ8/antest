(0185) /*函数：uint SPI_Read_Buf(uchar reg, uchar *pBuf, uchar uchars)
(0186) /*功能: 用于读数据，reg：为寄存器地址，pBuf：为待读出数据地址，uchars：读出数据的个数
(0187) /****************************************************************************************************/
(0188) char SPI_Read_Buf(char reg, char *pBuf, char uchars)
(0189) {
(0190) 	int status1,uchar_ctr;
(0191) 	
(0192) 	Low_24L01_CSN;                    		// Set CSN low, init SPI tranaction
      B0 98C7      CBI	0x18,7
(0193) 	status1 = SPI_RW(reg);       		// Select register to write to and read status uchar
      B1 2D0A      MOV	R16,R10
      B2 DFC7      RCALL	_SPI_RW
      B3 2EA0      MOV	R10,R16
      B4 24BB      CLR	R11
(0194) 	
(0195) 	for(uchar_ctr=0;uchar_ctr<uchars;uchar_ctr++)
      B5 2744      CLR	R20
      B6 2755      CLR	R21
      B7 C008      RJMP	0x00C0
(0196) 		pBuf[uchar_ctr] = SPI_RW(0);    // 
      B8 2700      CLR	R16
      B9 DFC0      RCALL	_SPI_RW
      BA 01FA      MOVW	R30,R20
      BB 0DEC      ADD	R30,R12
      BC 1DFD      ADC	R31,R13
      BD 8300      STD	Z+0,R16
      BE 5F4F      SUBI	R20,0xFF
      BF 4F5F      SBCI	R21,0xFF
      C0 802E      LDD	R2,Y+6
      C1 2433      CLR	R3
      C2 1542      CP	R20,R2
      C3 0553      CPC	R21,R3
      C4 F39C      BLT	0x00B8
(0197) 	
(0198) 	Hign_24L01_CSN;                           
      C5 9AC7      SBI	0x18,7
(0199) 	
(0200) 	return(status1);                    // return nRF24L01 status uchar
      C6 2D0A      MOV	R16,R10
      C7 940C 0199 JMP	pop_xgset303C
_SPI_Write_Buf:
  status1              --> R10
  uchar_ctr            --> R12
  uchars               --> Y,+6
  pBuf                 --> R14
  reg                  --> R10
      C9 940E 0181 CALL	push_xgset00FC
      CB 0179      MOVW	R14,R18
      CC 2EA0      MOV	R10,R16
(0201) }
