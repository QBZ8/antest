(0156) /*函数：uchar SPI_Read(uchar reg)
(0157) /*功能：NRF24L01的SPI时序
(0158) /****************************************************************************************************/
(0159) char SPI_Read(char reg)
(0160) {
(0161) 	char reg_val;
(0162) 	
(0163) 	Low_24L01_CSN;                // CSN low, initialize SPI communication...
      94 98C7      CBI	0x18,7
(0164) 	SPI_RW(reg);            // Select register to read from..
      95 2D0A      MOV	R16,R10
      96 DFE3      RCALL	_SPI_RW
(0165) 	reg_val = SPI_RW(0);    // ..then read registervalue
      97 2700      CLR	R16
      98 DFE1      RCALL	_SPI_RW
      99 2EA0      MOV	R10,R16
(0166) 	Hign_24L01_CSN;                // CSN high, terminate SPI communication
      9A 9AC7      SBI	0x18,7
(0167) 	
(0168) 	return(reg_val);        // return register value
      9B 90B9      LD	R11,Y+
      9C 90A9      LD	R10,Y+
      9D 9508      RET
_SPI_RW_Reg:
  status               --> R10
  value                --> R12
  reg                  --> R10
      9E 940E 0183 CALL	push_xgset003C
      A0 2EC2      MOV	R12,R18
      A1 2EA0      MOV	R10,R16
(0169) }
(0170) /****************************************************************************************************/
(0171) /*功能：NRF24L01读写寄存器函数
(0172) /****************************************************************************************************/
(0173) char SPI_RW_Reg(char reg, char value)
(0174) {
(0175) 	char status;
(0176) 	
(0177) 	Low_24L01_CSN;                   // CSN low, init SPI transaction
      A2 98C7      CBI	0x18,7
(0178) 	status = SPI_RW(reg);      // select register
      A3 2D0A      MOV	R16,R10
      A4 DFD5      RCALL	_SPI_RW
      A5 2EA0      MOV	R10,R16
(0179) 	SPI_RW(value);             // ..and write value to it..
      A6 2D0C      MOV	R16,R12
      A7 DFD2      RCALL	_SPI_RW
(0180) 	Hign_24L01_CSN;                   // CSN high again
      A8 9AC7      SBI	0x18,7
(0181) 	
(0182) 	return(status);            // return nRF24L01 status uchar
      A9 2D0A      MOV	R16,R10
      AA 940C 0171 JMP	pop_xgset003C
_SPI_Read_Buf:
  status1              --> R10
  uchar_ctr            --> R20
  uchars               --> Y,+6
  pBuf                 --> R12
  reg                  --> R10
      AC 940E 0192 CALL	push_xgset303C
      AE 0169      MOVW	R12,R18
      AF 2EA0      MOV	R10,R16
(0183) }
