(0131) /*函数：uint SPI_RW(uint uchar)
(0132) /*功能：NRF24L01的SPI写时序
(0133) /****************************************************************************************************/
(0134) char SPI_RW(char data)
(0135) {
(0136) 	char i,temp=0;
      7C 24AA      CLR	R10
(0137)    	for(i=0;i<8;i++) // output 8-bit
      7D 2744      CLR	R20
      7E C00D      RJMP	0x008C
(0138)    	{
(0139) 	if(data & 0x80)
      7F FF07      SBRS	R16,7
      80 C002      RJMP	0x0083
(0140) 	{
(0141) 		Hign_24L01_MOSI ;         // output 'uchar', MSB to MOSI
      81 9AC2      SBI	0x18,2
(0142) 	}
      82 C001      RJMP	0x0084
(0143) 	else
(0144) 	{
(0145) 	 	Low_24L01_MOSI; 
      83 98C2      CBI	0x18,2
(0146) 	}	
(0147) 		data = (data << 1);           // shift next bit into MSB..
      84 0F00      LSL	R16
(0148) 		temp<<=1;
      85 0CAA      LSL	R10
(0149) 		Hign_24L01_SCK ;                      // Set SCK high..
      86 9AC6      SBI	0x18,6
(0150) 		if(PINB&0x10)temp++;       		  // capture current MISO bit
      87 9BB4      SBIS	0x16,4
      88 C001      RJMP	0x008A
      89 94A3      INC	R10
(0151) 		Low_24L01_SCK;            		  // ..then set SCK low again
      8A 98C6      CBI	0x18,6
      8B 9543      INC	R20
      8C 3048      CPI	R20,0x8
      8D F388      BCS	0x007F
(0152)    	}
(0153)     return(temp);           		  // return read uchar
      8E 2D0A      MOV	R16,R10
      8F 940C 018D JMP	pop_xgset300C
_SPI_Read:
  reg_val              --> R10
  reg                  --> R10
      91 92AA      ST	R10,-Y
      92 92BA      ST	R11,-Y
      93 2EA0      MOV	R10,R16
(0154) }
