(0154) /*函数：uint SPI_RW(uint uchar)
(0155) /*功能：NRF24L01的SPI写时序
(0156) /****************************************************************************************************/
(0157) char SPI_RW(char data)
(0158) {
(0159) 	char i,temp=0;
      9A 24AA      CLR	R10
(0160)    	for(i=0;i<8;i++) // output 8-bit
      9B 2744      CLR	R20
      9C C00D      RJMP	0x00AA
(0161)    	{
(0162) 	if(data & 0x80)
      9D FF07      SBRS	R16,7
      9E C002      RJMP	0x00A1
(0163) 	{
(0164) 		Hign_24L01_MOSI ;         // output 'uchar', MSB to MOSI
      9F 9AC2      SBI	0x18,2
(0165) 	}
      A0 C001      RJMP	0x00A2
(0166) 	else
(0167) 	{
(0168) 	 	Low_24L01_MOSI; 
      A1 98C2      CBI	0x18,2
(0169) 	}	
(0170) 		data = (data << 1);           // shift next bit into MSB..
      A2 0F00      LSL	R16
(0171) 		temp<<=1;
      A3 0CAA      LSL	R10
(0172) 		Hign_24L01_SCK ;                      // Set SCK high..
      A4 9AC6      SBI	0x18,6
(0173) 		if(Read_24L01_MISO )temp++;       		  // capture current MISO bit
      A5 9BB4      SBIS	0x16,4
      A6 C001      RJMP	0x00A8
      A7 94A3      INC	R10
(0174) 		Low_24L01_SCK;            		  // ..then set SCK low again
      A8 98C6      CBI	0x18,6
      A9 9543      INC	R20
      AA 3048      CPI	R20,0x8
      AB F388      BCS	0x009D
(0175)    	}
(0176)     return(temp);           		  // return read uchar
      AC 2D0A      MOV	R16,R10
      AD 940C 0202 JMP	pop_xgset300C
_SPI_Read:
  reg_val              --> R10
  reg                  --> R10
      AF 92AA      ST	R10,-Y
      B0 92BA      ST	R11,-Y
      B1 2EA0      MOV	R10,R16
(0177) }
(0178) /****************************************************************************************************
(0179) /*函数：uchar SPI_Read(uchar reg)
(0180) /*功能：NRF24L01的SPI时序
(0181) /****************************************************************************************************/
(0182) char SPI_Read(char reg)
(0183) {
(0184) 	char reg_val;
(0185) 	
(0186) 	Low_24L01_CSN;                // CSN low, initialize SPI communication...
      B2 98C7      CBI	0x18,7
(0187) 	SPI_RW(reg);            // Select register to read from..
      B3 2D0A      MOV	R16,R10
      B4 DFE3      RCALL	_SPI_RW
(0188) 	reg_val = SPI_RW(0);    // ..then read registervalue
      B5 2700      CLR	R16
      B6 DFE1      RCALL	_SPI_RW
      B7 2EA0      MOV	R10,R16
(0189) 	Hign_24L01_CSN;                // CSN high, terminate SPI communication
      B8 9AC7      SBI	0x18,7
(0190) 	
(0191) 	return(reg_val);        // return register value
      B9 90B9      LD	R11,Y+
      BA 90A9      LD	R10,Y+
      BB 9508      RET
_SPI_RW_Reg:
  status               --> R10
  value                --> R12
  reg                  --> R10
      BC 940E 01F8 CALL	push_xgset003C
      BE 2EC2      MOV	R12,R18
      BF 2EA0      MOV	R10,R16
(0192) }
(0193) /****************************************************************************************************/
(0194) /*功能：NRF24L01读写寄存器函数
(0195) /****************************************************************************************************/
(0196) char SPI_RW_Reg(char reg, char value)
(0197) {
(0198) 	char status;
(0199) 	
(0200) 	Low_24L01_CSN;                   // CSN low, init SPI transaction
      C0 98C7      CBI	0x18,7
(0201) 	status = SPI_RW(reg);      // select register
      C1 2D0A      MOV	R16,R10
      C2 DFD5      RCALL	_SPI_RW
      C3 2EA0      MOV	R10,R16
(0202) 	SPI_RW(value);             // ..and write value to it..
      C4 2D0C      MOV	R16,R12
      C5 DFD2      RCALL	_SPI_RW
(0203) 	Hign_24L01_CSN;                   // CSN high again
      C6 9AC7      SBI	0x18,7
(0204) 	
(0205) 	return(status);            // return nRF24L01 status uchar
      C7 2D0A      MOV	R16,R10
      C8 940C 01E6 JMP	pop_xgset003C
_SPI_Read_Buf:
  status               --> R10
  uchar_ctr            --> R20
  uchars               --> Y,+6
  pBuf                 --> R12
  reg                  --> R10
      CA 940E 0207 CALL	push_xgset303C
      CC 0169      MOVW	R12,R18
      CD 2EA0      MOV	R10,R16
(0206) }
