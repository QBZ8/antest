(0208) /*函数：uint SPI_Read_Buf(uchar reg, uchar *pBuf, uchar uchars)
(0209) /*功能: 用于读数据，reg：为寄存器地址，pBuf：为待读出数据地址，uchars：读出数据的个数
(0210) /****************************************************************************************************/
(0211) char SPI_Read_Buf(char reg, char *pBuf, char uchars)
(0212) {
(0213) 	int status,uchar_ctr;
(0214) 	
(0215) 	Low_24L01_CSN;                    		// Set CSN low, init SPI tranaction
      CE 98C7      CBI	0x18,7
(0216) 	status = SPI_RW(reg);       		// Select register to write to and read status uchar
      CF 2D0A      MOV	R16,R10
      D0 DFC7      RCALL	_SPI_RW
      D1 2EA0      MOV	R10,R16
      D2 24BB      CLR	R11
(0217) 	
(0218) 	for(uchar_ctr=0;uchar_ctr<uchars;uchar_ctr++)
      D3 2744      CLR	R20
      D4 2755      CLR	R21
      D5 C008      RJMP	0x00DE
(0219) 		pBuf[uchar_ctr] = SPI_RW(0);    // 
      D6 2700      CLR	R16
      D7 DFC0      RCALL	_SPI_RW
      D8 01FA      MOVW	R30,R20
      D9 0DEC      ADD	R30,R12
      DA 1DFD      ADC	R31,R13
      DB 8300      STD	Z+0,R16
      DC 5F4F      SUBI	R20,0xFF
      DD 4F5F      SBCI	R21,0xFF
      DE 802E      LDD	R2,Y+6
      DF 2433      CLR	R3
      E0 1542      CP	R20,R2
      E1 0553      CPC	R21,R3
      E2 F39C      BLT	0x00D6
(0220) 	
(0221) 	Hign_24L01_CSN;                           
      E3 9AC7      SBI	0x18,7
(0222) 	
(0223) 	return(status);                    // return nRF24L01 status uchar
      E4 2D0A      MOV	R16,R10
      E5 940C 020E JMP	pop_xgset303C
_SPI_Write_Buf:
  status               --> R10
  uchar_ctr            --> R12
  uchars               --> Y,+6
  pBuf                 --> R14
  reg                  --> R10
      E7 940E 01F6 CALL	push_xgset00FC
      E9 0179      MOVW	R14,R18
      EA 2EA0      MOV	R10,R16
(0224) }
(0225) /*********************************************************************************************************
(0226) /*函数：uint SPI_Write_Buf(uchar reg, uchar *pBuf, uchar uchars)
(0227) /*功能: 用于写数据：为寄存器地址，pBuf：为待写入数据地址，uchars：写入数据的个数
(0228) /*********************************************************************************************************/
(0229) char SPI_Write_Buf(char reg, char *pBuf, char uchars)
(0230) {
(0231) 	char status,uchar_ctr;
(0232) 	
(0233) 	Low_24L01_CSN;             //SPI使能       
      EB 98C7      CBI	0x18,7
(0234) 	status = SPI_RW(reg);   
      EC 2D0A      MOV	R16,R10
      ED DFAA      RCALL	_SPI_RW
      EE 2EA0      MOV	R10,R16
(0235) 	for(uchar_ctr=0; uchar_ctr<uchars; uchar_ctr++) //
      EF 24CC      CLR	R12
      F0 C005      RJMP	0x00F6
(0236) 	SPI_RW(*pBuf++);
      F1 01F7      MOVW	R30,R14
      F2 9101      LD	R16,Z+
      F3 017F      MOVW	R14,R30
      F4 DFA3      RCALL	_SPI_RW
      F5 94C3      INC	R12
      F6 800E      LDD	R0,Y+6
      F7 14C0      CP	R12,R0
      F8 F3C0      BCS	0x00F1
(0237) 	Hign_24L01_CSN;           //关闭SPI
      F9 9AC7      SBI	0x18,7
(0238) 	return(status);    		  // 
      FA 2D0A      MOV	R16,R10
      FB 940C 01EB JMP	pop_xgset00FC
(0239) }
