(0241) /*函数：void SetRX_Mode(void)
(0242) /*功能：数据接收配置 
(0243) /****************************************************************************************************/
(0244) void SetRX_Mode(void)
(0245) {
(0246) 	Low_24L01_CE;
_SetRX_Mode:
      FD 98C5      CBI	0x18,5
(0247) 	SPI_RW_Reg(WRITE_REG + CONFIG, 0x0f);   		// IRQ收发完成中断响应，16位CRC	，主接收
      FE E02F      LDI	R18,0xF
      FF E200      LDI	R16,0x20
     100 DFBB      RCALL	_SPI_RW_Reg
(0248) 	Hign_24L01_CE; 
     101 9AC5      SBI	0x18,5
(0249) 	inerDelay_us(130);
     102 E802      LDI	R16,0x82
     103 DF76      RCALL	_inerDelay_us
     104 9508      RET
_nRF24L01_RxPacket:
  revale               --> R20
  rx_buf               --> R10
     105 940E 01FD CALL	push_xgset300C
     107 0158      MOVW	R10,R16
     108 9721      SBIW	R28,1
(0250) }
(0251) /******************************************************************************************************/
(0252) /*函数：unsigned char nRF24L01_RxPacket(unsigned char* rx_buf)
(0253) /*功能：数据读取后放如rx_buf接收缓冲区中
(0254) /******************************************************************************************************/
(0255) char nRF24L01_RxPacket(char* rx_buf)
(0256) {
(0257)     char revale=0;
     109 2744      CLR	R20
(0258) 	sta=SPI_Read(STATUS);	// 读取状态寄存其来判断数据接收状况
     10A E007      LDI	R16,7
     10B DFA3      RCALL	_SPI_Read
     10C 9300 0096 STS	sta,R16
(0259) 	if(sta&0x40)				// 判断是否接收到数据
     10E FF06      SBRS	R16,6
     10F C007      RJMP	0x0117
(0260) 	{
(0261) 	    Low_24L01_CE; 			//SPI使能
     110 98C5      CBI	0x18,5
(0262) 		SPI_Read_Buf(RD_RX_PLOAD,rx_buf,TX_PLOAD_WIDTH);// read receive payload from RX_FIFO buffer
     111 E280      LDI	R24,0x20
     112 8388      STD	Y+0,R24
     113 0195      MOVW	R18,R10
     114 E601      LDI	R16,0x61
     115 DFB4      RCALL	_SPI_Read_Buf
(0263) 		revale =1;			//读取数据完成标志
     116 E041      LDI	R20,1
(0264) 	}
(0265) 	SPI_RW_Reg(WRITE_REG+STATUS,sta);   //接收到数据后RX_DR,TX_DS,MAX_PT都置高为1，通过写1来清楚中断标志
     117 9120 0096 LDS	R18,sta
     119 E207      LDI	R16,0x27
     11A DFA1      RCALL	_SPI_RW_Reg
(0266) 	return revale;
     11B 2F04      MOV	R16,R20
     11C 9621      ADIW	R28,1
     11D 940C 0202 JMP	pop_xgset300C
_nRF24L01_TxPacket:
  tx_buf               --> R10
     11F 92AA      ST	R10,-Y
     120 92BA      ST	R11,-Y
     121 0158      MOVW	R10,R16
     122 9721      SBIW	R28,1
(0267) }
(0268) /***********************************************************************************************************
(0269) /*函数：void nRF24L01_TxPacket(char * tx_buf)
(0270) /*功能：发送 tx_buf中数据
(0271) /**********************************************************************************************************/
(0272) void nRF24L01_TxPacket(char * tx_buf)
(0273) {
(0274) 	Low_24L01_CE;			//StandBy I模式	
     123 98C5      CBI	0x18,5
(0275) 	SPI_Write_Buf(WRITE_REG + RX_ADDR_P0, TX_ADDRESS, TX_ADR_WIDTH); // 装载接收端地址
     124 E085      LDI	R24,5
     125 8388      STD	Y+0,R24
     126 E82A      LDI	R18,0x8A
     127 E030      LDI	R19,0
     128 E20A      LDI	R16,0x2A
     129 DFBD      RCALL	_SPI_Write_Buf
(0276) 	SPI_Write_Buf(WR_TX_PLOAD, tx_buf, TX_PLOAD_WIDTH); 			 // 装载数据	
     12A E280      LDI	R24,0x20
     12B 8388      STD	Y+0,R24
     12C 0195      MOVW	R18,R10
     12D EA00      LDI	R16,0xA0
     12E DFB8      RCALL	_SPI_Write_Buf
(0277) //	SPI_RW_Reg(WRITE_REG + CONFIG, 0x0e);   		 // IRQ收发完成中断响应，16位CRC，主发送
(0278) 	Hign_24L01_CE;		 //置高CE，激发数据发送
     12F 9AC5      SBI	0x18,5
(0279) 	inerDelay_us(10);
     130 E00A      LDI	R16,0xA
     131 DF48      RCALL	_inerDelay_us
     132 9621      ADIW	R28,1
     133 90B9      LD	R11,Y+
     134 90A9      LD	R10,Y+
     135 9508      RET
_init_NRF24L01:
     136 9721      SBIW	R28,1
(0280) }
(0281) //****************************************************************************************
(0282) /*NRF24L01初始化
(0283) //***************************************************************************************/
(0284) void init_NRF24L01(void)
(0285) {
(0286)     inerDelay_us(100);
     137 E604      LDI	R16,0x64
     138 DF41      RCALL	_inerDelay_us
(0287)  	Low_24L01_CE;    // chip enable
     139 98C5      CBI	0x18,5
(0288)  	Hign_24L01_CSN;   // Spi disable 
     13A 9AC7      SBI	0x18,7
(0289)  	Low_24L01_SCK;   // Spi clock line init high
     13B 98C6      CBI	0x18,6
(0290) 	SPI_Write_Buf(WRITE_REG + TX_ADDR, TX_ADDRESS, TX_ADR_WIDTH);    // 写本地地址	
     13C E085      LDI	R24,5
     13D 8388      STD	Y+0,R24
     13E E82A      LDI	R18,0x8A
     13F E030      LDI	R19,0
     140 E300      LDI	R16,0x30
     141 DFA5      RCALL	_SPI_Write_Buf
(0291) 	SPI_Write_Buf(WRITE_REG + RX_ADDR_P0, RX_ADDRESS, RX_ADR_WIDTH); // 写接收端地址
     142 E085      LDI	R24,5
     143 8388      STD	Y+0,R24
     144 E82F      LDI	R18,0x8F
     145 E030      LDI	R19,0
     146 E20A      LDI	R16,0x2A
     147 DF9F      RCALL	_SPI_Write_Buf
(0292) 	SPI_RW_Reg(WRITE_REG + EN_AA, 0x01);      //  频道0自动	ACK应答允许	
     148 E021      LDI	R18,1
     149 E201      LDI	R16,0x21
     14A DF71      RCALL	_SPI_RW_Reg
(0293) 	SPI_RW_Reg(WRITE_REG + EN_RXADDR, 0x01);  //  允许接收地址只有频道0，如果需要多频道可以参考Page21  
     14B E021      LDI	R18,1
     14C E202      LDI	R16,0x22
     14D DF6E      RCALL	_SPI_RW_Reg
(0294) 	SPI_RW_Reg(WRITE_REG + RF_CH, 0);        //   设置信道工作为2.4GHZ，收发必须一致
     14E 2722      CLR	R18
     14F E205      LDI	R16,0x25
     150 DF6B      RCALL	_SPI_RW_Reg
(0295) 	SPI_RW_Reg(WRITE_REG + RX_PW_P0, RX_PLOAD_WIDTH); //设置接收数据长度，本次设置为32字节
     151 E220      LDI	R18,0x20
     152 E301      LDI	R16,0x31
     153 DF68      RCALL	_SPI_RW_Reg
(0296) 	SPI_RW_Reg(WRITE_REG + RF_SETUP, 0x07);   		//设置发射速率为1MHZ，发射功率为最大值0dB	
     154 E027      LDI	R18,7
     155 E206      LDI	R16,0x26
     156 DF65      RCALL	_SPI_RW_Reg
(0297) 	SPI_RW_Reg(WRITE_REG + CONFIG, 0x0e);   		 // IRQ收发完成中断响应，16位CRC，主发送
     157 E02E      LDI	R18,0xE
     158 E200      LDI	R16,0x20
     159 DF62      RCALL	_SPI_RW_Reg
     15A 9621      ADIW	R28,1
     15B 9508      RET
(0298) 
(0299) }
