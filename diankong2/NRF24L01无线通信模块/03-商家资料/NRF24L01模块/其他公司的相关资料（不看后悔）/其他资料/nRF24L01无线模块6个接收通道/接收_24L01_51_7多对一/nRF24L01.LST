 258          void exter0() interrupt 0
 259          {
 260   1              sta = SPI_Read(STATUS);   // 读状态寄存器
 261   1         if(RX_DR)                              // 判断是否接受到数据
 262   1              {
 263   2                      status=sta;
 264   2                      status&=0x0e;
 265   2                      status>>=1;
