 286   1              SPI_RW_Reg(WRITE_REG + EN_AA, 0x3f);       // 使能所有接收通道自动应答
 287   1              SPI_RW_Reg(WRITE_REG + EN_RXADDR, 0x3f);   // 使能所有接收通道
