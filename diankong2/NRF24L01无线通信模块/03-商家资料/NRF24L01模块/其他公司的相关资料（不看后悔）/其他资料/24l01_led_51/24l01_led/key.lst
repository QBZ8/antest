  30          void key_scan(void)
  31          {
  32   1          U8 i = 0;
  33   1          U8 key_buf = 0;
  34   1          U8 temp_buf = 0;
  35   1          
  36   1          KEY_PIN_INPUT();
  37   1          delay_2us(1);
  38   1          key_buf = GET_KEY_VALUE();
  39   1          for(i=0; i<3; i++)
  40   1          {   
  41   2              delay_2us(500);         
  42   2              temp_buf = GET_KEY_VALUE();
  43   2              if(key_buf != temp_buf)
  44   2              {
  45   3                  return;     
  46   3              }
  47   2          }
  48   1                  
  49   1          if(key_buf != Key_Old_Buf)
  50   1          {
  51   2              if(key_buf != MASK_KEY)                                 // 新键按下
  52   2              {
  53   3                  switch(key_buf)
  54   3                  {
