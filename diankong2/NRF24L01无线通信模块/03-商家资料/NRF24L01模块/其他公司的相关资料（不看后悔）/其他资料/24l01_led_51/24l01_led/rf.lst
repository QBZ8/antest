  64          /**************************************************
  65          Function: SPI_RW();
  66          
  67          Description:
  68            Writes one byte to nRF24L01, and return the byte read
  69            from nRF24L01 during write, according to SPI protocol  */
  70          /**************************************************/
  71          unsigned char SPI_RW(unsigned char byte)
  72          {
  73   1              unsigned char  bit_ctr; 
  74   1      
  75   1              for(bit_ctr=0;bit_ctr<8;bit_ctr++)      // output 8-bit
  76   1              {
  77   2                      if(byte & 0x80) 
  78   2                              RF_MOSI = 1;
  79   2                      else 
  80   2                              RF_MOSI = 0;
  81   2                      byte = (byte << 1);                     // shift next bit into MSB..
  82   2                      RF_SCK = 1;                   // Set nRF24L01_SCK high..
  83   2                      if(RF_MISO) byte |= 1;
  84   2                      RF_SCK = 0;                     // ..then set nRF24L01_SCK low again
  85   2              }
  86   1      
  87   1          return(byte);                                       // return read byte
  88   1      }
  89          /**************************************************
  90          Function: SPI_RW_Reg();
  91          
  92          Description:
  93            Writes value 'value' to register 'reg' */
  94          /**************************************************/
  95          unsigned char SPI_RW_Reg(unsigned char reg, unsigned char value)
  96          {
  97   1              unsigned char status;
  98   1      //      DI();
  99   1              RF_CSN = 0;          // nRF24L01_CSN low, init SPI transaction.
 100   1              status = SPI_RW(reg);      // select register
 101   1              SPI_RW(value);             // ..and write value to it..
 102   1              RF_CSN = 1;                   // nRF24L01_CSN high again
 103   1      //  EI();
 104   1              return(status);            // return nRF24L01 status byte
 105   1      }
 106          /**************************************************
 107          Function: SPI_Read();
 108          
 109          Description:
 110            Read one byte from nRF24L01 register, 'reg'  */
 111          /**************************************************/
 112          unsigned char SPI_Read(unsigned char reg)
 113          {
 114   1              unsigned char reg_val;
 115   1      //      DI();
 116   1              RF_CSN = 0;             // nRF24L01_CSN low, initialize SPI communication...
C51 COMPILER V7.06   RF                                                                    03/17/2009 16:24:24 PAGE 3   

 117   1              SPI_RW(reg);            // Select register to read from..
 118   1              reg_val = SPI_RW(0);    // ..then read registervalue
 119   1          RF_CSN = 1;         // nRF24L01_CSN high, terminate SPI communication
 120   1       //     EI();
 121   1              return(reg_val);        // return register value
 122   1      }
 123          /**************************************************
 124          Function: SPI_Read_Buf();
 125          
 126          Description:
 127            Reads 'bytes' #of bytes from register 'reg'
 128            Typically used to read RX payload, Rx/Tx address */
 129          /**************************************************/
 130          unsigned char SPI_Read_Buf(unsigned char reg, unsigned char *pBuf, unsigned char bytes)
 131          {
 132   1              unsigned char status,byte_ctr;
 133   1      //      DI();
 134   1              RF_CSN = 0;                   // Set nRF24L01_CSN low, init SPI tranaction
 135   1              status = SPI_RW(reg);                   // Select register to write to and read status byte
 136   1              for(byte_ctr=0;byte_ctr<bytes;byte_ctr++)
 137   1              pBuf[byte_ctr] = SPI_RW(0);    // Perform SPI_RW to read byte from nRF24L01
 138   1              RF_CSN = 1;                  // Set nRF24L01_CSN high again
 139   1      //  EI();
 140   1              return(status);                    // return nRF24L01 status byte
 141   1      }
 142          /**************************************************
 143          Function: SPI_Write_Buf();
 144          
 145          Description:
 146            Writes contents of buffer '*pBuf' to nRF24L01
 147            Typically used to write TX payload, Rx/Tx address */
 148          /**************************************************/
 149          unsigned char SPI_Write_Buf(unsigned char reg, unsigned char *pBuf, unsigned char bytes)
 150          {
 151   1              unsigned char status,byte_ctr;
 152   1      //      DI();
 153   1              RF_CSN = 0;                             // Set nRF24L01_CSN low, init SPI tranaction
 154   1              status = SPI_RW(reg);                                           // Select register to write to and read status byte
 155   1              for(byte_ctr=0; byte_ctr<bytes; byte_ctr++) // then write all byte in buffer(*pBuf)
 156   1              status = SPI_RW(*pBuf++);
 157   1              RF_CSN = 1;                           // Set nRF24L01_CSN high again
 158   1      //      EI();
 159   1              return(status);                                                 // return nRF24L01 status byte
 160   1      }
 161          /**************************************************
 162          Function: RX_Mode();
 163          
 164          Description:
 165            This function initializes one nRF24L01 device to
 166            RX Mode, set RX address, writes RX payload width,
 167            select RF channel, datarate & LNA HCURR.
 168            After init, CE is toggled high, which means that
 169            this device is now ready to receive a datapacket. */
 170          /**************************************************/
 171          void RX_Mode(void)
 172          {
 173   1              RF_CE=0;
 174   1              delay_2us(10);
 175   1      //      DI();
 176   1              SPI_Write_Buf(WRITE_REG + RX_ADDR_P0, TX_ADDRESS, TX_ADR_WIDTH); // Use the same address on the RX devi
             -ce as the TX device
 177   1      
