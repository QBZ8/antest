 178   1              //SPI_RW_Reg(WRITE_REG + EN_AA, 0x01);      // Enable Auto.Ack:Pipe0
 179   1              SPI_RW_Reg(WRITE_REG + EN_AA, 0x00);      // disable Auto.Ack:Pipe0
 180   1              SPI_RW_Reg(WRITE_REG + EN_RXADDR, 0x01);  // Enable Pipe0
 181   1              SPI_RW_Reg(WRITE_REG + SETUP_AW, 0x03);//5byte的地址
 182   1              SPI_RW_Reg(WRITE_REG + SETUP_RETR, 0x00);//禁止重发
 183   1              SPI_RW_Reg(WRITE_REG + RF_CH, 20);        // Select RF channel 2440M
 184   1              SPI_RW_Reg(WRITE_REG + RX_PW_P0, TX_PLOAD_WIDTH); // Select same RX payload width as TX Payload width
 185   1              SPI_RW_Reg(WRITE_REG + RF_SETUP, 0x07);   // TX_PWR:0dBm, Datarate:2Mbps, LNA:HCURR
 186   1              SPI_RW_Reg(WRITE_REG + CONFIG, 0x0f);     // Set PWR_UP bit, enable CRC(2 bytes) & Prim:RX. RX_DR enabl
             -ed..
 187   1      //      EI();
 188   1              RF_CE=1;
 189   1              delay_2us(500);
 190   1              IE0 = 0;
 191   1              //  This device is now ready to receive one packet of 16 bytes payload from a TX device sending to addres
             -s
 192   1        //  '3443101001', with auto acknowledgment, retransmit count of 10, RF channel 40 and datarate = 2Mbps.
 193   1      
 194   1      }
