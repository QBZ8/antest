    00C3 9822      CBI	0x04,2
(0211) 	 nRF24L01_MISO_DIR;
    00C4 9821      CBI	0x04,1
(0212) 	 nRF24L01_CE_DIR;
    00C5 9A55      SBI	0x0A,5
(0213) 	 nRF24L01_SCK_DIR;
    00C6 9A57      SBI	0x0A,7
