"esp8266_test\stm32f1xx_hal_uart.o"
"esp8266_test\stm32f1xx_hal.o"
"esp8266_test\stm32f1xx_hal_rcc.o"
"esp8266_test\stm32f1xx_hal_rcc_ex.o"
"esp8266_test\stm32f1xx_hal_gpio.o"
"esp8266_test\stm32f1xx_hal_dma.o"
